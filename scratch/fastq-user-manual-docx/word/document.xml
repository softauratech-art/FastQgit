    <w:p><w:pPr><w:pStyle w:val="Title"/></w:pPr><w:r><w:t xml:space="preserve">FastQ Manager</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Subtitle"/></w:pPr><w:r><w:t xml:space="preserve">User Manual</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">A practical guide for booking, managing queues, serving customers, reviewing calendars, administering setup, and reading reports.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">Prepared for non-technical users. Updated June 10, 2026.</w:t></w:r></w:p>
<w:p><w:r><w:br w:type="page"/></w:r></w:p>
