<w:p><w:r><w:t xml:space="preserve">10. Live Updates and Notifications</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">11. Troubleshooting and Best Practices</w:t></w:r></w:p>
<w:p><w:r><w:br w:type="page"/></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">1. What FastQ Does</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">FastQ Manager helps teams manage appointments and walk-in customers in service queues. It gives customers a way to book or join a queue, gives providers a daily working list, and gives admins tools to manage queue setup and reporting.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">The app is designed around a simple operational flow: a customer is scheduled or added as a walk-in, the provider checks the customer in, starts service, completes service, or transfers/cancels when needed.</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"><wp:extent cx="7200000" cy="4200000"/><wp:docPr id="1" name="app-map.png"/><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="app-map.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId1" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="7200000" cy="4200000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">2. Roles and Access</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">Your visible screens and available buttons depend on your assigned role and queue permissions.</w:t></w:r></w:p>
<w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="0" w:type="auto"/><w:tblBorders><w:top w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:left w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:bottom w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:right w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/></w:tblBorders></w:tblPr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Role</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>What the user can normally do</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Customer</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Book an appointment and check status.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Host</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Check in customers and help manage arrivals.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Provider</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Work appointments and walk-ins, start/end service, transfer, and add notes.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Queue Admin</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Manage queues and users for assigned queues. May also work queue actions.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Reporter</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>View reporting dashboards and export information.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Super Admin</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Access administrative setup across the application.</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">3. Navigation and Home Screen</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">After signing in, use the left navigation and available cards to open the parts of FastQ that match your role.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• New Appointment opens the customer booking experience.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Provider Today shows the active list of appointments and walk-ins.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Calendar shows appointments and walk-ins by date.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Admin opens queue, user, and holiday setup.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Reporting opens performance and queue reports.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• My Profile shows your profile and queue access.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">4. Customer Booking and Status</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">Customers or staff can create appointments through the booking screen. The booking form asks for queue, service, contact type, reference information, customer contact details, date, and time.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Booking an appointment</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Choose the correct queue.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Choose the service needed.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Select contact type, such as in-person or online meeting.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Enter reference information, name, email, phone, and language preference.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Choose an available date and time. Only open-slot dates should be selectable.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Submit the appointment.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Status tracking</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">After booking, the customer can follow the status. Providers changing status should update the customer view automatically through live updates.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">5. Provider Today List View</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">Provider Today is the main daily work screen. It separates walk-ins and appointments, shows key customer information, and provides row actions.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Common columns</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Start date/time</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Queue</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Type of service</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Customer name</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Phone</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Reference</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Language preference</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Status</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Contact method</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Join Meeting / Expand</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Common actions</w:t></w:r></w:p>
<w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="0" w:type="auto"/><w:tblBorders><w:top w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:left w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:bottom w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:right w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/></w:tblBorders></w:tblPr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Button</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Use it when</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Check-In</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>The customer has arrived or is ready.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Start</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Service is beginning.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>End</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Service is complete.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Transfer</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>The customer needs another queue/service or follow-up.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Info</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>You need meeting links, customer details, or notes.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Cancel</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>The appointment or walk-in should be cancelled.</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
<w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"><wp:extent cx="7200000" cy="4200000"/><wp:docPr id="2" name="lifecycle.png"/><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="lifecycle.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId2" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="7200000" cy="4200000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Button availability</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">Some buttons may be greyed out. This is normal. Buttons are enabled or disabled based on status, date, queue permission, and whether another user has locked the row by starting service.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">6. Provider Calendar View</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">The Calendar view helps users see appointment and walk-in activity by date. It is useful for planning workload, reviewing upcoming appointments, and opening row details from a date-based layout.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Use filters to view appointments, walk-ins, or both.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Use queue filtering to focus on a specific queue.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Open row details to use the same service actions available in the Today list.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Use Add New Appointment or Add Customer to Queue when permitted.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">7. Meeting Details and Notes</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">The Info button opens details for a row. For online meetings, the panel can show guest and host meeting URLs. Staff can review previous notes and add service notes.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Use clear notes that summarize what happened.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Do not place sensitive information in notes unless the organization allows it.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Save notes before closing the modal.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">8. Admin Setup</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">Admin screens are used by authorized users to manage operating setup.</w:t></w:r></w:p>
<w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="0" w:type="auto"/><w:tblBorders><w:top w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:left w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:bottom w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:right w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/></w:tblBorders></w:tblPr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Admin area</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Purpose</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Queues</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Maintain queue/service setup, schedules, and available service details.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Users</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Maintain user access and queue permissions.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Holidays</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Block or manage dates when service availability is different.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Dashboard</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Review administrative status and navigate to setup areas.</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">9. Reporting</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">Reporting provides a management view of queue performance and appointment outcomes.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Filter reports by entity, queue, period, or custom date range.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Review booked, scheduled, completed, cancelled, waiting, in-service, and closed counts.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Use export when a spreadsheet or external review is needed.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">10. Live Updates and Notifications</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">FastQ updates provider screens automatically so users do not need to manually refresh the browser during normal work.</w:t></w:r></w:p>
<w:p><w:pPr><w:jc w:val="center"/></w:pPr><w:r><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing"><wp:extent cx="7200000" cy="4200000"/><wp:docPr id="3" name="live-refresh.png"/><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="live-refresh.png"/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId3" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="7200000" cy="4200000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">How automatic refresh works</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Provider Today checks for external changes every 30 seconds.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• If appointments are visible, it fetches a current server-rendered snapshot and updates changed rows.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• If only walk-ins are visible, it reloads the walk-in partial area.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• New or changed rows create notifications.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• The visible page updates row-by-row; users do not see a full page reload.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Why buttons still work after refresh</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">FastQ uses delegated click handling. Instead of attaching a click handler to every button, one shared listener watches for clicks at the document level. When rows are refreshed, the document listener remains in place, so new buttons continue to work.</w:t></w:r></w:p>
<w:p><w:pPr><w:spacing w:before="80" w:after="80"/><w:shd w:fill="F8FAFC"/></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Cascadia Mono" w:hAnsi="Cascadia Mono"/><w:sz w:val="19"/><w:color w:val="334155"/></w:rPr><w:t xml:space="preserve">document.addEventListener(&quot;click&quot;, function (event) { var button = event.target.closest(&quot;[data-provider-action]&quot;); if (!button) return; });</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">11. Troubleshooting and Best Practices</w:t></w:r></w:p>
<w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="0" w:type="auto"/><w:tblBorders><w:top w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:left w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:bottom w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:right w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/></w:tblBorders></w:tblPr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Issue</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>What to try</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>A button is greyed out</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Check the row status, date, and your queue permission. Another user may have started service.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>A new row does not appear immediately</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Wait up to 30 seconds. If it still does not appear, refresh the browser and confirm filters/date range.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>No open appointment dates show</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>The queue may have no schedule or no open slots for the selected month.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Meeting link is missing</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Confirm contact type is Online Meeting and meeting information was generated/saved.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Report numbers look unexpected</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Check selected entity, queue, period, and date range.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Page looks stale</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Use Ctrl+F5 to force browser reload if a recent deployment changed scripts or styles.</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
<w:p><w:pPr><w:pStyle w:val="Heading2"/></w:pPr><w:r><w:t xml:space="preserve">Best practices</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Keep Provider Today open while serving customers.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Use Check-In before Start when the customer arrives.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Use End when service is completed so reports stay accurate.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Use Transfer instead of Cancel when the customer still needs another service.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Watch notifications for updates made by other apps or users.</w:t></w:r></w:p>
<w:p><w:r><w:t xml:space="preserve">• Use filters carefully; a hidden row may still exist outside the current filter.</w:t></w:r></w:p>
<w:p><w:pPr><w:pStyle w:val="Heading1"/></w:pPr><w:r><w:t xml:space="preserve">Glossary</w:t></w:r></w:p>
<w:tbl><w:tblPr><w:tblStyle w:val="TableGrid"/><w:tblW w:w="0" w:type="auto"/><w:tblBorders><w:top w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:left w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:bottom w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:right w:val="single" w:sz="6" w:space="0" w:color="CBD5E1"/><w:insideH w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/><w:insideV w:val="single" w:sz="4" w:space="0" w:color="E2E8F0"/></w:tblBorders></w:tblPr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Term</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:shd w:fill="E0F2FE"/></w:tcPr><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>Meaning</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Appointment</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>A scheduled service visit with date and time.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Walk-in</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>A customer added to a queue without a scheduled appointment time.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Queue</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>A service line or department where customers wait.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Service</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>The specific work requested within a queue.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Provider</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>A staff member who performs service.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Host</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>A staff member who helps check in or manage arriving customers.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Transfer</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Moving a customer to another queue/service or creating a follow-up item.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Locked row</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>A row currently in service by another user.</w:t></w:r></w:p></w:tc></w:tr><w:tr><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>Notification</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/></w:tcPr><w:p><w:r><w:rPr></w:rPr><w:t>An alert that a row was added or changed.</w:t></w:r></w:p></w:tc></w:tr></w:tbl>
