@using System.Globalization
@using System.Linq
@using FastQ.Web.Helpers
@using Newtonsoft.Json
@model FastQ.Web.Models.CalendarViewModel

@{
    ViewBag.Title = "Calendar";
    var requestedEntry = ((Request["entry"] as string) ?? "both").Trim().ToLowerInvariant();
    var requestedQueue = ((Request["queue"] as string) ?? "all").Trim().ToLowerInvariant();
    var requestedStatus = ((Request["status"] as string) ?? "active").Trim().ToLowerInvariant();
    var requestedScope = ((Request["scope"] as string) ?? "monthly").Trim().ToLowerInvariant();
    var currentScope = requestedScope == "weekly" || requestedScope == "daily" ? requestedScope : "monthly";
    var previousMonth = Model.DisplayMonth.AddMonths(-1);
    var nextMonth = Model.DisplayMonth.AddMonths(1);
    var modalDate = Model.SelectedDate == default(DateTime) ? DateTime.Today : Model.SelectedDate;
    var monthNames = System.Globalization.DateTimeFormatInfo.InvariantInfo.MonthNames.Take(12).ToList();
    var currentYear = Model.DisplayMonth.Year;
    var yearOptions = Enumerable.Range(currentYear - 2, 6).ToList();
    var serviceAccess = ViewBag.ServiceAccess as FastQ.Web.Models.ServicePageAccess ?? new FastQ.Web.Models.ServicePageAccess();
    var currentProviderId = ((ViewBag.ProviderId as string) ?? string.Empty).Trim();
    //var agendaQueueOptions = Model.MonthAppointments
    //    .Select(a => a.QueueName)
    //    .Where(q => !string.IsNullOrWhiteSpace(q))
    //    .Distinct(StringComparer.OrdinalIgnoreCase)
    //    .OrderBy(q => q, StringComparer.OrdinalIgnoreCase)
    //    .ToList();
    var agendaQueueOptions = Model.QueueOptions.ToList();
}

@section Head {
    <link href="~/Content/calendar.css" rel="stylesheet" />
}

@section PageHeader {
    <div>
        <div class="topbar-title">Calendar View</div>
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.FeedbackMessage))
{
    <div class="feedback-banner @(Model.FeedbackIsError ? "error" : "success")">@Model.FeedbackMessage</div>
}

<div class="calendar-toolbar">
    <div class="calendar-toolbar-row">
        <div class="calendar-nav">
            <button class="btn ghost" type="button" data-calendar-shift="-1">Previous</button>

            <div class="calendar-jump">
                <select id="calendarMonthSelect" aria-label="Select month">
                    @for (var monthIndex = 1; monthIndex <= 12; monthIndex++)
                    {
                        <option value="@monthIndex" @(monthIndex == Model.DisplayMonth.Month ? "selected" : null)>@monthNames[monthIndex - 1]</option>
                    }
                </select>
                <select id="calendarYearSelect" aria-label="Select year">
                    @foreach (var year in yearOptions)
                    {
                        <option value="@year" @(year == currentYear ? "selected" : null)>@year</option>
                    }
                </select>
                <button class="btn small ghost" type="button" id="calendarTodayBtn">Today</button>
            </div>
            <button class="btn ghost" type="button" data-calendar-shift="1">Next</button>
        </div>
        @if (serviceAccess.CanAddEntries)
        {
            <div style="display:flex; gap:10px; flex-wrap:wrap;">
                <button type="button" class="btn secondary" data-modal-open="addAppointmentModal">Add Appointment</button>
                <button type="button" class="btn ghost" data-modal-open="addWalkinModal">Add Walk-In</button>
            </div>
        }
    </div>
    <div class="calendar-month-filters">
        <div class="calendar-month-filters-main">
            <span class="calendar-filter-label">Filters: </span>
            <div class="agenda-filter-switch" role="group" aria-label="Month entry type filter">
                <button class="btn small ghost @(requestedEntry == "both" ? "is-active" : null)" type="button" data-agenda-filter="both" onclick="reloadByEntryFilter('both');">Both</button>
                <button class="btn small ghost @(requestedEntry.ToLower() == "a" ? "is-active" : null)" type="button" data-agenda-filter="A" onclick="reloadByEntryFilter('A');">Appointments</button>
                <button class="btn small ghost @(requestedEntry.ToLower() == "w" ? "is-active" : null)" type="button" data-agenda-filter="W" onclick="reloadByEntryFilter('W');">Walk-ins</button>
            </div>
            <div class="agenda-filter-row">
                <select id="agendaQueueFilter" aria-label="Filter month agenda by queue" onchange="reloadByQueueFilter(this.value);">
                    <option value="all">All Queues</option>
                    @foreach (var queueName in agendaQueueOptions)
                    {
                        <option value="@queueName.Value" @(requestedQueue.Equals(queueName.Value) ? "selected" : null)>@queueName.Text</option>
                    }
                </select>
                <select id="agendaStatusFilter" aria-label="Filter month agenda by status" onchange="reloadByStatusFilter(this.value);">
                    <option value="active" @(requestedStatus == "active" ? "selected" : null)>Active</option>
                    <option value="all" @(requestedStatus == "all" ? "selected" : null)>All Statuses</option>
                    <option value="Scheduled" @(requestedStatus == "scheduled" ? "selected" : null)>Scheduled</option>
                    <option value="Arrived" @(requestedStatus == "arrived" ? "selected" : null)>Arrived</option>
                    <option value="InService" @(requestedStatus == "inservice" ? "selected" : null)>In Service</option>
                    <option value="Completed" @(requestedStatus == "completed" ? "selected" : null)>Done</option>
                    <option value="Cancelled" @(requestedStatus == "cancelled" ? "selected" : null)>Cancelled</option>
                    <option value="ClosedBySystem" @(requestedStatus == "closedbysystem" ? "selected" : null)>Closed by System</option>
                    <option value="TransferredOut" @(requestedStatus == "transferredout" ? "selected" : null)>Transferred Out</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="calendar-shell">
    <section class="calendar-panel">
        <div class="calendar-weekdays" id="calendarWeekdays">
            <div class="calendar-weekday" data-weekday-index="0">Sun</div>
            <div class="calendar-weekday" data-weekday-index="1">Mon</div>
            <div class="calendar-weekday" data-weekday-index="2">Tue</div>
            <div class="calendar-weekday" data-weekday-index="3">Wed</div>
            <div class="calendar-weekday" data-weekday-index="4">Thu</div>
            <div class="calendar-weekday" data-weekday-index="5">Fri</div>
            <div class="calendar-weekday" data-weekday-index="6">Sat</div>
        </div>

        <div class="calendar-grid" id="calendarGrid">
            @foreach (var day in Model.CalendarDays)
            {
                var dayClass = "calendar-day";
                if (!day.IsCurrentMonth)
                {
                    dayClass += " is-muted";
                }
                if (day.IsSelected)
                {
                    dayClass += " is-selected";
                }
                if (day.IsToday)
                {
                    dayClass += " is-today";
                }

                <div class="@dayClass" data-calendar-date="@day.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" data-weekday-index="@((int)day.Date.DayOfWeek)">
                    @if (day.IsCurrentMonth)
                    {
                        <a class="calendar-day-link" href="@Url.Action("Index", "Calendar", new { month = Model.DisplayMonth.ToString("yyyy-MM-01"), selectedDate = day.Date.ToString("yyyy-MM-dd"), scope = currentScope, queue = requestedQueue, entry = requestedEntry, status = requestedStatus })">
                            <div class="day-number">@day.Date.Day</div>
                            <div class="day-meta">
                                <span>@(day.AppointmentCount == 1 ? "1 item" : day.AppointmentCount + " items")</span>
                                @if (day.AppointmentCount > 0)
                                {
                                    <span class="day-count">@day.AppointmentCount</span>
                                }
                            </div>
                        </a>
                    }
                    else
                    {
                        <div class="day-number">@day.Date.Day</div>
                    }
                </div>
            }
        </div>
    </section>

    <aside class="agenda-panel">
        <div class="agenda-header">
            <div class="agenda-day-count">@Model.SelectedDayAppointments.Count()</div>
            <h3>@Model.SelectedDate.ToString("dddd, MMMM d", CultureInfo.InvariantCulture)</h3>
        </div>

        @if (Model.SelectedDayAppointments.Any())
        {
            <div class="agenda-list">
                @foreach (var group in Model.SelectedDayAppointments.GroupBy(a => a.ScheduledFor.Date).OrderBy(g => g.Key))
                {
                    var groupIsSelected = group.Key.Date == Model.SelectedDate.Date;
                    <div class="agenda-day-group @(groupIsSelected ? "is-selected" : "is-dimmed")" data-agenda-day="@group.Key.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">
                        @foreach (var item in group)
                        {
                            var isLocked = item.Status == FastQ.Data.Entities.AppointmentStatus.InService && !string.Equals(item.StampUser ?? string.Empty, currentProviderId, System.StringComparison.OrdinalIgnoreCase);
                            var entryKindClass = string.Equals(item.SrcType, "W", StringComparison.OrdinalIgnoreCase) ? "is-walkin" : "is-appointment";
                            var itemPhoneDisplay = Utilities.FormatPhoneForDisplay(item.Phone);
                            <div class="agenda-item @(isLocked ? "locked" : null)"
                                 data-appointment-id="@item.AppointmentId"
                                 data-queue-id="@item.QueueId"
                                 data-service-id="@item.ServiceId"
                                 data-queue="@item.QueueName"
                                 data-ref-value="@item.RefValue"
                                 data-notes="@item.Notes"
                                 data-service-notes="@item.ServiceNotes"
                                 data-email="@item.CustomerEmail"
                                 data-phone="@itemPhoneDisplay"
                                 data-date="@item.ScheduledFor.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)"
                                 data-time="@item.StartTimeText"
                                 data-status="@item.Status"
                                 data-src-type="@item.SrcType">
                                <div class="agenda-time">@item.StartTimeText</div>
                                <div class="agenda-title">@item.CustomerName</div>
                                <div class="agenda-entry-label @entryKindClass">@item.EntryKind</div>
                                <div class="agenda-detail">@item.ContactMethod | @item.StatusText | @itemPhoneDisplay</div>
                                <div class="agenda-detail" aria-expanded="false" title="@item.QueueName">@item.QueueName</div>
                                @if (string.Equals((item.ContactMethod ?? string.Empty).Trim(), "Online Meeting", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(item.MeetingUrl))
                                {
                                    <div class="agenda-detail"><a href="@Url.Action("JoinMeeting", "Provider", new { srctype = item.SrcType, srcid = item.AppointmentId })" target="_blank" rel="noopener">Join Meeting</a></div>
                                }
                                <button type="button" class="agenda-notes expandable-text" aria-expanded="false" title="@item.Notes">@item.Notes</button>
                                <div class="agenda-actions">
                                    <div class="agenda-actions-main">
                                        <button class="btn small primary" type="button" data-provider-action="true" data-action="arrive" data-appointment-id="@item.AppointmentId" data-src-type="@item.SrcType" data-queue-id="@item.QueueId">Check-In</button>
                                        <button class="btn small secondary" type="button" data-provider-action="true" data-action="begin" data-appointment-id="@item.AppointmentId" data-src-type="@item.SrcType" data-queue-id="@item.QueueId">Start</button>
                                        <button class="btn small secondary" type="button" data-provider-action="true" data-action="end" data-appointment-id="@item.AppointmentId" data-src-type="@item.SrcType" data-queue-id="@item.QueueId">End</button>
                                        <button class="btn small ghost" type="button" data-provider-action="true" data-action="transfer" data-appointment-id="@item.AppointmentId" data-src-type="@item.SrcType" data-queue-id="@item.QueueId">Transfer</button>
                                        <button class="btn small ghost meeting-link" type="button"
                                                data-appointment-id="@item.AppointmentId"
                                                data-src-type="@item.SrcType"
                                                data-date="@item.StartDateText"
                                                data-time="@item.StartTimeText"
                                                data-title="@item.ServiceType"
                                                data-customer="@item.CustomerName"
                                                data-email="@item.CustomerEmail"
                                                data-phone="@itemPhoneDisplay"
                                                data-sms-opt-in="@(item.SmsOptIn ? "Yes" : "No")"
                                                data-queue-name="@item.QueueName"
                                                data-service-name="@item.ServiceType"
                                                data-ref-value="@item.RefValue"
                                                data-language="@item.LanguagePreference"
                                                data-status-text="@item.StatusText"
                                                data-contact="@item.ContactMethod"
                                                data-stamp-user="@item.StampUser"
                                                data-meeting-url="@item.MeetingUrl"
                                                data-meeting-url-host="@item.MeetingUrlHost"
                                                data-notes="@item.Notes"
                                                data-service-notes="@item.ServiceNotes">
                                            Info
                                        </button>
                                        <button class="btn small ghost transaction-details-link" type="button"
                                                title="Transaction Details"
                                                data-appointment-id="@item.AppointmentId"
                                                data-src-type="@item.SrcType"
                                                data-service-notes="@item.ServiceNotes"
                                                data-service-start-time="@item.ServiceStartTimeText"
                                                data-service-end-time="@item.ServiceEndTimeText"
                                                data-service-stamp-user="@item.ServiceStampUser">
                                            Transaction Details
                                        </button>
                                        <button class="btn small ghost" type="button" data-provider-action="true" data-action="remove" data-appointment-id="@item.AppointmentId" data-src-type="@item.SrcType" data-queue-id="@item.QueueId">Cancel</button>
                                    </div>
                                    <div class="agenda-actions-meta">Stamp User: @(string.IsNullOrWhiteSpace(item.StampUserName) ? "-" : item.StampUserName)</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="empty-state is-hidden">No records match the selected filters.</div>
        }
        else
        {
            <div class="empty-state">No records found for the selected date(s) and filters.</div>
        }
    </aside>
</div>

@Html.Partial("~/Views/Shared/_ProviderRowActionModals.cshtml")

@Html.Partial("~/Views/Shared/_QueueEntryModals.cshtml")

@section Scripts {
    <script src="@Url.Content("~/Scripts/provider-common.js?v=20260607-1")"></script>
    <script>

        function reloadByQueueFilter(qid) {
            var url = "@Url.Action("Index", "Calendar")?";
            url += "&month=@Model.DisplayMonth.ToString("yyyy-MM-01")";
            url += "&selectedDate=@modalDate.Date.ToString("yyyy-MM-dd")";
            url += "&scope=@currentScope";
            url += "&entry=@requestedEntry";
            url += "&queue=" + qid;
            url += "&status=@requestedStatus";
            window.location.href = url;
        }

        function reloadByEntryFilter(entry) {
            var url = "@Url.Action("Index", "Calendar")?";
            url += "&month=@Model.DisplayMonth.ToString("yyyy-MM-01")";
            url += "&selectedDate=@modalDate.Date.ToString("yyyy-MM-dd")";
            url += "&scope=@currentScope";
            url += "&entry=" + entry;
            url += "&queue=@requestedQueue";
            url += "&status=@requestedStatus";
            window.location.href = url;
        }

        function reloadByStatusFilter(status) {
            var url = "@Url.Action("Index", "Calendar")?";
            url += "&month=@Model.DisplayMonth.ToString("yyyy-MM-01")";
            url += "&selectedDate=@modalDate.Date.ToString("yyyy-MM-dd")";
            url += "&scope=@currentScope";
            url += "&entry=@requestedEntry";
            url += "&queue=@requestedQueue";
            url += "&status=" + status;
            window.location.href = url;
        }

        (function () {
            var reopenOnError = @(Model.FeedbackIsError ? "true" : "false");
            var providerActionUrl = "@Url.Action("ProviderAction", "Provider")";
            var addAppointmentUrl = "@Url.Action("AddAppointment", "Provider")";
            var addWalkinUrl = "@Url.Action("AddWalkin", "Provider")";
            var transferUrl = "@Url.Action("TransferAppointment", "Provider")";
            var endServiceUrl = "@Url.Action("EndService", "Provider")";
            var saveServiceInfoUrl = "@Url.Action("SaveServiceInfo", "Provider")";
            var getTransferQueuesUrl = "@Url.Action("GetTransferQueues", "Provider")";
            var getTransferServicesUrl = "@Url.Action("GetTransferServices", "Provider")";
            var getQueueDetailsUrl = "@Url.Action("GetQueueDetails", "Provider")";
            var getQueueOpenSlotsUrl = "@Url.Action("GetQueueOpenSlots", "Provider")";
            var lookupCustomerByEmailUrl = "@Url.Action("LookupCustomerByEmail", "Provider")";
            var validatePermitUrl = "@Url.Action("ValidatePermit", "Provider")";
            var validateReferenceUrl = "@Url.Action("ValidateReference", "Provider")";
            var validateCustomerTimeUrl = "@Url.Action("ValidateCustomerTimeSelection", "Provider")";
            var serviceAccess = @Html.Raw(JsonConvert.SerializeObject(serviceAccess));
            
			var selectedCalendarDate = "@modalDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)";
            var currentCalendarScope = "@currentScope";
            var activeAgendaDate = "";
            var currentMonth = new Date(@Model.DisplayMonth.Year, @Model.DisplayMonth.Month - 1, 1);
            var selectedDay = @Model.SelectedDate.Day;
            
			var activeRouteQueueDetails = null;
            var activeEntryQueueDetails = {
                addAppt: null,
                addWalkin: null
            };
            var permitValidationState = {
                addAppt: { seq: 0, pending: false, valid: false, message: "" },
                addWalkin: { seq: 0, pending: false, valid: false, message: "" }
            };
            var timeSelectionState = {
                addAppt: { seq: 0, pending: false, valid: true, message: "" },
                routeTarget: { seq: 0, pending: false, valid: true, message: "" }
            };
            var permitValidationTimers = {};
            var customerLookupTimers = {};
            var customerLookupRequestSeq = {};
            var entryCalendarState = {
                addAppt: {
                    monthStart: null,
                    enabledDates: {},
                    loadedMonths: {},
                    requestToken: 0
                },
                routeTarget: {
                    monthStart: null,
                    enabledDates: {},
                    loadedMonths: {},
                    requestToken: 0
                }
            };

            var providerCommon = window.FastQProviderCommon;
            var toIsoDate = providerCommon.toIsoDate;
            var toTwoDigits = providerCommon.toTwoDigits;
            var isValidDateValue = providerCommon.isValidDateValue;
            var startOfMonth = providerCommon.startOfMonth;
            var addMonths = providerCommon.addMonths;
            var getEntryCalendarMonthLabel = providerCommon.getEntryCalendarMonthLabel;
            var getEntryCalendarMonthKey = providerCommon.getEntryCalendarMonthKey;
            var parseEntryDateDisplay = providerCommon.parseEntryDateDisplay;
            var setEntryDateDisplay = providerCommon.setEntryDateDisplay;
            var openEntryDatePicker = providerCommon.openEntryDatePicker;
            var closeEntryDatePicker = providerCommon.closeEntryDatePicker;
            var validateUsPhoneNumber = providerCommon.validateUsPhoneNumber;
            var postForm = providerCommon.postForm;
            var getEntryDateWindowLimits = providerCommon.getEntryDateWindowLimits;
            var appendNotes = providerCommon.appendNotes;
            var getJson = providerCommon.getJson;
            var setSelectOptions = providerCommon.setSelectOptions;
            var buildCustomerName = providerCommon.buildCustomerName;
            var setFieldDisabled = providerCommon.setFieldDisabled;
            var parseIsoDurationToMinutes = providerCommon.parseIsoDurationToMinutes;
            var normalizeScheduleWindow = providerCommon.normalizeScheduleWindow;
            var getWeekdayCode = providerCommon.getWeekdayCode;
            var parseDateOnly = providerCommon.parseDateOnly;
            var isScheduleActiveOnDate = providerCommon.isScheduleActiveOnDate;
            var getMinimumFutureMinutes = providerCommon.getMinimumFutureMinutes;
            var getEntryCalendarBounds = providerCommon.getEntryCalendarBounds;
            var setSelectValues = providerCommon.setSelectValues;
            var parseClockMinutes = providerCommon.parseClockMinutes;
            var to24Hour = providerCommon.to24Hour;
            var formatRouteDateLabel = providerCommon.formatRouteDateLabel;

            function updateMeetingLinkUi(appointmentId, srcType, rawGuestUrl, rawHostUrl, notes) {
                var normalizedSrcType = (srcType || "A").toUpperCase();
                var normalizedGuestUrl = rawGuestUrl;

                document.querySelectorAll('.meeting-link[data-appointment-id="' + appointmentId + '"][data-src-type="' + normalizedSrcType + '"]').forEach(function (link) {
                    link.setAttribute("data-meeting-url", rawGuestUrl || "");
                    link.setAttribute("data-meeting-url-host", rawHostUrl || "");
                    link.setAttribute("data-notes", notes || "");
                });

                document.querySelectorAll('.agenda-item[data-appointment-id="' + appointmentId + '"][data-src-type="' + normalizedSrcType + '"]').forEach(function (card) {
                    var linkRow = card.querySelector(".agenda-detail a");
                    var linkContainer = linkRow ? linkRow.parentElement : null;

                    if (!normalizedGuestUrl) {
                        if (linkContainer) {
                            linkContainer.remove();
                        }
                    } else if (linkRow) {
                        linkRow.setAttribute("href", normalizedGuestUrl);
                    } else {
                        var detail = document.createElement("div");
                        detail.className = "agenda-detail";
                        detail.innerHTML = '<a href="' + normalizedUrl.replace(/"/g, "&quot;") + '" target="_blank" rel="noopener">Join Meeting</a>';
                        var notesRow = card.querySelector(".agenda-notes");
                        if (notesRow) {
                            card.insertBefore(detail, notesRow);
                        } else {
                            card.appendChild(detail);
                        }
                    }

                    var notesRow = card.querySelector(".agenda-notes");
                    if (notesRow) {
                        notesRow.textContent = notes || "";
                    }
                });
            }

            function populateEntryModalOptions(prefix, details) {
                setSelectOptions(document.getElementById(prefix + "ServiceId"), details && details.services ? details.services : [], "Select service");
                setSelectOptions(document.getElementById(prefix + "ContactType"), details && details.contactOptions ? details.contactOptions : [], "Select contact type");
                setSelectOptions(document.getElementById(prefix + "RefValue"), details && details.refOptions ? details.refOptions : [], "Select reference");
                if (prefix === "addWalkin") {
                    forceWalkinContactTypeInPerson();
                }
                syncReferenceInputMeta(prefix);
            }

            function forceWalkinContactTypeInPerson() {
                var select = document.getElementById("addWalkinContactType");
                if (!select) {
                    return;
                }

                var inPersonOption = null;
                Array.prototype.forEach.call(select.options, function (option) {
                    var isInPerson = (option.value || "").toUpperCase() === "IP";
                    option.disabled = option.value ? !isInPerson : true;
                    if (isInPerson) {
                        inPersonOption = option;
                    }
                });

                if (!inPersonOption) {
                    inPersonOption = document.createElement("option");
                    inPersonOption.value = "IP";
                    inPersonOption.textContent = "In person";
                    select.appendChild(inPersonOption);
                }
                if (inPersonOption) {
                    select.value = inPersonOption.value;
                }
                select.disabled = true;
            }

            function loadEntryQueueDetails(prefix, queueCode) {
                if (!queueCode) {
                    activeEntryQueueDetails[prefix] = null;
                    populateEntryModalOptions(prefix, null);
                    populateEntryModalDateTime(prefix, null);
                    return Promise.resolve();
                }

                return getJson(getQueueDetailsUrl + "?queueId=" + encodeURIComponent(queueCode))
                    .then(function (res) {
                        var details = res && res.ok ? res.data : null;
                        activeEntryQueueDetails[prefix] = details;
                        populateEntryModalOptions(prefix, details);
                        populateEntryModalDateTime(prefix, details);
                    })
                    .catch(function (err) {
                        console.error("Add-entry queue details load failed.", {
                            prefix: prefix,
                            queueCode: queueCode,
                            url: getQueueDetailsUrl + "?queueId=" + encodeURIComponent(queueCode),
                            error: err
                        });
                        activeEntryQueueDetails[prefix] = null;
                        populateEntryModalOptions(prefix, null);
                        populateEntryModalDateTime(prefix, null);
                    });
            }

            function loadEntryQueues(prefix) {
                var queueSelect = document.getElementById(prefix + "QueueId");
                if (!queueSelect) {
                    return Promise.resolve();
                }

                return getJson(getTransferQueuesUrl)
                    .then(function (res) {
                        setSelectOptions(queueSelect, res && res.ok ? res.data : [], "Select queue");
                    })
                    .catch(function (err) {
                        console.error("Calendar add-entry queue list load failed.", {
                            prefix: prefix,
                            url: getTransferQueuesUrl,
                            error: err
                        });
                        setSelectOptions(queueSelect, [], "Select queue");
                    });
            }

            function clearAddEntryModal(prefix) {
                var fields = [
                    "QueueId", "ServiceId", "ContactType", "RefValue", "PermitNumber",
                    "StreetNumber", "StreetName", "StreetType",
                    "Email", "FirstName", "LastName", "Phone", "MeetingUrl", "LanguagePreference", "Notes"
                ];

                fields.forEach(function (suffix) {
                    var input = document.getElementById(prefix + suffix);
                    if (input) {
                        input.value = "";
                    }
                });

                activeEntryQueueDetails[prefix] = null;
                resetEntryCalendarState(prefix);
                populateEntryModalOptions(prefix, null);
                if (prefix === "addAppt") {
                    populateEntryModalDateTime(prefix, null);
                }
                setCustomerLookupState(prefix, false, null);
                resetPermitValidation(prefix);
                syncReferenceInputMeta(prefix);
            }

            function getReferenceFieldMeta(code) {
                switch ((code || "").toUpperCase()) {
                    case "A":
                        return { label: "Address", placeholder: "Enter address", validatePermit: false, useAddressFields: true };
                    case "C":
                        return { label: "Case", placeholder: "Enter case number", validatePermit: true, useAddressFields: false };
                    case "G":
                        return { label: "General", placeholder: "Enter general reference", validatePermit: false, useAddressFields: false };
                    case "P":
                        return { label: "Permit", placeholder: "Enter permit number", validatePermit: true, useAddressFields: false };
                    default:
                        return { label: "Reference Value", placeholder: "Enter reference value", validatePermit: false, useAddressFields: false };
                }
            }

            function getSelectedReferenceCode(prefix) {
                var refSelect = document.getElementById(prefix + "RefValue");
                return refSelect ? (refSelect.value || "").trim() : "";
            }

            function syncReferenceInputMeta(prefix) {
                var input = document.getElementById(prefix + "PermitNumber");
                var label = document.getElementById(prefix + "PermitNumberLabel");
                var addressRow = document.getElementById(prefix + "AddressRow");
                var referenceWrap = document.getElementById(prefix + "ReferenceValueWrap");
                if (!input) {
                    return;
                }
                var meta = getReferenceFieldMeta(getSelectedReferenceCode(prefix));
                if (label) {
                    label.textContent = meta.label;
                }
                input.placeholder = meta.placeholder;
                if (addressRow) {
                    addressRow.classList.toggle("is-hidden", !meta.useAddressFields);
                }
                if (referenceWrap) {
                    referenceWrap.classList.toggle("is-hidden", !!meta.useAddressFields);
                }
                resetPermitValidation(prefix);
            }

            function getAddressFieldIds(prefix) {
                return {
                    streetNumberId: prefix + "StreetNumber",
                    streetNameId: prefix + "StreetName",
                    streetTypeId: prefix + "StreetType",
                    statusId: prefix + "AddressStatus"
                };
            }

            function getPermitValidationIds(prefix) {
                var meta = getReferenceFieldMeta(getSelectedReferenceCode(prefix));
                return {
                    inputId: prefix + "PermitNumber",
                    statusId: prefix + (meta.useAddressFields ? "AddressStatus" : "PermitStatus")
                };
            }

            function setPermitValidationState(prefix, pending, valid, message) {
                permitValidationState[prefix] = permitValidationState[prefix] || { seq: 0, pending: false, valid: false, message: "" };
                permitValidationState[prefix].pending = !!pending;
                permitValidationState[prefix].valid = !!valid;
                permitValidationState[prefix].message = message || "";

                var ids = getPermitValidationIds(prefix);
                var status = document.getElementById(ids.statusId);
                var input = document.getElementById(ids.inputId);
                if (status) {
                    status.textContent = message || "";
                    status.style.color = pending ? "#6b7280" : (valid ? "#15803d" : "#b91c1c");
                }
                if (input) {
                    input.setAttribute("aria-invalid", pending || valid ? "false" : (message ? "true" : "false"));
                }
            }

            function resetPermitValidation(prefix) {
                permitValidationState[prefix] = permitValidationState[prefix] || { seq: 0, pending: false, valid: false, message: "" };
                permitValidationState[prefix].seq += 1;
                setPermitValidationState(prefix, false, false, "");
                if (permitValidationTimers[prefix]) {
                    clearTimeout(permitValidationTimers[prefix]);
                    permitValidationTimers[prefix] = 0;
                }
            }

            function validatePermitNumber(prefix, immediate) {
                var ids = getPermitValidationIds(prefix);
                var input = document.getElementById(ids.inputId);
                if (!input) {
                    return Promise.resolve(true);
                }

				var refCode = getSelectedReferenceCode(prefix);
                var meta = getReferenceFieldMeta(refCode);
                var referenceValue = (input.value || "").trim();
                var addressIds = getAddressFieldIds(prefix);
                var streetNumberInput = document.getElementById(addressIds.streetNumberId);
                var streetNameInput = document.getElementById(addressIds.streetNameId);
                var streetTypeInput = document.getElementById(addressIds.streetTypeId);
                var streetNumber = streetNumberInput ? (streetNumberInput.value || "").trim() : "";
                var streetName = streetNameInput ? (streetNameInput.value || "").trim() : "";
                var streetType = streetTypeInput ? (streetTypeInput.value || "").trim() : "";
                if (meta.useAddressFields) {
                    if (!streetNumber) {
                        setPermitValidationState(prefix, false, false, "Street number is required.");
                        return Promise.resolve(false);
                    }
                    if (!streetName) {
                        setPermitValidationState(prefix, false, false, "Street name is required.");
                        return Promise.resolve(false);
                    }
                } else if (!referenceValue) {
                    setPermitValidationState(prefix, false, false, meta.label + " is required.");
                    return Promise.resolve(false);
                }
                if (!meta.validatePermit && !meta.useAddressFields) {
                    setPermitValidationState(prefix, false, true, "");
                    return Promise.resolve(true);
                }

                var state = permitValidationState[prefix] || { seq: 0, pending: false, valid: false, message: "" };
                state.seq += 1;
                permitValidationState[prefix] = state;
                var requestSeq = state.seq;
                var invalidLabel = meta.label || "Reference";
                setPermitValidationState(prefix, true, false, meta.useAddressFields ? "Validating address..." : ("Validating " + invalidLabel.toLowerCase() + "..."));

                var run = function () {
                    return getJson(validateReferenceUrl
                        + "?referenceType=" + encodeURIComponent(refCode)
                        + "&enterValue=" + encodeURIComponent(referenceValue)
                        + "&streetNumber=" + encodeURIComponent(streetNumber)
                        + "&streetName=" + encodeURIComponent(streetName)
                        + "&streetType=" + encodeURIComponent(streetType))
                        .then(function (res) {
                            if (!permitValidationState[prefix] || permitValidationState[prefix].seq !== requestSeq) {
                                return false;
                            }
                            if (res && (res.ok || res.success)) {
                                setPermitValidationState(prefix, false, true, meta.useAddressFields ? "Address validated." : (invalidLabel + " validated."));
                                return true;
                            }
                            setPermitValidationState(prefix, false, false, res && (res.error || res.message) ? (res.error || res.message) : (meta.useAddressFields ? "Address is invalid." : (invalidLabel + " is invalid.")));
                            return false;
                        })
                        .catch(function () {
                            if (!permitValidationState[prefix] || permitValidationState[prefix].seq !== requestSeq) {
                                return false;
                            }
                            setPermitValidationState(prefix, false, false, meta.useAddressFields ? "Could not validate address." : ("Could not validate " + invalidLabel.toLowerCase() + "."));
                            return false;
                        });
                };

                if (immediate) {
                    return run();
                }

                return new Promise(function (resolve) {
                    if (permitValidationTimers[prefix]) {
                        clearTimeout(permitValidationTimers[prefix]);
                    }
                    permitValidationTimers[prefix] = setTimeout(function () {
                        run().then(resolve);
                    }, 350);
                });
            }

            function attachPhoneFormatting(inputId, modalId) {
                providerCommon.attachPhoneFormatting(inputId, modalId, showModalFeedback);
            }

            function getCustomerLookupFieldIds(prefix) {
                if (prefix === "addWalkin") {
                    return {
                        firstNameId: "addWalkinFirstName",
                        lastNameId: "addWalkinLastName",
                        phoneId: "addWalkinPhone",
                        emailStatusId: "addWalkinEmailStatus",
                        emailId: "addWalkinEmail"
                    };
                }

                return {
                    firstNameId: "addApptFirstName",
                    lastNameId: "addApptLastName",
                    phoneId: "addApptPhone",
                    emailStatusId: "addApptEmailStatus",
                    emailId: "addApptEmail"
                };
            }

            function setCustomerLookupMessage(prefix, found, message) {
                var ids = getCustomerLookupFieldIds(prefix);
                var status = document.getElementById(ids.emailStatusId);
                if (!status) {
                    return;
                }
                status.textContent = message || "";
                status.style.color = found ? "#15803d" : "#6b7280";
            }

            function setCustomerLookupLoading(prefix, loading) {
      			var wrap = document.getElementById(prefix + "EmailWrap");
      			var status = document.getElementById(prefix + "EmailStatus");
                if (wrap) {
                    wrap.classList.toggle("is-loading", !!loading);
                }
                if (status && loading) {
                    status.textContent = "Looking up customer...";
                    status.style.color = "#6b7280";
                }
            }

            function setCustomerLookupState(prefix, found, data) {
                setCustomerLookupLoading(prefix, false);
                var ids = getCustomerLookupFieldIds(prefix);                
                var email = document.getElementById(ids.emailId);
                var firstName = document.getElementById(ids.firstNameId);
                var lastName = document.getElementById(ids.lastNameId);
                var phone = document.getElementById(ids.phoneId);
                var wasFound = email && email.getAttribute("data-customer-found") === "1";
                if (found && data) {
                    if (firstName) firstName.value = data.firstName || "";
                    if (lastName) lastName.value = data.lastName || "";
                    if (phone) phone.value = data.phone || "";
                } else if (wasFound) {
                    if (firstName) firstName.value = "";
                    if (lastName) lastName.value = "";
                    if (phone) phone.value = "";
                }
                if (email) {
                    email.setAttribute("data-customer-found", found ? "1" : "0");
                }
                setFieldDisabled(ids.firstNameId, found);
                setFieldDisabled(ids.lastNameId, found);
                setFieldDisabled(ids.phoneId, found);
                setCustomerLookupMessage(prefix, found, found ? "Customer found." : "");
                validateCustomerTimeSelection(prefix);
            }

            function lookupCustomerByEmail(prefix) {
                var timerKey = prefix || "_default";
                if (customerLookupTimers[timerKey]) {
                    clearTimeout(customerLookupTimers[timerKey]);
                    customerLookupTimers[timerKey] = 0;
                }
                var emailInput = document.getElementById(prefix === "addWalkin" ? "addWalkinEmail" : "addApptEmail");
                if (!emailInput) {
                    return;
                }
                var email = (emailInput.value || "").trim();
                if (!email) {
                    setCustomerLookupState(prefix, false, null);
                    return;
                }

                customerLookupRequestSeq[timerKey] = (customerLookupRequestSeq[timerKey] || 0) + 1;
                var requestSeq = customerLookupRequestSeq[timerKey];
                setCustomerLookupLoading(prefix, true);
                getJson(lookupCustomerByEmailUrl + "?email=" + encodeURIComponent(email))
                    .then(function (res) {
                        if (customerLookupRequestSeq[timerKey] !== requestSeq) {
                            return;
                        }
                        if (!res || !res.ok || !res.found) {
                            setCustomerLookupState(prefix, false, null);
                            return;
                        }
                        setCustomerLookupState(prefix, true, res.data || {});
                    })
                    .catch(function () {
                        if (customerLookupRequestSeq[timerKey] !== requestSeq) {
                            return;
                        }
                        setCustomerLookupState(prefix, false, null);
                    });
            }

            function queueCustomerLookupByEmail(prefix) {
                var timerKey = prefix || "_default";
                if (customerLookupTimers[timerKey]) {
                    clearTimeout(customerLookupTimers[timerKey]);
                }
                setCustomerLookupLoading(prefix, false);
                customerLookupTimers[timerKey] = setTimeout(function () {
                    customerLookupTimers[timerKey] = 0;
                    lookupCustomerByEmail(prefix);
                }, 700);
            }

            function getEntryCalendarState(prefix) {
                if (!entryCalendarState[prefix]) {
                    entryCalendarState[prefix] = {
                        monthStart: null,
                        enabledDates: {},
                        loadedMonths: {},
                        requestToken: 0
                    };
                }
                return entryCalendarState[prefix];
            }

            function resetEntryCalendarState(prefix) {
                entryCalendarState[prefix] = {
                    monthStart: null,
                    enabledDates: {},
                    loadedMonths: {},
                    requestToken: 0
                };
            }

            function setEntryDateStatus(prefix, message, isError) {
                var status = document.getElementById(prefix + "DateStatus");
                if (!status) {
                    return;
                }
                status.textContent = message || "";
                status.style.color = isError ? "#b91c1c" : "#5b5b5b";
            }

            function setEntryDateValue(prefix, selectedDate, suppressChange) {
                var input = document.getElementById(prefix + "Date");
                if (!input) {
                    return;
                }

                input.value = selectedDate || "";
                input.setAttribute("data-current-value", selectedDate || "");
                setEntryDateDisplay(prefix, selectedDate || "");
                renderEntryCalendar(prefix);

                if (!suppressChange) {
                    closeEntryDatePicker(prefix);
                    input.dispatchEvent(new Event("change", { bubbles: true }));
                }
            }

            function handleEntryDateDisplayInput(prefix) {
                var displayInput = document.getElementById(prefix + "DateDisplay");
                if (!displayInput) {
                    return;
                }

                var parsedDate = parseEntryDateDisplay(displayInput.value || "");
                if (!parsedDate) {
                    return;
                }

                var state = getEntryCalendarState(prefix);
                state.monthStart = startOfMonth(new Date(parsedDate + "T00:00:00"));
                renderEntryCalendar(prefix);
            }

            function handleEntryDateDisplayCommit(prefix) {
                var displayInput = document.getElementById(prefix + "DateDisplay");
                var timeSelect = document.getElementById(prefix + "Time");
                var picker = document.getElementById(prefix + "DatePicker");
                if (!displayInput) {
                    return;
                }
                if (picker && document.activeElement && picker.contains(document.activeElement)) {
                    return;
                }

                var rawValue = (displayInput.value || "").trim();
                if (!rawValue) {
                    setEntryDateValue(prefix, "", true);
                    if (timeSelect) {
                        setSelectValues(timeSelect, [], "Select time");
                    }
                    setTimeSelectionState(prefix, false, false, "Date is required.");
                    setEntryDateStatus(prefix, "Date is required.", true);
                    return;
                }

                var parsedDate = parseEntryDateDisplay(rawValue);
                if (!parsedDate) {
                    setEntryDateValue(prefix, "", true);
                    if (timeSelect) {
                        setSelectValues(timeSelect, [], "Select time");
                    }
                    setTimeSelectionState(prefix, false, false, "Enter date as mm/dd/yyyy.");
                    setEntryDateStatus(prefix, "Enter date as mm/dd/yyyy.", true);
                    return;
                }

                var state = getEntryCalendarState(prefix);
                if (state.enabledDates[parsedDate] !== true) {
                    state.monthStart = startOfMonth(new Date(parsedDate + "T00:00:00"));
                    renderEntryCalendar(prefix);
                    setEntryDateValue(prefix, "", true);
                    if (timeSelect) {
                        setSelectValues(timeSelect, [], "Select time");
                    }
                    setTimeSelectionState(prefix, false, false, "Selected date is not available.");
                    setEntryDateStatus(prefix, "Selected date is not available.", true);
                    return;
                }

                setEntryDateStatus(prefix, "", false);
                setEntryDateValue(prefix, parsedDate, false);
            }

            function renderEntryCalendar(prefix) {
                var state = getEntryCalendarState(prefix);
                var calendar = document.getElementById(prefix + "DateCalendar");
                var monthLabel = document.getElementById(prefix + "DateMonthLabel");
                var prevButton = document.getElementById(prefix + "DatePrev");
                var nextButton = document.getElementById(prefix + "DateNext");
                var input = document.getElementById(prefix + "Date");
                if (!calendar || !monthLabel || !input) {
                    return;
                }

                var bounds = getEntryCalendarBounds();
                var monthStart = isValidDateValue(state.monthStart) ? state.monthStart : startOfMonth(bounds.min);
                state.monthStart = monthStart;
                monthLabel.textContent = getEntryCalendarMonthLabel(monthStart);

                if (prevButton) {
                    prevButton.disabled = monthStart <= startOfMonth(bounds.min);
                }
                if (nextButton) {
                    nextButton.disabled = monthStart >= startOfMonth(bounds.max);
                }

                calendar.innerHTML = "";
                var firstWeekday = monthStart.getDay();
                for (var blankIndex = 0; blankIndex < firstWeekday; blankIndex++) {
                    var blankCell = document.createElement("span");
                    blankCell.className = "entry-date-cell is-muted";
                    blankCell.setAttribute("aria-hidden", "true");
                    calendar.appendChild(blankCell);
                }

                var monthKey = getEntryCalendarMonthKey(monthStart);
                var monthLoaded = !!state.loadedMonths[monthKey];
                var selectedDate = input.value || "";
                var todayIso = toIsoDate(new Date());
                var daysInMonth = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0).getDate();

                for (var day = 1; day <= daysInMonth; day++) {
                    var dateValue = new Date(monthStart.getFullYear(), monthStart.getMonth(), day);
                    var isoDate = toIsoDate(dateValue);
                    var isInRange = dateValue >= bounds.min && dateValue <= bounds.max;
                    var isEnabled = isInRange && state.enabledDates[isoDate] === true;
                    var button = document.createElement("button");
                    button.type = "button";
                    button.className = "entry-date-cell";
                    button.textContent = String(day);
                    button.disabled = !isEnabled;
                    if (isoDate === selectedDate) {
                        button.classList.add("is-selected");
                    }
                    if (isoDate === todayIso) {
                        button.classList.add("is-today");
                    }
                    if (isEnabled) {
                        button.addEventListener("click", (function (value) {
                            return function () {
                                setEntryDateStatus(prefix, "", false);
                                setEntryDateValue(prefix, value, false);
                            };
                        })(isoDate));
                    }
                    calendar.appendChild(button);
                }

                if (!monthLoaded) {
                    setEntryDateStatus(prefix, "Loading open-slot dates...", false);
                }
            }

            function monthHasSelectableSlots(prefix, monthStart) {
                var state = getEntryCalendarState(prefix);
                var monthEnd = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0);
                for (var day = 1; day <= monthEnd.getDate(); day++) {
                    var isoDate = toIsoDate(new Date(monthStart.getFullYear(), monthStart.getMonth(), day));
                    if (state.enabledDates[isoDate] === true) {
                        return true;
                    }
                }
                return false;
            }

            function getFirstEnabledDateInMonth(prefix, monthStart) {
                var state = getEntryCalendarState(prefix);
                var monthEnd = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0);
                for (var day = 1; day <= monthEnd.getDate(); day++) {
                    var isoDate = toIsoDate(new Date(monthStart.getFullYear(), monthStart.getMonth(), day));
                    if (state.enabledDates[isoDate] === true) {
                        return isoDate;
                    }
                }
                return "";
            }

            function hasSelectableSlotForDate(dateIso, slots) {
                var minimumFutureMinutes = getMinimumFutureMinutes(new Date(dateIso + "T00:00:00"));
                return (slots || []).some(function (slot) {
                    var slotValue = slot.slotBegin || "";
                    var totalMinutes = parseClockMinutes(slotValue);
                    return totalMinutes !== null && (minimumFutureMinutes === null || totalMinutes >= minimumFutureMinutes);
                });
            }

            function loadEntryCalendarMonth(prefix, monthStart, preferredDateValue) {
                var queueSelect = document.getElementById(prefix + "QueueId");
                var queueId = queueSelect ? (queueSelect.value || "") : "";
                var input = document.getElementById(prefix + "Date");
                var state = getEntryCalendarState(prefix);
                if (!queueId) {
                    resetEntryCalendarState(prefix);
                    if (input) {
                        input.value = "";
                        input.setAttribute("data-current-value", "");
                    }
                    renderEntryCalendar(prefix);
                    return Promise.resolve();
                }

                state.monthStart = startOfMonth(monthStart);
                renderEntryCalendar(prefix);

                var requestToken = ++state.requestToken;
                var bounds = getEntryCalendarBounds();
                var lastDay = new Date(state.monthStart.getFullYear(), state.monthStart.getMonth() + 1, 0);
                var requests = [];

                for (var day = 1; day <= lastDay.getDate(); day++) {
                    var dateValue = new Date(state.monthStart.getFullYear(), state.monthStart.getMonth(), day);
                    if (dateValue < bounds.min || dateValue > bounds.max) {
                        continue;
                    }

                    var isoDate = toIsoDate(dateValue);
                    requests.push((function (requestedDate) {
                        return getJson(getQueueOpenSlotsUrl + "?queueId=" + encodeURIComponent(queueId) + "&theDate=" + encodeURIComponent(requestedDate))
                            .then(function (res) {
                                return {
                                    date: requestedDate,
                                    enabled: !!(res && res.ok && hasSelectableSlotForDate(requestedDate, res.data || []))
                                };
                            })
                            .catch(function () {
                                return { date: requestedDate, enabled: false };
                            });
                    })(isoDate));
                }

                return Promise.all(requests).then(function (results) {
                    if (state.requestToken !== requestToken) {
                        return;
                    }

                    results.forEach(function (item) {
                        state.enabledDates[item.date] = item.enabled;
                    });
                    state.loadedMonths[getEntryCalendarMonthKey(state.monthStart)] = true;
                    renderEntryCalendar(prefix);

                    var activeInput = document.getElementById(prefix + "Date");
                    var selectedDate = activeInput ? (activeInput.value || "") : "";
                    var resolvedPreferredDate = preferredDateValue || selectedDate || "";
                    if (resolvedPreferredDate && state.enabledDates[resolvedPreferredDate] === true) {
                        setEntryDateStatus(prefix, "", false);
                        setEntryDateValue(prefix, resolvedPreferredDate, true);
                    } else if (!selectedDate || state.enabledDates[selectedDate] !== true) {
                        var firstEnabledDate = getFirstEnabledDateInMonth(prefix, state.monthStart);
                        if (firstEnabledDate) {
                            setEntryDateStatus(prefix, "", false);
                            setEntryDateValue(prefix, firstEnabledDate, false);
                            return;
                        }
                    }

                    if (!monthHasSelectableSlots(prefix, state.monthStart)) {
                        setEntryDateValue(prefix, "", true);
                        setSelectValues(document.getElementById(prefix + "Time"), [], "Select time");
                        setTimeSelectionState(prefix, false, false, "No open slots are available for this month.");
                        setEntryDateStatus(prefix, "No open-slot dates are available in this month.", true);
                    } else {
                        setEntryDateStatus(prefix, "Only dates with open slots are selectable.", false);
                    }
                });
            }

            function getScheduleTimeOptions(details, selectedDateValue) {
                if (!selectedDateValue) {
                    return [];
                }

                var dateValue = new Date(selectedDateValue + "T00:00:00");
                var schedules = details && details.schedules ? details.schedules : [];
                var options = [];
                var seen = {};
                var minimumFutureMinutes = getMinimumFutureMinutes(dateValue);

                schedules.forEach(function (schedule) {
                    if (!isScheduleActiveOnDate(schedule, dateValue)) {
                        return;
                    }
                    var openMinutes = parseIsoDurationToMinutes(schedule.openTime);
                    var closeMinutes = parseIsoDurationToMinutes(schedule.closeTime);
                    var intervalMinutes = parseIsoDurationToMinutes(schedule.intervalTime) || 30;
                    var window = normalizeScheduleWindow(openMinutes, closeMinutes);
                    if (!window) {
                        return;
                    }

                    for (var minutes = window.open; minutes < window.close; minutes += intervalMinutes) {
                        if (minimumFutureMinutes !== null && minutes < minimumFutureMinutes) {
                            continue;
                        }
                        var hh = toTwoDigits(Math.floor(minutes / 60) % 24);
                        var mm = toTwoDigits(minutes % 60);
                        var value = hh + ":" + mm;
                        if (seen[value]) {
                            continue;
                        }
                        seen[value] = true;
                        options.push({
                            value: value,
                            label: value
                        });
                    }
                });

                options.sort(function (a, b) { return a.value.localeCompare(b.value); });
                return options;
            }

            function populateEntryModalDateTime(prefix, details) {
                var dateSelect = document.getElementById(prefix + "Date");
                var timeSelect = document.getElementById(prefix + "Time");
                if (!dateSelect || !timeSelect) {
                    return Promise.resolve();
                }
                if (prefix !== "addAppt") {
                    return Promise.resolve();
                }

                var preferredDateValue = providerCommon.getPreferredEntryDateValue(dateSelect, selectedCalendarDate);
                var state = getEntryCalendarState(prefix);
                if (!isValidDateValue(state.monthStart)) {
                    var initialDate = preferredDateValue ? new Date(preferredDateValue + "T00:00:00") : new Date();
                    state.monthStart = startOfMonth(initialDate);
                }

                if (!details) {
                    setEntryDateValue(prefix, "", true);
                    setSelectValues(timeSelect, [], "Select time");
                    setEntryDateStatus(prefix, "Select queue to load open-slot dates.", false);
                    renderEntryCalendar(prefix);
                    return Promise.resolve();
                }

                return loadEntryCalendarMonth(prefix, state.monthStart, preferredDateValue).then(function () {
                    return refreshEntryModalTimeOptions(prefix);
                });
            }

            function refreshEntryModalTimeOptions(prefix) {
                var queueSelect = document.getElementById(prefix + "QueueId");
                var dateSelect = document.getElementById(prefix + "Date");
                var timeSelect = document.getElementById(prefix + "Time");
                if (!dateSelect || !timeSelect) {
                    return Promise.resolve();
                }
                var queueId = queueSelect ? (queueSelect.value || "") : "";
                var selectedDate = dateSelect.value || "";
                dateSelect.setAttribute("data-current-value", selectedDate);
                if (!queueId || !selectedDate) {
                    setSelectValues(timeSelect, [], "Select time");
                    return Promise.resolve();
                }
                if (prefix === "addAppt" || prefix === "routeTarget") {
                    var state = getEntryCalendarState(prefix);
                    if (state.enabledDates[selectedDate] !== true) {
                        setSelectValues(timeSelect, [], "Select time");
                        setTimeSelectionState(prefix, false, false, "Selected date is not available.");
                        showModalFeedback(prefix === "routeTarget" ? "serviceRouteModal" : "addAppointmentModal", "Selected date is not available.", true);
                        return Promise.resolve();
                    }
                }
                return populateEntryModalTimeOptions(prefix, activeEntryQueueDetails[prefix], selectedDate);
            }

            function populateEntryModalTimeOptions(prefix, details, selectedDateValue) {
                var timeSelect = document.getElementById(prefix + "Time");
                if (!timeSelect) {
                    return Promise.resolve();
                }
                var queueSelect = document.getElementById(prefix + "QueueId");
                var queueId = queueSelect ? (queueSelect.value || "") : "";
                if (!queueId || !selectedDateValue) {
                    setSelectValues(timeSelect, [], "Select time");
                    return Promise.resolve();
                }

                return getJson(getQueueOpenSlotsUrl + "?queueId=" + encodeURIComponent(queueId) + "&theDate=" + encodeURIComponent(selectedDateValue))
                    .then(function (res) {
                        var selectedDateValueObj = new Date(selectedDateValue + "T00:00:00");
                        var minimumFutureMinutes = getMinimumFutureMinutes(selectedDateValueObj);
                        var timeOptions = res && res.ok
                            ? (res.data || []).map(function (slot) {
                                var slotValue = slot.slotBegin || "";
                                var slotEndTime = slot.slotEnd || "";
                                var totalMinutes = parseClockMinutes(slotValue);
                                var isPast = minimumFutureMinutes !== null && totalMinutes !== null && totalMinutes < minimumFutureMinutes;
                                return isPast ? null : { value: slotValue, label: slotValue, endtime: slotEndTime };
                            }).filter(function (slot) {
                                return !!slot;
                            }).sort(function (a, b) {
                                return (parseClockMinutes(a.value) || 0) - (parseClockMinutes(b.value) || 0);
                            })
                            : [];
                        setSelectValues(timeSelect, timeOptions, "Select time");
                        if (timeOptions.length > 0) {
                            timeSelect.value = timeOptions[0].value;
                        }
                        if (prefix === "routeTarget") {
                            clearModalFeedback("serviceRouteModal");
                        }
                        return validateCustomerTimeSelection(prefix);
                    })
                    .catch(function (err) {
                        console.error("Add-entry time slot load failed.", {
                            prefix: prefix,
                            queueId: queueId,
                            selectedDate: selectedDateValue,
                            url: getQueueOpenSlotsUrl + "?queueId=" + encodeURIComponent(queueId) + "&theDate=" + encodeURIComponent(selectedDateValue),
                            error: err
                        });
                        setSelectValues(timeSelect, [], "Select time");
                        setTimeSelectionState(prefix, false, false, "Could not load available time slots.");
                        showModalFeedback(prefix === "routeTarget" ? "serviceRouteModal" : "addAppointmentModal", "Could not load available time slots.", true);
                    });
            }

            function setTimeSelectionState(prefix, pending, valid, message) {
                timeSelectionState[prefix] = timeSelectionState[prefix] || { seq: 0, pending: false, valid: true, message: "" };
                timeSelectionState[prefix].pending = !!pending;
                timeSelectionState[prefix].valid = !!valid;
                timeSelectionState[prefix].message = message || "";
            }

            function validateCustomerTimeSelection(prefix) {
                if (prefix !== "addAppt") {
                    return Promise.resolve(true);
                }
                var email = document.getElementById(prefix + "Email");
                var phone = document.getElementById(prefix + "Phone");
                var date = document.getElementById(prefix + "Date");
                var time = document.getElementById(prefix + "Time");
                var emailValue = email ? (email.value || "").trim() : "";
                var phoneValue = phone ? (phone.value || "").trim() : "";
                var dateValue = date ? (date.value || "").trim() : "";
                var timeValue = time ? (time.value || "").trim() : "";
                if (!dateValue || !timeValue || (!emailValue && !phoneValue)) {
                    setTimeSelectionState(prefix, false, true, "");
                    clearModalFeedback("addAppointmentModal");
                    return Promise.resolve(true);
                }

                timeSelectionState[prefix] = timeSelectionState[prefix] || { seq: 0, pending: false, valid: true, message: "" };
                timeSelectionState[prefix].seq += 1;
                var requestSeq = timeSelectionState[prefix].seq;
                setTimeSelectionState(prefix, true, false, "Checking customer availability...");
                return getJson(validateCustomerTimeUrl
                    + "?email=" + encodeURIComponent(emailValue)
                    + "&phone=" + encodeURIComponent(phoneValue)
                    + "&appointmentDate=" + encodeURIComponent(dateValue)
                    + "&startTime=" + encodeURIComponent(timeValue))
                    .then(function (res) {
                        if (!timeSelectionState[prefix] || timeSelectionState[prefix].seq !== requestSeq) {
                            return false;
                        }
                        if (res && res.ok) {
                            setTimeSelectionState(prefix, false, true, "");
                            clearModalFeedback("addAppointmentModal");
                            return true;
                        }
                        var message = res && res.error ? res.error : "Customer already has an appointment at this time.";
                        setTimeSelectionState(prefix, false, false, message);
                        showModalFeedback("addAppointmentModal", message, true);
                        return false;
                    })
                    .catch(function (err) {
                        console.error("Add-entry customer time validation failed.", {
                            prefix: prefix,
                            dateValue: dateValue,
                            timeValue: timeValue,
                            error: err
                        });
                        if (!timeSelectionState[prefix] || timeSelectionState[prefix].seq !== requestSeq) {
                            return false;
                        }
                        setTimeSelectionState(prefix, false, false, "Could not validate customer availability.");
                        showModalFeedback("addAppointmentModal", "Could not validate customer availability.", true);
                        return false;
                    });
            }

