            function goToCalendar(monthDate, preferredDay) {
                if (!(monthDate instanceof Date)) {
                    return;
                }

                var safeMonth = new Date(monthDate.getFullYear(), monthDate.getMonth(), 1);
                var maxDay = new Date(safeMonth.getFullYear(), safeMonth.getMonth() + 1, 0).getDate();
                var clampedDay = Math.max(1, Math.min(preferredDay || 1, maxDay));
                var selectedDate = new Date(safeMonth.getFullYear(), safeMonth.getMonth(), clampedDay);
                var yyyy = String(safeMonth.getFullYear());
                var mm = String(safeMonth.getMonth() + 1).padStart(2, "0");
                var dd = String(clampedDay).padStart(2, "0");
                var url = new URL(window.location.href);
                url.searchParams.set("month", yyyy + "-" + mm + "-01");
                url.searchParams.set("selectedDate", yyyy + "-" + mm + "-" + dd);
                url.searchParams.set("scope", currentCalendarScope || "monthly");
                window.location.assign(url.toString());
            }

            function parseIsoDateLocal(value) {
                if (!value) {
                    return null;
                }
                var parts = value.split("-");
                if (parts.length !== 3) {
                    return null;
                }
                return new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
            }

            function startOfWeek(dateValue) {
                var copy = new Date(dateValue.getFullYear(), dateValue.getMonth(), dateValue.getDate());
                copy.setDate(copy.getDate() - copy.getDay());
                return copy;
            }

            function endOfWeek(dateValue) {
                var copy = startOfWeek(dateValue);
                copy.setDate(copy.getDate() + 6);
                return copy;
            }

            function getSelectedCalendarDateValue() {
                return parseIsoDateLocal(selectedCalendarDate) || new Date(currentMonth.getFullYear(), currentMonth.getMonth(), selectedDay || 1);
            }

            function setActiveAgendaDate(dateText) {
                activeAgendaDate = dateText || "";
                document.querySelectorAll("[data-calendar-date]").forEach(function (day) {
                    var matches = !!activeAgendaDate && (day.getAttribute("data-calendar-date") || "") === activeAgendaDate;
                    day.classList.toggle("is-selected", matches);
                });
            }

            function getScopeDateRange(scope) {
                var selected = getSelectedCalendarDateValue();
                var normalized = (scope || "monthly").toLowerCase();
                if (normalized === "daily") {
                    return {
                        start: new Date(selected.getFullYear(), selected.getMonth(), selected.getDate()),
                        end: new Date(selected.getFullYear(), selected.getMonth(), selected.getDate())
                    };
                }
                if (normalized === "weekly") {
                    return {
                        start: startOfWeek(selected),
                        end: endOfWeek(selected)
                    };
                }
                return {
                    start: new Date(currentMonth.getFullYear(), currentMonth.getMonth(), 1),
                    end: new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 0)
                };
            }

            function isDateInScope(dateText, scope) {
                var dateValue = parseIsoDateLocal(dateText);
                if (!dateValue) {
                    return false;
                }
                var range = getScopeDateRange(scope);
                return dateValue >= range.start && dateValue <= range.end;
            }

            function shiftCalendarScope(delta) {
                var normalized = (currentCalendarScope || "monthly").toLowerCase();
                var selected = getSelectedCalendarDateValue();
                if (normalized === "daily") {
                    selected.setDate(selected.getDate() + delta);
                } else if (normalized === "weekly") {
                    selected.setDate(selected.getDate() + (delta * 7));
                } else {
                    selected = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + delta, Math.min(selected.getDate(), 28));
                }
                goToCalendar(new Date(selected.getFullYear(), selected.getMonth(), 1), selected.getDate());
            }

            function getActiveAgendaMode() {
                var active = document.querySelector("[data-agenda-filter].is-active");
                return active ? (active.getAttribute("data-agenda-filter") || "both") : "both";
