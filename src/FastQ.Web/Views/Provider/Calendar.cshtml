                    }
                    link.setAttribute("data-bound-calendar-day", "1");
                    link.addEventListener("click", function (event) {
                        //event.preventDefault();
                        var day = link.closest("[data-calendar-date]");
                        if (!day) {
                            return;
                        }
                        var dateText = day.getAttribute("data-calendar-date") || "";
                        if (!dateText) {
                            return;
                        }
                        setActiveAgendaDate(dateText);
                    });
                });

                document.addEventListener("click", function (event) {
                    if (!activeAgendaDate) {
                        return;
                    }
                    if (event.target.closest(".calendar-panel")) {
                        return;
                    }
                    setActiveAgendaDate("");
                });
            }

