    function getStatusTextForDisplay(normalizedStatus) {
      if (normalizedStatus === "arrived") return "ARRIVED";
      if (normalizedStatus === "inservice") return "IN PROGRESS";
      if (normalizedStatus === "completed") return "DONE";
      if (normalizedStatus === "cancelled") return "CANCELLED";
      if (normalizedStatus === "scheduled") return "SCHEDULED";
      if (normalizedStatus === "transferredout") return "TRANSFERRED";
      return (normalizedStatus || "").toUpperCase();
    }

    function applyLiveStatus(appointmentId, status) {
      var row = document.querySelector('.accordion-toggle[data-appointment-id="' + appointmentId + '"]');
      if (!row) {
        todayDebugLog("applyLiveStatus skipped; row not found", {
          appointmentId: appointmentId,
          status: status
        });
        return;
      }

      var normalized = normalizeStatus(status);
      var previousStatus = row.getAttribute("data-status") || "";
      row.setAttribute("data-status", status || "");
      var statusCell = row.querySelector('[data-provider-status-cell="true"]') || (row.children.length > 7 ? row.children[7] : null);
      if (statusCell) {
        statusCell.textContent = getStatusTextForDisplay(normalized);
        statusCell.classList.toggle("error", normalized === "cancelled");
      }
      providerCommon.refreshProviderActionButtonStates();
      todayDebugLog("applyLiveStatus completed", {
        appointmentId: appointmentId,
        previousStatus: previousStatus,
        nextStatus: status,
        normalizedStatus: normalized,
        statusCellFound: !!statusCell,
        rowClasses: row.className
      });
    }

    var liveSyncTimer = null;
    var liveSyncInFlight = false;
    function getRowKey(row) {
      if (!row) {
        return "";
      }
      var srcType = row.getAttribute("data-src-type") || "";
      var appointmentId = row.getAttribute("data-appointment-id") || "";
      return srcType + ":" + appointmentId;
    }

    function findDetailRowByTarget(tableBody, targetId) {
      if (!tableBody || !targetId) {
        return null;
      }
      return tableBody.querySelector('tr[id="' + targetId + '"]');
    }

    function collectRowPairs(tableBody) {
      var pairs = [];
      if (!tableBody) {
        return pairs;
      }

      tableBody.querySelectorAll("tr.accordion-toggle").forEach(function (summaryRow) {
        var targetId = summaryRow.getAttribute("data-target") || "";
        var detailRow = findDetailRowByTarget(tableBody, targetId);
        if (!detailRow) {
          return;
        }
        pairs.push({
          key: getRowKey(summaryRow),
          summary: summaryRow,
          detail: detailRow
        });
      });

      return pairs;
    }

    function getProviderRowKindLabel(srcType) {
      return (srcType || "").toUpperCase() === "W" ? "Walk-in" : "Appointment";
    }

    function getProviderRowLabel(row) {
      if (!row) {
        return "Unknown customer";
      }
      return (row.getAttribute("data-customer") || "").trim() || "Unknown customer";
    }

    function getProviderRowSnapshot(root) {
      var snapshot = {};
      if (!root) {
        return snapshot;
      }

      root.querySelectorAll("tr.accordion-toggle").forEach(function (row) {
        var key = getRowKey(row);
        if (!key) {
          return;
        }
        snapshot[key] = {
          srcType: row.getAttribute("data-src-type") || "",
          customer: getProviderRowLabel(row),
          status: row.getAttribute("data-status") || "",
          date: row.getAttribute("data-date") || ""
        };
      });
      return snapshot;
    }

    function collectProviderRowChanges(before, after) {
      var changes = [];
      Object.keys(after || {}).forEach(function (key) {
        var next = after[key];
        var previous = before ? before[key] : null;
        if (!previous) {
          changes.push({
            type: "added",
            srcType: next.srcType,
            customer: next.customer,
            date: next.date
          });
          return;
        }
        if ((previous.status || "") !== (next.status || "")) {
          changes.push({
            type: "updated",
            srcType: next.srcType,
            customer: next.customer,
            status: next.status,
            date: next.date
          });
        }
      });
      return changes;
    }

    function notifyProviderRowChanges(changes) {
      if (!changes || !changes.length) {
        return;
      }

      var todayChanges = changes.filter(function (change) {
        return (change.date || "") === toIsoDate(new Date());
      });
      if (!todayChanges.length) {
        return;
      }

      todayChanges.slice(0, 5).forEach(function (change) {
        var kind = getProviderRowKindLabel(change.srcType);
        if (change.type === "added") {
          addNotification(kind + " added: " + change.customer);
          return;
        }
        addNotification(kind + " updated: " + change.customer + " (" + change.status + ")");
      });

      if (todayChanges.length > 5) {
        addNotification((todayChanges.length - 5) + " more schedule updates received.");
      }
    }

    function applyIncomingRows(currentBody, incomingBody) {
      if (!currentBody || !incomingBody) {
        return [];
      }

      var before = getProviderRowSnapshot(currentBody);
      var incomingPairs = collectRowPairs(incomingBody);
      var incomingKeys = {};
      incomingPairs.forEach(function (pair) {
        incomingKeys[pair.key] = true;
      });

      // Remove rows that no longer exist in server response.
      collectRowPairs(currentBody).forEach(function (pair) {
        if (incomingKeys[pair.key]) {
          return;
        }
        pair.summary.parentNode.removeChild(pair.summary);
        pair.detail.parentNode.removeChild(pair.detail);
      });

      currentBody.querySelectorAll("tr.table-empty:not(.is-hidden)").forEach(function (row) {
        row.parentNode.removeChild(row);
      });

      var emptyRow = currentBody.querySelector("tr.table-empty");
      incomingPairs.forEach(function (pair) {
        var keyParts = pair.key.split(":");
        var srcType = keyParts[0] || "";
        var appointmentId = keyParts.length > 1 ? keyParts[1] : "";
        var selector = 'tr.accordion-toggle[data-appointment-id="' + appointmentId + '"][data-src-type="' + srcType + '"]';
        var currentSummary = currentBody.querySelector(selector);
        var incomingSummary = document.importNode(pair.summary, true);
        var incomingDetail = document.importNode(pair.detail, true);

        if (currentSummary) {
          var currentTargetId = currentSummary.getAttribute("data-target") || "";
          var currentDetail = findDetailRowByTarget(currentBody, currentTargetId);
          currentBody.insertBefore(incomingSummary, currentSummary);
          currentSummary.parentNode.removeChild(currentSummary);
          if (currentDetail) {
            currentBody.insertBefore(incomingDetail, currentDetail);
            currentDetail.parentNode.removeChild(currentDetail);
          } else if (emptyRow) {
            currentBody.insertBefore(incomingDetail, emptyRow);
          } else {
            currentBody.appendChild(incomingDetail);
          }
          return;
        }

        if (emptyRow) {
          currentBody.insertBefore(incomingSummary, emptyRow);
          currentBody.insertBefore(incomingDetail, emptyRow);
        } else {
          currentBody.appendChild(incomingSummary);
          currentBody.appendChild(incomingDetail);
        }
      });

      if (incomingPairs.length === 0) {
        var incomingEmptyRow = incomingBody.querySelector("tr.table-empty:not(.is-hidden)");
        var importedEmptyRow = incomingEmptyRow ? document.importNode(incomingEmptyRow, true) : null;
        var filterEmptyRow = currentBody.querySelector("tr.table-empty.is-hidden");
        if (importedEmptyRow && filterEmptyRow) {
          currentBody.insertBefore(importedEmptyRow, filterEmptyRow);
        } else if (importedEmptyRow) {
          currentBody.appendChild(importedEmptyRow);
        }
      }

      return collectProviderRowChanges(before, getProviderRowSnapshot(currentBody));
    }

    function syncTablesFromServer(notifyUpdates) {
      if (liveSyncInFlight) {
        todayDebugLog("syncTablesFromServer skipped; already in flight", { notifyUpdates: !!notifyUpdates });
        return;
      }

      liveSyncInFlight = true;
      todayDebugLog("syncTablesFromServer start", {
        notifyUpdates: !!notifyUpdates,
        url: window.location.pathname + window.location.search
      });
      var openRowIds = Array.prototype.map.call(
        document.querySelectorAll(".row-actions.is-open"),
        function (el) { return el.id; }
      );
      var lockedIds = Array.prototype.map.call(
        document.querySelectorAll(".accordion-toggle.locked"),
        function (el) { return el.getAttribute("data-appointment-id") || ""; }
      ).filter(function (id) { return !!id; });

      fetch(window.location.pathname + window.location.search, {
        method: "GET",
        credentials: "same-origin"
      })
        .then(function (res) { return res.text(); })
        .then(function (html) {
          var parser = new DOMParser();
          var nextDoc = parser.parseFromString(html, "text/html");
          var currentBodies = document.querySelectorAll(".table-card table tbody");
          var nextBodies = nextDoc.querySelectorAll(".table-card table tbody");
          var count = Math.min(currentBodies.length, nextBodies.length);
          var changes = [];

          for (var i = 0; i < count; i++) {
            changes = changes.concat(applyIncomingRows(currentBodies[i], nextBodies[i]));
          }

          if (notifyUpdates) {
            notifyProviderRowChanges(changes);
          }
          todayDebugLog("syncTablesFromServer applied", {
            tableCount: count,
            changeCount: changes.length,
            changes: changes
          });

          bindAccordionRows();
          bindProviderActionButtons();
          bindMeetingLinks();

          openRowIds.forEach(function (id) {
            var detail = document.getElementById(id);
            if (detail) {
              detail.classList.add("is-open");
            }
          });
          lockedIds.forEach(function (id) {
            lockAppointment(id);
          });

          document.querySelectorAll(".table-filters").forEach(function (container) {
            applyTableFilters(container);
          });
          var globalSearch = document.getElementById("todayGlobalSearch");
          if (globalSearch && globalSearch.value) {
            globalSearch.dispatchEvent(new Event("input"));
          }
          liveSyncInFlight = false;
        })
        .catch(function () {
          todayDebugLog("syncTablesFromServer failed");
          liveSyncInFlight = false;
        });
    }

    function queueLiveSync(notifyUpdates) {
      if (liveSyncTimer) {
        todayDebugLog("queueLiveSync skipped; timer already queued", { notifyUpdates: !!notifyUpdates });
        return;
      }
      todayDebugLog("queueLiveSync queued", { notifyUpdates: !!notifyUpdates });
      liveSyncTimer = setTimeout(function () {
        liveSyncTimer = null;
        syncTablesFromServer(!!notifyUpdates);
      }, 300);
    }

    function formatNotificationTime(date) {
      if (!date) {
        return "";
      }
      return date.toLocaleString([], {
        month: "short",
        day: "numeric",
        hour: "numeric",
        minute: "2-digit"
      });
    }

    function escapeHtml(text) {
      return (text || "").toString()
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function renderNotifications() {
      var body = document.getElementById("todayNotificationsBody");
      var count = document.getElementById("todayNotificationsCount");
      if (count) {
        count.textContent = String(todayNotificationUnreadCount);
        count.classList.toggle("show", todayNotificationUnreadCount > 0);
      }
      if (!body) {
        return;
      }
      if (!todayNotifications.length) {
        body.innerHTML = '<div class="notif-empty">No notifications yet.</div>';
        return;
      }
      body.innerHTML = todayNotifications.map(function (item) {
        return '<div class="notif-item">'
          + '<p class="notif-message">' + escapeHtml(item.message || "") + '</p>'
          + '<div class="notif-time">' + escapeHtml(item.timeText || "") + '</div>'
          + '</div>';
      }).join("");
    }

    function markNotificationsRead() {
      todayNotificationUnreadCount = 0;
      renderNotifications();
    }

    function shouldShowDesktopNotification(message) {
      var normalizedMessage = (message || "").toString().trim().toLowerCase();
      return normalizedMessage.indexOf(" added:") >= 0
        || normalizedMessage.indexOf("new booking created") === 0
        || normalizedMessage.indexOf("new walk-in created") === 0
        || normalizedMessage.indexOf("appointment scheduled") === 0
        || normalizedMessage.indexOf("customer arrived") === 0;
    }

    function toggleNotifications(forceOpen) {
      var panel = document.getElementById("todayNotificationsPanel");
      var button = document.getElementById("todayNotificationsButton");
      if (!panel || !button) {
        return;
      }
      var nextOpen = typeof forceOpen === "boolean" ? forceOpen : !panel.classList.contains("show");
      panel.classList.toggle("show", nextOpen);
      button.setAttribute("aria-expanded", nextOpen ? "true" : "false");
      if (nextOpen) {
        markNotificationsRead();
      }
    }

    function addNotification(message) {
      if (!message) {
        return;
      }
      var notificationKey = (message || "").toString().trim().toLowerCase();
      var now = Date.now();
      if (notificationKey && recentNotificationKeys[notificationKey] && now - recentNotificationKeys[notificationKey] < 3000) {
        return;
      }
      if (notificationKey) {
        recentNotificationKeys[notificationKey] = now;
      }
      todayNotifications.unshift({
        message: message,
        timeText: formatNotificationTime(new Date())
      });
      if (todayNotifications.length > maxNotificationItems) {
        todayNotifications.length = maxNotificationItems;
      }
      var panel = document.getElementById("todayNotificationsPanel");
      if (!panel || !panel.classList.contains("show")) {
        todayNotificationUnreadCount += 1;
      }
      renderNotifications();

      if (shouldShowDesktopNotification(message)) {
        showDesktopNotification(message);
      }
    }

    function isAppointmentRowScheduledToday(appointmentId) {
      var row = document.querySelector('.accordion-toggle[data-appointment-id="' + appointmentId + '"]');
      if (!row) {
        return false;
      }

      return (row.getAttribute("data-date") || "") === toIsoDate(new Date());
    }

    function getLiveStatusNotificationMessage(appointmentId, status, isSelf) {
      var normalized = normalizeStatus(status);
      var statusText = getStatusTextForDisplay(normalized);
      var row = document.querySelector('.accordion-toggle[data-appointment-id="' + appointmentId + '"]');
      var customer = row ? (row.getAttribute("data-customer") || "").trim() : "";
      var subject = customer || ("#" + appointmentId);
      var ownerText = isSelf ? "by you" : "by another provider";

      if (normalized === "inservice") {
        return "Service started for " + subject + " " + ownerText + ".";
      }
      if (normalized === "completed") {
        return "Service completed for " + subject + ".";
      }
      if (normalized === "cancelled") {
        return "Appointment cancelled for " + subject + ".";
      }
      if (normalized === "transferredout") {
        // Transfer notifications are emitted for the target only when it is today.
        return "";
      }
      if (normalized === "arrived") {
        return "Customer arrived: " + subject + ".";
      }
      if (normalized === "scheduled") {
        return "Appointment scheduled: " + subject + ".";
      }
      return statusText ? ("Appointment updated for " + subject + " (" + statusText + ").") : "";
    }

    function queueAppointmentUpdateFallbackNotification(appointmentId, status, isSelf) {
      var notifyMarker = lastFastQNotifyAt;
      if (!isAppointmentRowScheduledToday(appointmentId)) {
        return;
      }
      var message = getLiveStatusNotificationMessage(appointmentId, status, isSelf);
      if (!message) {
        return;
      }

      setTimeout(function () {
        if (lastFastQNotifyAt === notifyMarker) {
          addNotification(message);
        }
      }, 800);
    }

    window.onFastQQueueUpdated = function () {
      todayDebugLog("onFastQQueueUpdated received");
      queueLiveSync();
    };

    window.onFastQAppointmentUpdated = function (appointmentId, status, providerId) {
      var normalized = (status || "").toString().toLowerCase();
      var isSelf = (providerId || "").toString().toLowerCase() === (currentProviderId || "").toString().toLowerCase();
      var hasRow = !!document.querySelector('.accordion-toggle[data-appointment-id="' + appointmentId + '"]');
      todayDebugLog("onFastQAppointmentUpdated received", {
        appointmentId: appointmentId,
        status: status,
        normalizedStatus: normalized,
        providerId: providerId,
        currentProviderId: currentProviderId,
        isSelf: isSelf,
        hasRow: hasRow
      });
      applyLiveStatus(appointmentId, status);
      if (normalized === "inservice") {
        setAppointmentLocked(appointmentId, !isSelf);
      } else if (normalized === "completed" || normalized === "cancelled" || normalized === "transferredout" || normalized === "scheduled" || normalized === "arrived") {
        setAppointmentLocked(appointmentId, false);
      }
      document.querySelectorAll(".table-filters").forEach(function (container) {
        applyTableFilters(container);
      });
      queueAppointmentUpdateFallbackNotification(appointmentId, status, isSelf);
      // New rows (e.g. transfer target) may not exist locally yet.
      if (!hasRow && (normalized === "scheduled" || normalized === "arrived")) {
        todayDebugLog("onFastQAppointmentUpdated queueing sync because row is missing", {
          appointmentId: appointmentId,
          status: status
        });
        queueLiveSync();
      }
    };

    window.onFastQNotify = function (message) {
      lastFastQNotifyAt = Date.now();
      todayDebugLog("onFastQNotify received", { message: message });
      addNotification(message);
    };

    var todayNotificationsButton = document.getElementById("todayNotificationsButton");
