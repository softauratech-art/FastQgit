    function isVisibleRangePastOnly() {
      var todayIso = toIsoDate(new Date());
      return !!visibleRangeEndDate && visibleRangeEndDate < todayIso;
    }

    if (!isVisibleRangePastOnly()) {
      setInterval(refreshExternalProviderRows, 60 * 1000);
    } else {
      todayDebugLog("auto refresh disabled; selected date range is fully in the past", {
        visibleRangeEndDate: visibleRangeEndDate,
        today: toIsoDate(new Date())
      });
    }

  })();
    </script>

    <script>
    document.addEventListener("DOMContentLoaded", function () {
      requestDesktopNotificationPermission();
    });

    function canUseDesktopNotifications() {
      return "Notification" in window;
    }

    function requestDesktopNotificationPermission() {
      if (!canUseDesktopNotifications()) {
        return;
      }
      if (Notification.permission === "denied") {
        window.alert("Notifications are disabled. Please enable them in your browser settings.");
        return;
      }
      if (Notification.permission !== "default"
          || typeof Notification.requestPermission !== "function") {
        return;
      }

      var permissionRequest = Notification.requestPermission();
      if (permissionRequest && typeof permissionRequest.catch === "function") {
        permissionRequest.catch(function (error) {
          console.warn("Desktop notification permission request failed.", error);
        });
      }
    }

    function showDesktopNotification(message) {
      if (!message || !canUseDesktopNotifications()) {
        return;
      }

      function displayNotification() {
        try {
          var notification = new Notification("FastQ Message", {
            body: message
          });
          notification.onclick = function () {
            window.focus();
            notification.close();
          };
        } catch (error) {
          console.warn("Desktop notification could not be shown.", error);
        }
      }

      if (Notification.permission === "granted") {
        displayNotification();
        return;
      }

      if (Notification.permission === "default"
          && typeof Notification.requestPermission === "function") {
        var permissionRequest = Notification.requestPermission();
        if (permissionRequest && typeof permissionRequest.then === "function") {
          permissionRequest.then(function (permission) {
            if (permission === "granted") {
              displayNotification();
            }
          }).catch(function (error) {
            console.warn("Desktop notification permission request failed.", error);
          });
        }
      }
    }
    </script>
}
