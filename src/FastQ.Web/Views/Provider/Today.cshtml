<div id="serviceRouteModal" class="modal-backdrop route-modal" role="dialog" aria-modal="true" aria-labelledby="serviceRouteModalTitle">
    <div class="modal">
        <div class="modal-header">
            <h5 class="modal-title" id="serviceRouteModalTitle">Route Appointment</h5>
            <button class="btn small ghost" type="button" data-modal-close="serviceRouteModal">Close</button>
        </div>
        <div class="modal-body">
            <div class="modal-feedback" data-modal-feedback="serviceRouteModal"></div>
            <div class="route-form-row">
                <label for="routeTargetKind">Target Type</label>
                <select id="routeTargetKind" class="route-input">
                    <option value="W">Walkin (FCFS)</option>
                    <option value="A">Appointment</option>
                </select>
            </div>
            <div class="route-form-row">
                <label for="routeTargetQueueId">Queue</label>
                <select id="routeTargetQueueId" class="route-input">
                    <option value="">Select queue</option>
                </select>
            </div>
            <div class="route-form-row">
                <label for="routeTargetServiceId">Service</label>
                <select id="routeTargetServiceId" class="route-input">
                    <option value="">Select service</option>
                </select>
            </div>
            <div class="route-form-row route-appointment-only" id="routeDateRow">
                <label for="routeTargetDateDisplay">Target Date</label>
                <input id="routeTargetDate" type="hidden" value="" data-current-value="" />
                <div class="entry-date-picker" id="routeTargetDatePicker">
