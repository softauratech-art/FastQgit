    function openRouteModal(mode, appointmentId, srcType, completionNotes) {
      var routeMode = document.getElementById("routeMode");
      var routeSrcType = document.getElementById("routeSrcType");
      var routeSrcId = document.getElementById("routeSrcId");
      var routeOriginalNotes = document.getElementById("routeOriginalNotes");
      var routeCompletionNotes = document.getElementById("routeCompletionNotes");
      var routeTitle = document.getElementById("serviceRouteModalTitle");
      var saveRouteButton = document.getElementById("saveRoute");
      var targetKind = document.getElementById("routeTargetKind");
      var targetQueueId = document.getElementById("routeTargetQueueId");
      var targetServiceId = document.getElementById("routeTargetServiceId");
      var targetDate = document.getElementById("routeTargetDate");
      var targetTime = document.getElementById("routeTargetTime");
      var refRow = document.getElementById("routeRefRow");
      var notesRow = document.getElementById("routeNotesRow");
      var refValue = document.getElementById("routeRefValue");
      var notes = document.getElementById("routeNotes");
      var sourceContext = getRouteSourcePrefill(appointmentId, srcType);
      var sourcePrefill = mode === "cancel-transfer" ? sourceContext : null;
      var lockReference = mode === "end-add";
      var hideTransferRefAndNotes = mode === "transfer" || mode === "cancel-transfer";

      if (!routeMode || !routeSrcType || !routeSrcId || !targetKind) {
        return;
      }

      routeMode.value = mode;
      routeSrcType.value = srcType;
      routeSrcId.value = appointmentId;
      if (routeTitle) {
        routeTitle.textContent = mode === "cancel-transfer" ? "Cancel + Reschedule" : (mode === "end-add" ? "End + New" : "Transfer Appointment");
      }
      if (saveRouteButton) {
        saveRouteButton.textContent = mode === "cancel-transfer" ? "Cancel + Reschedule" : (mode === "end-add" ? "End + New" : "Transfer Appointment");
      }
      if (routeOriginalNotes) routeOriginalNotes.value = sourceContext ? sourceContext.notes : "";
      if (routeCompletionNotes) routeCompletionNotes.value = completionNotes || "";
      targetKind.value = srcType === "A" ? "A" : "W";
      if (targetQueueId) targetQueueId.value = sourcePrefill ? sourcePrefill.queueId : "";
      if (targetServiceId) targetServiceId.value = sourcePrefill ? sourcePrefill.serviceId : "";
      if (targetDate) targetDate.value = "";
      if (targetTime) targetTime.value = "";
      if (refRow) refRow.classList.toggle("is-hidden", hideTransferRefAndNotes);
      if (notesRow) notesRow.classList.remove("is-hidden");
      if (refValue) {
        refValue.disabled = !!lockReference || hideTransferRefAndNotes;
        if (lockReference && sourceContext) {
          ensureSelectOption(refValue, sourceContext.refValue, sourceContext.refValue);
        }
        refValue.value = lockReference && sourceContext ? sourceContext.refValue : (sourcePrefill ? sourcePrefill.refValue : "");
      }
      if (notes) {
        notes.disabled = false;
        notes.value = sourcePrefill ? sourcePrefill.notes : "";
      }
      toggleRouteDateRow();
      loadRouteQueues(sourcePrefill ? sourcePrefill.queueId : "", sourcePrefill ? sourcePrefill.serviceId : "").then(function () {
        lockRouteReferenceFromSource();
        if (sourcePrefill && targetKind && targetKind.value === "A") {
          populateRouteDateOptions(sourcePrefill.date).then(function () {
            populateRouteTimeOptions(to24Hour(sourcePrefill.time || ""));
          });
          return;
        }
        populateRouteDateOptions("");
        populateRouteTimeOptions("");
      });
      openModal("serviceRouteModal");
    }

