<div id="meetingModal" class="modal-backdrop info-modal" role="dialog" aria-modal="true" aria-labelledby="meetingModalTitle">
    <div class="modal">
        <div class="modal-header">
            <h5 class="modal-title" id="meetingModalTitle">Meeting Details</h5>
            <button class="btn small ghost" type="button" data-modal-close="meetingModal">Close</button>
        </div>
        <div class="modal-body">
            <div class="modal-feedback" data-modal-feedback="meetingModal"></div>
            <div class="info-summary-grid">
                <div class="info-chip"><span class="info-chip-label">Meeting Id</span><span id="mid"></span></div>
                <div class="info-chip"><span class="info-chip-label">Date</span><span id="meetingDate"></span></div>
                <div class="info-chip"><span class="info-chip-label">Time</span><span id="meetingTime"></span></div>
                <div class="info-chip info-chip-wide"><span class="info-chip-label">Title</span><span id="meetingTitle"></span></div>
            </div>
            <div class="info-section">
                <div class="info-section-title">Customer</div>
                <div class="info-kv-grid">
                    <div class="info-kv"><span>Name</span><strong id="meetingCustomer"></strong></div>
                    <div class="info-kv"><span>Phone</span><strong id="meetingPhone"></strong></div>
                    <div class="info-kv info-kv-wide"><span>Email</span><strong id="meetingEmail"></strong></div>
                </div>
            </div>
            <div class="info-section">
                <div class="info-section-title">Service</div>
                <div class="info-kv-grid">
                    <div class="info-kv"><span>Queue</span><strong id="meetingQueue"></strong></div>
                    <div class="info-kv"><span>Service</span><strong id="meetingService"></strong></div>
                    <div class="info-kv"><span>Ref Value</span><strong id="meetingRefValue"></strong></div>
                    <div class="info-kv"><span>Contact</span><strong id="meetingContact"></strong></div>
                    <div class="info-kv"><span>Language</span><strong id="meetingLanguage"></strong></div>
                    <div class="info-kv"><span>Status</span><strong id="meetingStatus"></strong></div>
                    <div class="info-kv info-kv-wide"><span>Stamp User</span><strong id="meetingStampUser"></strong></div>
                </div>
            </div>
            <div class="field-row">
                <div>Guest URL:</div>
                <input id="mGuestURL" type="text" value="" />
            </div>
            <div class="field-row">
                <div>Host URL:</div>
                <input id="mURL" type="text" value="" />
            </div>
            <div class="field-row">
                <div>Previous Notes:</div>
                <div id="mPreviousNotes" class="route-input info-readonly">-</div>
            </div>
            <div class="field-row">
                <div>Add Notes:</div>
                <textarea id="mNotes" rows="3"></textarea>
            </div>
            <div class="helper-text">Guest URL, host URL, and notes are saved. Text entered in Add Notes is appended to Previous Notes.</div>
        </div>
        <div class="modal-footer">
            <button class="btn ghost" type="button" data-modal-close="meetingModal">Close</button>
            <button class="btn primary" type="button" id="saveMeeting">Save Changes</button>
        </div>
    </div>
</div>

