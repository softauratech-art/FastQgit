@using System
@using System.Collections.Generic
@using System.Globalization
@using FastQ.Data.Entities
@using FastQ.Web.Models
@using Newtonsoft.Json
@model ProviderTodayViewModel
@{
    ViewBag.Title = "Provider Today";
    var walkinRows = Model.Walkins ?? new List<ProviderAppointmentRow>();
    var appointmentRows = Model.Appointments ?? new List<ProviderAppointmentRow>();
    var statusOptions = new[] { "ACTIVE" }
        .Concat(Enum.GetNames(typeof(AppointmentStatus)))
        .ToList();
    var defaultDate = (ViewBag.StartDate as string) ?? DateTime.Now.ToString("yyyy-MM-dd");
    var endDate = (ViewBag.EndDate as string) ?? defaultDate;
    var actionName = (ViewContext.RouteData.Values["action"] as string) ?? "Today";
    DateTime parsedStart;
    var startDateValue = DateTime.TryParseExact(defaultDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out parsedStart)
        ? parsedStart.Date
        : DateTime.Now.Date;
    DateTime parsedEnd;
    var endDateValue = DateTime.TryParseExact(endDate, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out parsedEnd)
        ? parsedEnd.Date
        : startDateValue;
    if (endDateValue < startDateValue)
    {
        endDateValue = startDateValue;
    }
    var rangeDays = Math.Max(1, (endDateValue - startDateValue).Days + 1);
    var prevStart = startDateValue.AddDays(-rangeDays).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var prevEnd = endDateValue.AddDays(-rangeDays).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var nextStart = startDateValue.AddDays(rangeDays).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var nextEnd = endDateValue.AddDays(rangeDays).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    var showWalkins = (ViewBag.ShowWalkins as bool?) ?? true;
    var showAppointments = (ViewBag.ShowAppointments as bool?) ?? true;
    var serviceAccess = ViewBag.ServiceAccess as ServicePageAccess ?? new ServicePageAccess();
    var currentProviderId = ((ViewBag.ProviderId as string) ?? string.Empty).Trim();
    Func<object, string> getStampUser = item =>
    {
        if (item == null) return string.Empty;
        var prop = item.GetType().GetProperty("StampUser");
        var value = prop == null ? null : prop.GetValue(item, null);
        return value == null ? string.Empty : value.ToString();
    };
    var queueOptions = walkinRows.Select(r => r.QueueName)
        .Concat(appointmentRows.Select(r => r.QueueName))
        .Where(q => !string.IsNullOrWhiteSpace(q))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(q => q, StringComparer.OrdinalIgnoreCase)
        .ToList();
}
@section Head {
    <link rel="stylesheet" href="~/Content/today.css" />
}

@section PageHeader {
<div>
    <div class="topbar-title">Schedule for @Model.DateText</div>
    <div class="topbar-sub">Appointments and walk-in customers</div>
</div>
<div class="top-actions">
    <div class="notif-wrap">
        <button class="icon-btn" id="todayNotificationsButton" type="button" aria-label="Notifications" aria-expanded="false" aria-controls="todayNotificationsPanel">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 17h5l-1.4-1.4A4 4 0 0 1 17 12.8V10a5 5 0 0 0-10 0v2.8a4 4 0 0 1-1.6 3.2L4 17h5"></path>
                <path d="M9 17a3 3 0 0 0 6 0"></path>
            </svg>
            <span id="todayNotificationsCount" class="notif-count" aria-hidden="true">0</span>
        </button>
        <div id="todayNotificationsPanel" class="notif-panel" role="dialog" aria-label="Notifications">
            <div class="notif-panel-header">
                <div class="notif-panel-title">Notifications</div>
                <button class="btn small ghost" id="todayNotificationsClear" type="button">Clear</button>
            </div>
            <div id="todayNotificationsBody" class="notif-panel-body">
                <div class="notif-empty">No notifications yet.</div>
            </div>
        </div>
    </div>
    <button class="icon-btn" type="button" aria-label="Support" style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 11a8 8 0 0 1 16 0v5"></path>
            <path d="M4 16a2 2 0 0 0 2 2h2v-5H6a2 2 0 0 0-2 2Z"></path>
            <path d="M20 16a2 2 0 0 1-2 2h-2v-5h2a2 2 0 0 1 2 2Z"></path>
        </svg>
    </button>
    <button class="icon-btn" type="button" aria-label="User menu" style="display:none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8" r="3.5"></circle>
            <path d="M5 20c1.5-4 12.5-4 14 0"></path>
        </svg>
    </button>
    <div class="search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input type="text" id="todayGlobalSearch" placeholder="Search queues, names, or status" />
    </div>
</div>
}

<div class="card note">
    <div class="date-nav"></div>


    <div class="table-filters" data-table-filter="walkins">
        <div class="filter-group">
            <label for="customerNameSearch">Customer</label>
            <input id="customerNameSearch" class="filter-input" type="search" data-filter="customer" placeholder="Search customer name" />
        </div>
        <div class="filter-group">
            <label for="walkinsStatus">Status</label>
            <select id="walkinsStatus" class="filter-input" data-filter="status">
                <option value="all">All</option>
                @foreach (var status in statusOptions)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label for="queueFilter">Queue</label>
            <select id="queueFilter" class="filter-input" data-filter="queue">
                <option value="all">All</option>
                @foreach (var queueName in queueOptions)
                {
                    <option value="@queueName">@queueName</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label for="walkinsStartDate">Date</label>
            <div class="action-bar date-range">
                <button class="btn small ghost" type="button" data-date-shift="-1" data-date-target="start" aria-label="Previous day">&lt;</button>
                <input id="walkinsStartDate" class="filter-input" type="date" data-filter="start" value="@defaultDate" />
                <button class="btn small ghost" type="button" data-date-shift="1" data-date-target="start" aria-label="Next day">&gt;</button>
                <span>to</span>
                <button class="btn small ghost" type="button" data-date-shift="-1" data-date-target="end" aria-label="Previous day">&lt;</button>
                <input id="walkinsEndDate" class="filter-input" type="date" data-filter="end" value="@endDate" />
                <button class="btn small ghost" type="button" data-date-shift="1" data-date-target="end" aria-label="Next day">&gt;</button>
            </div>
        </div>
        <button class="btn small ghost" type="button" data-filter-reset="true">Reset</button>
    </div>

</div>

@if (showWalkins)
{
    <div class="card">
        <div class="table-name-label">Walk-ins</div>
        <div class="table-card">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th data-sort-key="time">Start</th>
                        <th data-sort-key="text">Queue</th>
                        <th data-sort-key="text">Type of Service</th>
                        <th data-sort-key="text">Name</th>
                        <th data-sort-key="text">Phone</th>
                        <th data-sort-key="text">Ref Value</th>
                        <th data-sort-key="text">Language</th>
                        <th data-sort-key="text">Status</th>
                        <th data-sort-key="text">Contact</th>
                        <th class="text-center">Join Meeting</th>
                        <th class="text-center">Expand</th>
                    </tr>
                </thead>
                <tbody>
                    @if (walkinRows.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center">No walk-ins for today.</td>
                        </tr>
                    }
                    else
                    {
                        for (var i = 0; i < walkinRows.Count; i++)
                        {
                            var row = walkinRows[i];
                            var rowId = "walkin-" + row.AppointmentId.ToString(CultureInfo.InvariantCulture);
                            var rowStatus = row.Status.ToString();
                            var rowDate = row.ScheduledFor.ToString("yyyy-MM-dd");
                            var statusClass = row.Status == AppointmentStatus.Cancelled ? "error" : string.Empty;
                            var rowStampUser = getStampUser(row);
                            var isLocked = row.Status == AppointmentStatus.InService && !string.Equals(rowStampUser, currentProviderId, StringComparison.OrdinalIgnoreCase);
                            <tr class="accordion-toggle @(isLocked ? "locked" : null)" data-target="@rowId" data-appointment-id="@row.AppointmentId" data-src-type="W" data-status="@rowStatus" data-date="@rowDate" data-customer="@row.CustomerName" data-queue="@row.QueueName">
                                <td>@row.StartDateText<br />@row.StartTimeText</td>
                                <td><button type="button" class="expandable-text" title="@row.QueueName" aria-expanded="false">@row.QueueName</button></td>
                                <td><button type="button" class="expandable-text" title="@row.ServiceType" aria-expanded="false">@row.ServiceType</button></td>
                                <td>@row.CustomerName</td>
                                <td>@row.Phone</td>
                                <td><button type="button" class="expandable-text" title="@row.RefValue" aria-expanded="false">@row.RefValue</button></td>
                                <td>@row.LanguagePreference</td>
                                <td class="@statusClass">@row.StatusText</td>
                                <td>@row.ContactMethod</td>
                                <td class="text-center">
                                    @if (string.Equals((row.ContactTypeCode ?? string.Empty).Trim(), "OM", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(row.MeetingUrl))
                                    {
                                        <a class="btn small ghost" href="@Url.Action("JoinMeeting", "Provider", new {srctype='W', srcid = row.AppointmentId })" target="_blank" rel="noopener">Join Meeting</a>
                                    }
                                </td>
                                <td class="text-center">&darr;</td>
                            </tr>
                            <tr class="row-actions @(isLocked ? "locked" : null)" id="@rowId"
                                data-appointment-id="@row.AppointmentId"
                                data-src-type="W"
                                data-queue-id="@row.QueueId"
                                data-service-id="@row.ServiceId"
                                data-ref-value="@row.RefValue"
                                data-notes="@row.Notes"
                                data-date="@rowDate"
                                data-time="@row.StartTimeText">
                                <td colspan="11">
                                    <div class="action-bar">
                                        <div class="action-bar-main">
                                            <button class="btn small primary" type="button" data-provider-action="true" data-action="arrive" data-appointment-id="@row.AppointmentId" data-src-type="W" data-queue-id="@row.QueueId">Check-In</button>
                                            <button class="btn small secondary" type="button" data-provider-action="true" data-action="begin" data-appointment-id="@row.AppointmentId" data-src-type="W" data-queue-id="@row.QueueId">Start</button>
                                            <button class="btn small secondary" type="button" data-provider-action="true" data-action="end" data-appointment-id="@row.AppointmentId" data-src-type="W" data-queue-id="@row.QueueId">End</button>
                                            <button class="btn small ghost" type="button" data-provider-action="true" data-action="transfer" data-appointment-id="@row.AppointmentId" data-src-type="W" data-queue-id="@row.QueueId">Transfer</button>
                                            <button class="btn small ghost meeting-link" type="button"
                                                    data-appointment-id="@row.AppointmentId"
                                                    data-src-type="W"
                                                    data-date="@row.StartDateText"
                                                    data-time="@row.StartTimeText"
                                                    data-title="@row.ServiceType"
                                                    data-customer="@row.CustomerName"
                                                    data-email="@row.CustomerEmail"
                                                    data-phone="@row.Phone"
                                                    data-queue-name="@row.QueueName"
                                                    data-service-name="@row.ServiceType"
                                                    data-ref-value="@row.RefValue"
                                                    data-language="@row.LanguagePreference"
                                                    data-status-text="@row.StatusText"
                                                    data-contact="@row.ContactMethod"
                                                    data-stamp-user="@rowStampUser"
                                                    data-meeting-url="@row.MeetingUrl"
                                                    data-meeting-url-host="@row.MeetingUrlHost"
                                                    data-notes="@row.Notes">
                                                Info
                                            </button>
                                            <button class="btn small ghost" type="button" data-provider-action="true" data-action="remove" data-appointment-id="@row.AppointmentId" data-src-type="W" data-queue-id="@row.QueueId">Cancel</button>
                                        </div>
                                        <div class="action-bar-meta">Stamp User: @(string.IsNullOrWhiteSpace(rowStampUser) ? "-" : rowStampUser)</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    <tr class="table-empty is-hidden">
                        <td colspan="11" class="text-center">No results match the selected filters.</td>
                    </tr>
                </tbody>
            </table>
        </div>

        @if (serviceAccess.CanAddEntries)
        {
            <button class="btn primary" type="button" data-modal-open="addWalkinModal">Add Customer to Queue</button>
        }
    </div>
}

