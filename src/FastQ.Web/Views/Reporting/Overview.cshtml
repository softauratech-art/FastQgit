@{
    ViewBag.Title = "Reporting";
}


@section PageHeader {
    <div>
        @*<div class="eyebrow">Reporting</div>*@
        <div class="topbar-title">Daily summary and provider activity</div>
        <div class="topbar-sub">Reporting is loaded from the database and refreshed on demand.</div>
    </div>
    <div class="top-actions">
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Filters</h3>
        <span class="badge accent">DB</span>
    </div>
    <div class="row">
        <div class="col">
            <label for="reportQueue">Queue</label>
            <select id="reportQueue"></select>
        </div>
        <div class="col">
            <label for="reportPeriod">Period</label>
            <select id="reportPeriod">
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="monthly">Monthly</option>
                <option value="range">Date Range</option>
            </select>
        </div>
        <div class="col range-only report-range-col" style="display:none;">
            <label>Date range</label>
            <div class="report-date-range">
                <div class="report-date-field">
                    <label for="reportStartDate">Start date</label>
                    <input type="date" id="reportStartDate" />
                </div>
                <span class="report-date-sep">to</span>
                <div class="report-date-field">
                    <label for="reportEndDate">End date</label>
                    <input type="date" id="reportEndDate" />
                </div>
            </div>
        </div>
        <div class="col" style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;">
            <button type="button" class="btn primary" onclick="FastQReport.refresh()">Refresh</button>
            <button type="button" class="btn secondary" onclick="FastQReport.exportData('csv')">Export CSV</button>
            <button type="button" class="btn secondary" onclick="FastQReport.exportData('excel')">Export Excel</button>
            <span id="reportMsg" class="muted"></span>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">7-day booking trend</h3>
        <span class="pill">Last 7 days</span>
    </div>
    <div id="trendChart" class="stack"></div>
</div>

<div class="report-grid">
    <div class="stat">
        <div class="stat-label" id="bookedLabel">Booked (Daily)</div>
        <div class="stat-value" id="reportBooked">0</div>
    </div>
    <div class="stat">
        <div class="stat-label" id="scheduledLabel">Scheduled (Daily)</div>
        <div class="stat-value" id="reportScheduled">0</div>
    </div>
    <div class="stat">
        <div class="stat-label" id="completedLabel">Completed (Daily)</div>
        <div class="stat-value" id="reportCompleted">0</div>
    </div>
    <div class="stat">
        <div class="stat-label" id="cancelledLabel">Cancellations (Daily)</div>
        <div class="stat-value" id="reportCancelled">0</div>
    </div>
</div>

<div class="grid-2">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Provider activity</h3>
            <span class="pill" id="providerPeriodPill">Daily</span>
        </div>
        <div id="providerTable"></div>
    </div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Queue breakdown</h3>
            <span class="pill" id="queuePeriodPill">Daily</span>
        </div>
        <div id="queueTable"></div>
    </div>
</div>

@section Scripts {
    <script>
        window.FASTQ_CONTEXT = {
            entityId: @(new FastQ.Web.Services.AuthService().GetSessionEntityId())
        };

        var FastQReport = {
            refresh: function () {
                var queueId = document.getElementById("reportQueue").value;
                var period = document.getElementById("reportPeriod").value;
                var startDate = document.getElementById("reportStartDate").value;
                var endDate = document.getElementById("reportEndDate").value;

                $("#reportMsg").removeClass("error ok").text("Loading...");
                $.getJSON("@Url.Action("ReportingSnapshot", "Reporting")", {
                    entityId: window.FASTQ_CONTEXT.entityId,
                    queueId: queueId,
                    period: period,
                    startDate: startDate,
                    endDate: endDate
                })
                    .done(function (res) {
                        if (!res || !res.ok) {
                            $("#reportMsg").addClass("error").text(res && res.error ? res.error : "Load failed");
                            return;
                        }
                        $("#reportMsg").addClass("ok").text("Up to date.");
                        FastQReport.render(res.data);
                    })
                    .fail(function () {
                        $("#reportMsg").addClass("error").text("Load failed.");
                    });
            },

            render: function (d) {
                $("#reportBooked").text(d.BookedToday);
                $("#reportScheduled").text(d.ScheduledToday);
                $("#reportCompleted").text(d.CompletedToday);
                $("#reportCancelled").text(d.CancelledToday);
                FastQReport.updatePeriodPills(d.FilterPeriod, d.FilterStart, d.FilterEnd);

                FastQReport.renderQueues(d.Queues || []);
                FastQReport.renderProviders(d.Providers || []);
                FastQReport.renderTrend(d.DailyTrend || []);

                var queueSelect = document.getElementById("reportQueue");
                if (queueSelect && queueSelect.options.length === 0) {
                    queueSelect.appendChild(new Option("All queues", ""));
                    (d.Queues || []).forEach(function (q) {
                        queueSelect.appendChild(new Option(q.QueueName, q.QueueId));
                    });
                }
            },

            renderQueues: function (rows) {
                if (!rows || rows.length === 0) {
                    $("#queueTable").html("<div class='muted'>No queue data yet.</div>");
                    return;
                }
                var html = "<table class='table'><thead><tr>" +
                    "<th>Queue</th><th>Waiting</th><th>In Service</th><th>Completed</th><th>Cancelled</th>" +
                    "</tr></thead><tbody>";
                rows.forEach(function (r) {
                    html += "<tr>" +
                        "<td>" + r.QueueName + "</td>" +
                        "<td>" + r.Waiting + "</td>" +
                        "<td>" + r.InService + "</td>" +
                        "<td>" + r.Completed + "</td>" +
                        "<td>" + r.Cancelled + "</td>" +
                        "</tr>";
                });
                html += "</tbody></table>";
                $("#queueTable").html(html);
            },

            renderProviders: function (rows) {
                if (!rows || rows.length === 0) {
                    $("#providerTable").html("<div class='muted'>No provider activity yet.</div>");
                    return;
                }
                var html = "<table class='table'><thead><tr>" +
                    "<th>Provider</th><th>Arrived</th><th>In Service</th><th>Completed</th><th>Cancelled</th>" +
                    "</tr></thead><tbody>";
                rows.forEach(function (r) {
                    html += "<tr>" +
                        "<td>" + r.ProviderName + "</td>" +
                        "<td>" + r.Arrived + "</td>" +
                        "<td>" + r.InService + "</td>" +
                        "<td>" + r.Completed + "</td>" +
                        "<td>" + r.Cancelled + "</td>" +
                        "</tr>";
                });
                html += "</tbody></table>";
                $("#providerTable").html(html);
            },

            renderTrend: function (rows) {
                if (!rows || rows.length === 0) {
                    $("#trendChart").html("<div class='muted'>No trend data yet.</div>");
                    return;
                }
                var max = Math.max.apply(null, rows.map(function (r) { return r.Booked; }).concat([1]));
                var html = "";
                rows.forEach(function (r) {
                    var pct = Math.round((r.Booked / max) * 100);
                    html += "<div class='trend-row'>" +
                        "<div class='muted'>" + r.Date + "</div>" +
                        "<div class='bar-track'><div class='bar-fill' style='width:" + pct + "%'></div></div>" +
                        "<div>" + r.Booked + "</div>" +
                        "</div>";
                });
                $("#trendChart").html(html);
            },

            updatePeriodPills: function (period, start, end) {
                var label = "Daily";
                if (period === "weekly") label = "Weekly";
                if (period === "monthly") label = "Monthly";
                if (period === "range") label = (start && end) ? (start + " to " + end) : "Date Range";
                $("#providerPeriodPill").text(label);
                $("#queuePeriodPill").text(label);
                $("#bookedLabel").text("Booked (" + label + ")");
                $("#scheduledLabel").text("Scheduled (" + label + ")");
                $("#completedLabel").text("Completed (" + label + ")");
                $("#cancelledLabel").text("Cancellations (" + label + ")");
            },

            onPeriodChanged: function () {
                var showRange = document.getElementById("reportPeriod").value === "range";
                $(".range-only").toggle(showRange);
            },

            exportData: function (format) {
                var action = format === "excel" ? "@Url.Action("ExportExcel", "Reporting")" : "@Url.Action("ExportCsv", "Reporting")";
                var query = $.param({
                    entityId: window.FASTQ_CONTEXT.entityId,
                    queueId: document.getElementById("reportQueue").value,
                    period: document.getElementById("reportPeriod").value,
                    startDate: document.getElementById("reportStartDate").value,
                    endDate: document.getElementById("reportEndDate").value
                });
                window.location.href = action + "?" + query;
            }
        };

        $(function () {
            var now = new Date();
            var local = new Date(now.getTime() - (now.getTimezoneOffset() * 60000));
            var today = local.toISOString().slice(0, 10);
            $("#reportStartDate").val(today);
            $("#reportEndDate").val(today);
            $("#reportPeriod").on("change", function () {
                FastQReport.onPeriodChanged();
                FastQReport.refresh();
            });
            FastQReport.onPeriodChanged();
            FastQReport.refresh();
        });

        window.onFastQQueueUpdated = function () { FastQReport.refresh(); };
        window.onFastQAppointmentUpdated = function () { FastQReport.refresh(); };
    </script>
}
