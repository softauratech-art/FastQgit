@model IEnumerable<FastQ.Web.Models.Admin.UserVM>

@{
    ViewBag.Title = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head{
    <link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.min.css" rel="stylesheet" />
    <link href="~/Content/datatablesFQ.css" rel="stylesheet" />
    <link href="~/Content/siteadmin.css" rel="stylesheet" />
}

@section PageHeader {
    <div>
        <div class="topbar-title">Manage User Accounts</div>
        <div class="topbar-sub">Add, Edit and Remove users</div>
    </div>
}

<div class="card">
    <table id="Usrdata" class="table" style="font-size:0.95em">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.UserId)</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                @*<th>@Html.DisplayNameFor(model => model.Title)</th>*@
                <th>Super Admin?</th>
                <th>Active?</th>
                <th>Other Lang?</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.UserId">
                    <td>
                        @Html.DisplayFor(modelItem => item.UserId)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.FirstName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                    <td class="text-center">
                        <span class="@(item.IsAdmin ? "status-dot" : "inactive-dot")"></span>
                        <span class="is-hidden">@item.IsAdmin</span>
                    </td>
                    <td class="text-center">
                        <span class="@(item.IsActive ? "status-dot" : "inactive-dot")"></span>
                        <span class="is-hidden">@item.IsActive</span>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OtherLanguage)
                    </td>
                    <td class="table-actions">
                        <a href="@Url.Action("Edit", "User", new { id = item.UserId })" class="btn small ghost btn-action-edit">
                            <i class="bi bi-pencil "></i> Edit
                        </a>
                        <a href="#" class="btn small ghost btn-action-delete"
                           onclick="return showConfirmModal('@item.UserId');">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>

<dialog id="deleteConfirmModal" class="modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="queue-modal-header">
                <h5 class="modal-title">Confirm Delete?</h5>
            </div>
            <div class="modal-body queue-modal-body" id="delete-modal-body">
                Are you sure you want to delete this record?
            </div>
            <div class="modal-footer">
                <button id="cancelDeleteBtn" class="btn ghost">Cancel</button>
                <button id="confirmDeleteBtn" class="btn ghost btn-action-delete">Confirm</button>
            </div>
        </div>
    </div>
</dialog>


<div id="feedbackModal" class="modal-backdrop hide" role="dialog" aria-modal="true" aria-labelledby="feedbackModal">
    <div class="modal fade" id="" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="feedback-modal-title">Success!</h5>
                </div>
                <div class="modal-body" id="feedback-modal-body">Operation successful.</div>
                <div class="modal-footer" style="justify-content: flex-end;">
                    <button type="button" class="btn ghost btn-primary" data-dismiss="modal" onclick="document.getElementById('feedbackModal').classList.remove('show')">OK</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.min.js"></script>
    <script>
        $(document).ready(function () {

            const deletemodal = document.getElementById('deleteConfirmModal');
            const confirmBtn = document.getElementById('confirmDeleteBtn');
            const cancelBtn = document.getElementById('cancelDeleteBtn');

            showConfirmModal = (uid) => {
                const msg = '<div>You are about to delete user <strong>' + uid + '</strong> permanently.</div><div>Are you sure you want to delete this record ?</div>';
                   
                document.getElementById('delete-modal-body').innerHTML = msg;
                confirmBtn.setAttribute('data-uid', uid);                
                deletemodal.showModal();
            }

            showFeedbackModal = (title, msg) => {
                document.getElementById('feedback-modal-title').innerHTML = title;
                document.getElementById('feedback-modal-body').innerHTML = msg;
                document.getElementById('feedbackModal').classList.add("show");
            }


            confirmBtn.addEventListener('click', () => {
                const uid = confirmBtn.getAttribute('data-uid');
                confirmAndpostdelete(uid);
                deletemodal.close();
            });

            cancelBtn.addEventListener('click', () => {
                deletemodal.close();
            });

            confirmAndpostdelete = (uid) => {
                {
                    var flag = (uid); //checks if uid hasvalue or empty
                    if (flag) {
                        $.ajax({
                            url: '@Url.Action("DeleteConfirmed", "User")',
                            type: 'POST',
                            data: { uid: uid },
                            dataType: 'json',
                            success: function (response) {
                                if (response.response === "success") {                                                                    
                                	showFeedbackModal("Success", uid + " deleted successfully.");
                                    $('#row-' + uid).remove();
                                } else {                                    
                                    showFeedbackModal("Error", "Deletion failed: " + response.message);
                                }
                            },
                            error: function () { alert('Error! ' + result); }
                        });
                    }
                    else {
                        showFeedbackModal("Error", "User Id not found");
                    }
                    return false;
                }
            }

            $('#Usrdata').DataTable({
                language: {
                    search: '',
                    searchPlaceholder: "Search by Name, Email, Id"
                },
                pageLength: 50, // Sets the default to 50 rows
                columnDefs: [
                    { "targets": [7], "orderable": false },
                    { "targets": [5], "orderable": false },
                    { "targets": [4], "orderable": true }
                ],
                fixedColumns: true,
                layout: {
                    topEnd: 'search',
                    topStart: {
                        div: {
                            className: 'action-btn-div'
                        }
                    }
                },
                initComplete: function () {
                    // Use initComplete to insert the actual hyperlink after the table is initialized
                    $('.action-btn-div').wrapInner('@Html.ActionLink("Create New", "Create", 0, new { @class = "btn-add" })');
                }
            });
        });
    </script>
}
