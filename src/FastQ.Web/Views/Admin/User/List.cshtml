@model IEnumerable<FastQ.Web.Models.Admin.UserVM>

@{
    ViewBag.Title = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head{
    <link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.min.css" rel="stylesheet" />
    <link href="~/Content/datatablesFQ.css" rel="stylesheet" />
    <link href="~/Content/queueadmin.css" rel="stylesheet" />
}

@section PageHeader {
    <div>
        <div class="topbar-title">Manage User Accounts</div>
        <div class="topbar-sub">Add, Edit and Remove users</div>
    </div>
}

@{ //Handle messages from DELETE action
    if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @ViewBag.ErrorMessage
        </div>
    }

    if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
    {
        <div class="alert alert-success">
            <strong>Success:</strong> @ViewBag.SuccessMessage
        </div>
    }
}
<div class="card">
    <table id="Udata" class="table" style="font-size:0.95em">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.UserId)</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                @*<th>@Html.DisplayNameFor(model => model.Title)</th>*@
                <th>Super Admin?</th>
                <th>Active?</th>
                <th>Other Lang?</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.UserId)
                    </td>

                    <td>
                        @Html.DisplayFor(modelItem => item.FirstName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                    <td class="text-center">
                        <span class="@(item.IsAdmin ? "status-dot" : "inactive-dot")"></span>
                        <span class="is-hidden">@item.IsAdmin</span>
                    </td>
                    <td class="text-center">
                        <span class="@(item.IsActive ? "status-dot" : "inactive-dot")"></span>
                        <span class="is-hidden">@item.IsActive</span>
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.OtherLanguage)
                    </td>
                    <td class="table-actions">
                        <a href="@Url.Action("Edit", "User", new { id = item.UserId })" class="btn small ghost btn-action-edit">
                            <i class="bi bi-pencil "></i> Edit
                        </a>
                        <a href="#" class="btn small ghost btn-action-delete"
                           onclick="return confirmAndpostdelete('@item.UserId');">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>
@section Scripts{
    <script src="https://cdn.datatables.net/2.3.7/js/dataTables.min.js"></script>
    <script>
        $(document).ready(function () {

            confirmAndpostdelete = (uid) => {
                {
                    var flag = confirm('You are about to delete user ' + uid + ' permanently. Are you sure you want to delete this record ? ');

                    if (flag) {
                        $.ajax({
                            url: '@Url.Action("DeleteConfirmed", "User")',
                            type: 'POST',
                            data: { uid: uid },
                            dataType: 'json',
                            //success: function (result) { alert(result); location.reload(); },
                            success: function (response) {                                
                                if (response.response === "success") {
                                    //alert("Deletion successful!");
                                    //window.location.reload(); 
                                } else {
                                    alert("Deletion failed: " + response.message);
                                }
                            },
                            error: function () { alert('Error! ' + result); }
                        });
                    }
                    return false;
                }
            }


            $('#Udata').DataTable({
                language: {
                    search: '',
                    searchPlaceholder: "Search by Name, Email, Id"
                },
                pageLength: 50, // Sets the default to 50 rows
                columnDefs: [
                    { "targets": [7], "orderable": false },
                    { "targets": [5], "orderable": false },
                    { "targets": [4], "orderable": false }
                ],
                fixedColumns: true,
                layout: {
                    topEnd: 'search',
                    topStart: {
                        div: {
                            className: 'action-btn-div'
                        }
                    }
                },
                initComplete: function () {
                    // Use initComplete to insert the actual hyperlink after the table is initialized
                    $('.action-btn-div').wrapInner('@Html.ActionLink("Create New", "Create", 0, new { @class = "btn-add" })');
                }
            });
        });
    </script>
}