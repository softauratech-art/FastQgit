
@model FastQ.Web.Models.Admin.UserVM
@{
    ViewBag.Title = "User Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head{
    <link href="~/Content/siteadmin.css" rel="stylesheet" />
}
@section PageHeader {
    <div>
        <div class="topbar-title">Manage User Accounts</div>
        <div class="topbar-sub">Edit user information and permissions</div>
    </div>
}

@{
    if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @ViewBag.ErrorMessage
        </div>
    }

    if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
    {
        <div class="alert alert-success">
            <strong>Success:</strong> @ViewBag.SuccessMessage
        </div>
    }
}

@if (ViewContext.RouteData.Values["action"].ToString().ToLower().Equals("edit")
    || ViewContext.RouteData.Values["action"].ToString().ToLower().Equals("create")
)
{
    using (Html.BeginForm(ViewContext.RouteData.Values["action"].ToString(), "User", FormMethod.Post))
    {
        @Html.AntiForgeryToken();
        <section class="card">
            <div class="configuration-header">
                <h2>User Settings</h2>
                <div class="primary-actions">
                    <input type="button" value="Back to List" class="btn-cancel" onclick="window.location.href='@Url.Action("Index", "User")'" />
                    <input type="submit" value="Save Settings" class="btn-save" />
                </div>
            </div>

            <input type="hidden" name="entityId" id="entityId" value="@(new FastQ.Web.Services.AuthService().GetSessionEntityId())" />

            <div class="grid-2">
                <div class="card">
                    <div class="card-body">
                        <div class="grid-2">
                            <div class="form-group mt-2">
                                @Html.LabelFor(model => model.UserId)
                                @Html.TextBoxFor(m => m.UserId, new { @required = "true" })
                            </div>
                            <div class="form-group mt-2">
                                <label for="Title">Title</label>
                                @Html.TextBoxFor(m => m.Title)
                            </div>
                        </div>
                        <div class="grid-2 mt-2">
                            <div class="form-group ">
                                <label for="FirstName">First Name</label>
                                @Html.TextBoxFor(m => m.FirstName, new { @required = "true" })
                            </div>
                            <div class="form-group ">
                                <label for="LastName">Last Name</label>
                                @Html.TextBoxFor(m => m.LastName, new { @required = "true" })
                            </div>
                        </div>
                        <div class="grid-2 mt-2">
                            <div class="form-group">
                                <label for="Email">Email</label>
                                @Html.TextBoxFor(m => m.Email, new { @required = "true" })
                            </div>
                            <div class="form-group">
                                <label for="Phone">Phone</label>
                                @Html.TextBoxFor(m => m.Phone)
                            </div>
                        </div>

                        <div class="grid-2">
                            <div>
                                <div class="form-group mt-2">
                                    <div class="switch-group" style="border-bottom: none;">
                                        @Html.LabelFor(model => model.IsActive, new { @class = "switch-label" })
                                        <label class="switch">
                                            <input type="checkbox" value="true" name="IsActive" id="IsActive" @(Model.IsActive ? "checked" : "") />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                    <div class="switch-group">
                                        <div>
                                            @Html.Label("IsAdmin", "Super Admin?", new { @class = "switch-label" })
                                            <span style="font-size:10px; display:block;">(Configure Queues, Users and Holidays + ServiceProvider for site)</span>
                                        </div>
                                        <label class="switch">
                                            <input type="checkbox" value="true" name="IsAdmin" id="IsAdmin" @(Model.IsAdmin ? "checked" : "") />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="form-group mt-2">
                                    <div class="switch-group" style="border-bottom: none;">
                                        <label class="switch-label">Spanish</label>
                                        <label class="switch">
                                            <input type="checkbox" value="ES" name="Language" id="OtherLanguageES" @(Model.OtherLanguage != null && Model.OtherLanguage.Contains("ES") ? "checked" : "") />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                    <div class="switch-group" style="border-bottom:">
                                        <label class="switch-label">Creole</label>
                                        <label class="switch">
                                            <input type="checkbox" value="CP" name="Language" id="OtherLanguageCP" @(Model.OtherLanguage != null && Model.OtherLanguage.Contains("CP") ? "checked" : "") />
                                            <span class="slider"></span>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card">
					<div class="alert alert-info">Note: QueueAdmin access will also include Provider-access to the selected queue(s).</div>
                    <table class="table table-striped">
                        <thead style="font-weight:bold; border-bottom: solid 1px #ccc">
                            <tr>
                                <th>Queue</th>
                                <th><input type="checkbox" id="host-checkall" onclick="selectAll(this,'host-role');" style="display:inline" />&nbsp;Host? <i class="bi bi-info-circle help-icon" data-title="HOST can Checkin, Transfer, Cancel -- Cannot Start/End service."></i></th>
                                <th><input type="checkbox" id="provider-checkall" onclick="selectAll(this,'provider-role');" style="display: inline" />&nbsp;Provider? <i class="bi bi-info-circle help-icon" data-title="PROVIDER can Checkin, Transfer, Cancel, Start, End service."></i></th>
                                <th> <input type="checkbox" id="reporter-checkall" onclick="selectAll(this,'reporter-role');" style="display: inline" />&nbsp;Reporter?</th>
                                <th><input type="checkbox" id="queueadmin-checkall" onclick="selectAll(this,'queueadmin-role');" style="display: inline" />&nbsp;Queue Admin? <i class="bi bi-info-circle help-icon" data-title="Configure + Provider"></i></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var qlist = new FastQ.Web.Services.QueueService().ListQueues().Where(e => e.EntityId == new FastQ.Web.Services.AuthService().GetSessionEntityId()).OrderBy(q => q.Name);
                                foreach (FastQ.Web.Models.Admin.QueueVM q in qlist)
                                {

                                    var isHost = Model.Permissions != null && Model.Permissions.Any(p => p.QueueId == q.Id) ? Model.Permissions.FirstOrDefault(p => p.QueueId == q.Id).HostFlag : false;
                                    var isProvider = Model.Permissions != null && Model.Permissions.Any(p => p.QueueId == q.Id) ? Model.Permissions.FirstOrDefault(p => p.QueueId == q.Id).ProviderFlag : false;
                                    var isReporter = Model.Permissions != null && Model.Permissions.Any(p => p.QueueId == q.Id) ? Model.Permissions.FirstOrDefault(p => p.QueueId == q.Id).ReporterFlag : false;
                                    var isQueueAdmin = Model.Permissions != null && Model.Permissions.Any(p => p.QueueId == q.Id) ? Model.Permissions.FirstOrDefault(p => p.QueueId == q.Id).QueueAdminFlag : false;
                                    <tr>
                                        <td>@q.Name <span class="text-danger">@(q.ActiveFlag==false ? "Inactive": "")</span></td>
                                        <td><input type="checkbox" name="host" value="@q.Id" class="host-role" @(isHost ? "checked" : "") @(q.ActiveFlag == false ? "disabled" : "")/></td>
                                        <td><input type="checkbox" name="provider" value="@q.Id" class="provider-role" @(isProvider ? "checked" : "") @(q.ActiveFlag == false ? "disabled" : "")/></td>
                                        <td><input type="checkbox" name="reporter" value="@q.Id" class="reporter-role" @(isReporter ? "checked" : "") @(q.ActiveFlag == false ? "disabled" : "")/></td>
                                        <td><input type="checkbox" name="queueadmin" value="@q.Id" class="queueadmin-role" @(isQueueAdmin ? "checked" : "") @(q.ActiveFlag == false ? "disabled" : "")/></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    }
 }


@section Scripts {
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function selectAll(obj, classname) {
            $('.' + classname).prop('checked', obj.checked);
        }
    </script>
}
