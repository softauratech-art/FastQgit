@section Scripts {
    <script>
        (function () {
            var reopenOnError = @(Model.FeedbackIsError ? "true" : "false");
            var providerActionUrl = "@Url.Action("ProviderAction", "Provider")";
            var addAppointmentUrl = "@Url.Action("AddAppointment", "Provider")";
            var addWalkinUrl = "@Url.Action("AddWalkin", "Provider")";
            var transferUrl = "@Url.Action("TransferAppointment", "Provider")";
            var endServiceUrl = "@Url.Action("EndService", "Provider")";
            var saveServiceInfoUrl = "@Url.Action("SaveServiceInfo", "Provider")";
            var getTransferQueuesUrl = "@Url.Action("GetTransferQueues", "Provider")";
            var getTransferServicesUrl = "@Url.Action("GetTransferServices", "Provider")";
            var getQueueDetailsUrl = "@Url.Action("GetQueueDetails", "Calendar")";
            var getQueueOpenSlotsUrl = "@Url.Action("GetQueueOpenSlots", "Calendar")";
            var lookupCustomerByEmailUrl = "@Url.Action("LookupCustomerByEmail", "Calendar")";
            var validatePermitUrl = "@Url.Action("ValidatePermit", "Provider")";
            var validateReferenceUrl = "@Url.Action("ValidateReference", "Calendar")";
            var validateCustomerTimeUrl = "@Url.Action("ValidateCustomerTimeSelection", "Calendar")";
            var serviceAccess = @Html.Raw(JsonConvert.SerializeObject(serviceAccess));
            var selectedCalendarDate = "@modalDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)";
            var currentMonth = new Date(@Model.DisplayMonth.Year, @Model.DisplayMonth.Month - 1, 1);
            var selectedDay = @Model.SelectedDate.Day;
            var activeRouteQueueDetails = null;
            var activeEntryQueueDetails = {
                addAppt: null,
                addWalkin: null
            };
            var permitValidationState = {
                addAppt: { seq: 0, pending: false, valid: false, message: "" },
                addWalkin: { seq: 0, pending: false, valid: false, message: "" }
            };
            var timeSelectionState = {
                addAppt: { seq: 0, pending: false, valid: true, message: "" },
                routeTarget: { seq: 0, pending: false, valid: true, message: "" }
            };
            var permitValidationTimers = {};
            var customerLookupTimers = {};
            var customerLookupRequestSeq = {};
            var entryCalendarState = {
                addAppt: {
                    monthStart: null,
                    enabledDates: {},
                    loadedMonths: {},
                    requestToken: 0
                },
                routeTarget: {
                    monthStart: null,
                    enabledDates: {},
                    loadedMonths: {},
                    requestToken: 0
                }
            };

            function openModal(id) {
                var modal = document.getElementById(id);
                if (!modal) {
                    return;
                }
                modal.classList.add("show");
                clearModalFeedback(id);
            }

            function closeModal(id) {
                var modal = document.getElementById(id);
                if (!modal) {
                    return;
                }
                modal.classList.remove("show");
                closeEntryDatePicker("addAppt");
                closeEntryDatePicker("routeTarget");
                clearModalFeedback(id);
            }

            function getModalFeedbackElement(id) {
                return document.querySelector('[data-modal-feedback="' + id + '"]');
            }

            function clearModalFeedback(id) {
                var el = getModalFeedbackElement(id);
                if (!el) {
                    return;
                }
                el.textContent = "";
                el.classList.remove("show");
                el.classList.remove("error");
                el.classList.remove("success");
            }

            function showModalFeedback(id, message, isError) {
                var el = getModalFeedbackElement(id);
                if (!el) {
                    return;
                }
                el.textContent = message || "";
                el.classList.add("show");
                el.classList.toggle("error", !!isError);
                el.classList.toggle("success", !isError);
            }

            function queueLiveSync() {
                window.location.reload();
            }

            function goToCalendar(monthDate, preferredDay) {
                if (!(monthDate instanceof Date)) {
                    return;
                }

                var safeMonth = new Date(monthDate.getFullYear(), monthDate.getMonth(), 1);
                var maxDay = new Date(safeMonth.getFullYear(), safeMonth.getMonth() + 1, 0).getDate();
                var clampedDay = Math.max(1, Math.min(preferredDay || 1, maxDay));
                var selectedDate = new Date(safeMonth.getFullYear(), safeMonth.getMonth(), clampedDay);
                var yyyy = String(safeMonth.getFullYear());
                var mm = String(safeMonth.getMonth() + 1).padStart(2, "0");
                var dd = String(clampedDay).padStart(2, "0");
                var url = new URL(window.location.href);
                url.searchParams.set("month", yyyy + "-" + mm + "-01");
                url.searchParams.set("selectedDate", yyyy + "-" + mm + "-" + dd);
                window.location.assign(url.toString());
            }

            function postForm(url, data) {
                return fetch(url, {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8" },
                    credentials: "same-origin",
                    body: new URLSearchParams(data).toString()
                }).then(function (r) {
                    return r.text().then(function (text) {
                        try {
                            var parsed = JSON.parse(text);
                            if (!r.ok && parsed && parsed.ok !== false) {
                                parsed.ok = false;
                            }
                            return parsed;
                        } catch (err) {
                            var fallbackMessage = "Request failed.";
                            if (r.status) {
                                fallbackMessage = "Request failed (" + r.status + " " + (r.statusText || "Error") + ").";
                            }
                            console.error("Calendar postForm JSON parse failed.", {
                                url: url,
                                status: r.status,
                                bodyPreview: (text || "").slice(0, 500),
                                error: err
                            });
                            return {
                                ok: false,
                                error: fallbackMessage
                            };
                        }
                    });
                }).catch(function (err) {
                    console.error("Calendar postForm request failed.", {
                        url: url,
                        error: err
                    });
                    return {
                        ok: false,
                        error: "Network error. Please try again."
                    };
                });
            }

            function getJson(url) {
                return fetch(url, {
                    method: "GET",
                    credentials: "same-origin"
                }).then(function (r) { return r.json(); });
            }

            function normalizeMeetingUrl(value) {
                var trimmed = (value || "").trim();
                if (!trimmed) {
                    return "";
                }

                if (trimmed.indexOf("//") === 0) {
                    return "https:" + trimmed;
                }

                if (trimmed.indexOf("://") >= 0) {
                    return trimmed;
                }

                return "https://" + trimmed.replace(/^\/+/, "");
            }

            function updateCalendarMeetingLinkUi(appointmentId, srcType, rawUrl, notes) {
                var normalizedSrcType = (srcType || "A").toUpperCase();
                var normalizedUrl = normalizeMeetingUrl(rawUrl);

                document.querySelectorAll('.meeting-link[data-appointment-id="' + appointmentId + '"][data-src-type="' + normalizedSrcType + '"]').forEach(function (link) {
                    link.setAttribute("data-meeting-url", rawUrl || "");
                    link.setAttribute("data-notes", notes || "");
                });

                document.querySelectorAll('.agenda-item[data-appointment-id="' + appointmentId + '"][data-src-type="' + normalizedSrcType + '"]').forEach(function (card) {
                    var linkRow = card.querySelector(".agenda-detail a");
                    var linkContainer = linkRow ? linkRow.parentElement : null;

                    if (!normalizedUrl) {
                        if (linkContainer) {
                            linkContainer.remove();
                        }
                    } else if (linkRow) {
                        linkRow.setAttribute("href", normalizedUrl);
                    } else {
                        var detail = document.createElement("div");
                        detail.className = "agenda-detail";
                        detail.innerHTML = '<a href="' + normalizedUrl.replace(/"/g, "&quot;") + '" target="_blank" rel="noopener">Open meeting link</a>';
                        var notesRow = card.querySelector(".agenda-notes");
                        if (notesRow) {
                            card.insertBefore(detail, notesRow);
                        } else {
                            card.appendChild(detail);
                        }
                    }

                    var notesRow = card.querySelector(".agenda-notes");
                    if (notesRow) {
                        notesRow.textContent = notes || "Use Info to add meeting details or notes.";
                    }
                });
            }

            function setSelectOptions(selectElement, items, placeholderText) {
                if (!selectElement) {
                    return;
                }

                selectElement.innerHTML = "";
                var placeholder = document.createElement("option");
                placeholder.value = "";
                placeholder.textContent = placeholderText;
                selectElement.appendChild(placeholder);

                (items || []).forEach(function (item) {
                    var option = document.createElement("option");
                    option.value = item.code || "";
                    option.textContent = item.name || item.code || "";
                    selectElement.appendChild(option);
                });
            }

            function to24Hour(value) {
                var match = /^\s*(\d{1,2})\:(\d{2})\s*([AaPp][Mm])\s*$/.exec(value || "");
                if (!match) {
                    return "00:00";
                }
                var hour = parseInt(match[1], 10) % 12;
                if (match[3].toUpperCase() === "PM") {
                    hour += 12;
                }
                return toTwoDigits(hour) + ":" + match[2];
            }

            function parseIsoDurationToMinutes(text) {
                var match = /^P(?:(\d+)D)?(?:T(?:(\d+)H)?(?:(\d+)M)?)?$/i.exec((text || "").trim());
                if (!match) {
                    return 0;
                }
                var days = parseInt(match[1] || "0", 10);
                var hours = parseInt(match[2] || "0", 10);
                var minutes = parseInt(match[3] || "0", 10);
                return (((days * 24) + hours) * 60) + minutes;
            }

            function getWeekdayCode(dateValue) {
                var day = dateValue.getDay();
                return day === 0 ? "7" : String(day);
            }

            function normalizeScheduleWindow(openMinutes, closeMinutes) {
                var dayMinutes = 24 * 60;
                if (openMinutes < 0 || closeMinutes < 0) {
                    return null;
                }
                if (closeMinutes <= openMinutes) {
                    closeMinutes += 12 * 60;
                }
                if (closeMinutes <= openMinutes) {
                    closeMinutes += 12 * 60;
                }
                if (closeMinutes > dayMinutes) {
                    closeMinutes = dayMinutes;
                }
                if (closeMinutes <= openMinutes) {
                    return null;
                }
                return { open: openMinutes, close: closeMinutes };
            }

            function parseDateOnly(value) {
                if (!value) {
                    return null;
                }
                var raw = value.toString().trim();
                if (!raw) {
                    return null;
                }

                var date = new Date(raw);
                if (!isNaN(date.getTime())) {
                    date.setHours(0, 0, 0, 0);
                    return date;
                }

                var iso = /^(\d{4})-(\d{2})-(\d{2})/.exec(raw);
                if (iso) {
                    date = new Date(parseInt(iso[1], 10), parseInt(iso[2], 10) - 1, parseInt(iso[3], 10));
                    date.setHours(0, 0, 0, 0);
                    return date;
                }

                var mdy = /^(\d{1,2})\/(\d{1,2})\/(\d{4})/.exec(raw);
                if (mdy) {
                    date = new Date(parseInt(mdy[3], 10), parseInt(mdy[1], 10) - 1, parseInt(mdy[2], 10));
                    date.setHours(0, 0, 0, 0);
                    return date;
                }

                return null;
            }

            function isScheduleActiveOnDate(schedule, dateValue) {
                if (!schedule || !dateValue) {
                    return false;
                }
                var day = new Date(dateValue.getTime());
                day.setHours(0, 0, 0, 0);
                var begin = parseDateOnly(schedule.dateBegin || "");
                var end = parseDateOnly(schedule.dateEnd || "");
                if (begin && day < begin) {
                    return false;
                }
                if (end && day > end) {
                    return false;
                }
                var weekly = (schedule.weeklySch || "").toString();
                if (!weekly) {
                    return true;
                }
                return weekly.indexOf(getWeekdayCode(dateValue)) >= 0;
            }

            function getMinimumFutureMinutes(dateValue) {
                if (!(dateValue instanceof Date)) {
                    return null;
                }

                var now = new Date();
                if (now.getFullYear() !== dateValue.getFullYear() ||
                    now.getMonth() !== dateValue.getMonth() ||
                    now.getDate() !== dateValue.getDate()) {
                    return null;
                }

                return (now.getHours() * 60) + now.getMinutes() + 1;
            }

            function setRouteReferenceOptions(items, selectedValue) {
                var refSelect = document.getElementById("routeRefValue");
                if (!refSelect) {
                    return;
                }
                setSelectOptions(refSelect, items || [], "Select reference");
                if (selectedValue) {
                    refSelect.value = selectedValue;
                }
            }

            function populateEntryModalOptions(prefix, details) {
                var serviceSelect = document.getElementById(prefix + "ServiceId");
                var contactSelect = document.getElementById(prefix + "ContactType");
                var refSelect = document.getElementById(prefix + "RefValue");

                setSelectOptions(serviceSelect, details && details.services ? details.services : [], "Select service");
                setSelectOptions(contactSelect, details && details.contactOptions ? details.contactOptions : [], "Select contact type");
                setSelectOptions(refSelect, details && details.refOptions ? details.refOptions : [], "Select reference");
                syncReferenceInputMeta(prefix);
            }

            function loadEntryQueueDetails(prefix, queueCode) {
                if (!queueCode) {
                    activeEntryQueueDetails[prefix] = null;
                    populateEntryModalOptions(prefix, null);
                    populateEntryModalDateTime(prefix, null);
                    return Promise.resolve();
                }

                return getJson(getQueueDetailsUrl + "?queueId=" + encodeURIComponent(queueCode))
                    .then(function (res) {
                        var details = res && res.ok ? res.data : null;
                        activeEntryQueueDetails[prefix] = details;
                        populateEntryModalOptions(prefix, details);
                        populateEntryModalDateTime(prefix, details);
                    })
                    .catch(function (err) {
                        console.error("Calendar add-entry queue details load failed.", {
                            prefix: prefix,
                            queueCode: queueCode,
                            url: getQueueDetailsUrl + "?queueId=" + encodeURIComponent(queueCode),
                            error: err
                        });
                        activeEntryQueueDetails[prefix] = null;
                        populateEntryModalOptions(prefix, null);
                        populateEntryModalDateTime(prefix, null);
                    });
            }

            function loadEntryQueues(prefix) {
                var queueSelect = document.getElementById(prefix + "QueueId");
                if (!queueSelect) {
                    return Promise.resolve();
                }

                return getJson(getTransferQueuesUrl)
                    .then(function (res) {
                        setSelectOptions(queueSelect, res && res.ok ? res.data : [], "Select queue");
                    })
                    .catch(function (err) {
                        console.error("Calendar add-entry queue list load failed.", {
                            prefix: prefix,
                            url: getTransferQueuesUrl,
                            error: err
                        });
                        setSelectOptions(queueSelect, [], "Select queue");
                    });
            }

            function loadRouteServices(queueCode, selectedServiceCode) {
                var serviceSelect = document.getElementById("routeTargetServiceId");
                if (!serviceSelect) {
                    return Promise.resolve();
                }

                if (!queueCode) {
                    activeRouteQueueDetails = null;
                    setSelectOptions(serviceSelect, [], "Select service");
                    setRouteReferenceOptions([], "");
                    resetEntryCalendarState("routeTarget");
                    setEntryDateValue("routeTarget", "", true);
                    setEntryDateStatus("routeTarget", "Select queue to load open-slot dates.", false);
                    populateRouteDateOptions("");
                    populateRouteTimeOptions("");
                    return Promise.resolve();
                }

                var serviceUrl = getTransferServicesUrl + "?queueId=" + encodeURIComponent(queueCode);
                var detailsUrl = getQueueDetailsUrl + "?queueId=" + encodeURIComponent(queueCode);
                return Promise.all([getJson(serviceUrl), getJson(detailsUrl)]).then(function (responses) {
                    var servicesRes = responses[0];
                    var detailsRes = responses[1];
                    if (!detailsRes || !detailsRes.ok) {
                        activeRouteQueueDetails = null;
                        setSelectOptions(serviceSelect, [], "Select service");
                        setRouteReferenceOptions([], "");
                        resetEntryCalendarState("routeTarget");
                        setEntryDateValue("routeTarget", "", true);
                        setEntryDateStatus("routeTarget", "Select queue to load open-slot dates.", false);
                        populateRouteDateOptions("");
                        populateRouteTimeOptions("");
                        return;
                    }

                    activeRouteQueueDetails = detailsRes.data || null;
                    setSelectOptions(serviceSelect, servicesRes && servicesRes.ok ? servicesRes.data : [], "Select service");
                    if (selectedServiceCode) {
                        serviceSelect.value = selectedServiceCode;
                    }
                    setRouteReferenceOptions((detailsRes.data && detailsRes.data.refOptions) || [], "");
                    resetEntryCalendarState("routeTarget");
                    setEntryDateValue("routeTarget", "", true);
                    setEntryDateStatus("routeTarget", "Select date to load available times.", false);
                    populateRouteDateOptions("");
                    populateRouteTimeOptions("");
                }).catch(function () {
                    activeRouteQueueDetails = null;
                    setSelectOptions(serviceSelect, [], "Select service");
                    setRouteReferenceOptions([], "");
                    resetEntryCalendarState("routeTarget");
                    setEntryDateValue("routeTarget", "", true);
                    setEntryDateStatus("routeTarget", "Select queue to load open-slot dates.", false);
                    populateRouteDateOptions("");
                    populateRouteTimeOptions("");
                });
            }

            function loadRouteQueues(selectedQueueCode, selectedServiceCode) {
                var queueSelect = document.getElementById("routeTargetQueueId");
                if (!queueSelect) {
                    return Promise.resolve();
                }

                return getJson(getTransferQueuesUrl).then(function (res) {
                    if (!res || !res.ok) {
                        setSelectOptions(queueSelect, [], "Select queue");
                        loadRouteServices("", "");
                        return;
                    }

                    setSelectOptions(queueSelect, res.data || [], "Select queue");
                    if (selectedQueueCode) {
                        queueSelect.value = selectedQueueCode;
                    }

                    return loadRouteServices(queueSelect.value, selectedServiceCode || "");
                }).catch(function () {
                    setSelectOptions(queueSelect, [], "Select queue");
                    return loadRouteServices("", "");
                });
            }

            function setSelectValues(selectElement, values, placeholder) {
                if (!selectElement) {
                    return;
                }

                selectElement.innerHTML = "";
                var placeholderOption = document.createElement("option");
                placeholderOption.value = "";
                placeholderOption.textContent = placeholder;
                selectElement.appendChild(placeholderOption);

                (values || []).forEach(function (item) {
                    var option = document.createElement("option");
                    option.value = item.value;
                    option.textContent = item.label;
                    option.disabled = !!item.disabled;
                    selectElement.appendChild(option);
                });
            }

            function formatRouteDateLabel(dateValue) {
                var labels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
                var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                return labels[dateValue.getDay()] + ", " + months[dateValue.getMonth()] + " " + dateValue.getDate() + ", " + dateValue.getFullYear();
            }

            function toTwoDigits(value) {
                return value < 10 ? "0" + value : String(value);
            }

            function toIsoDate(dateValue) {
                return dateValue.getFullYear() + "-" + toTwoDigits(dateValue.getMonth() + 1) + "-" + toTwoDigits(dateValue.getDate());
            }

            function getEntryDateWindowLimits() {
                var minDate = new Date();
                minDate.setHours(0, 0, 0, 0);
                var maxDate = new Date(minDate.getTime());
                maxDate.setMonth(maxDate.getMonth() + 6);
                return {
                    min: toIsoDate(minDate),
                    max: toIsoDate(maxDate)
                };
            }

            function parseClockMinutes(value) {
                var text = to24Hour(value);
                var parts = text.split(":");
                if (parts.length !== 2) {
                    return null;
                }

                var hour = parseInt(parts[0], 10);
                var minute = parseInt(parts[1], 10);
                if (isNaN(hour) || isNaN(minute)) {
                    return null;
                }

                return (hour * 60) + minute;
            }

            function getEntryCalendarBounds() {
                var limits = getEntryDateWindowLimits();
                return {
                    min: new Date(limits.min + "T00:00:00"),
                    max: new Date(limits.max + "T00:00:00")
                };
            }

            function startOfMonth(dateValue) {
                return new Date(dateValue.getFullYear(), dateValue.getMonth(), 1);
            }

            function addMonths(dateValue, count) {
                return new Date(dateValue.getFullYear(), dateValue.getMonth() + count, 1);
            }

            function getEntryCalendarMonthLabel(dateValue) {
                var months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                return months[dateValue.getMonth()] + " " + dateValue.getFullYear();
            }

            function getEntryCalendarMonthKey(dateValue) {
                return dateValue.getFullYear() + "-" + toTwoDigits(dateValue.getMonth() + 1);
            }

            function getEntryCalendarState(prefix) {
                if (!entryCalendarState[prefix]) {
                    entryCalendarState[prefix] = {
                        monthStart: null,
                        enabledDates: {},
                        loadedMonths: {},
                        requestToken: 0
                    };
                }
                return entryCalendarState[prefix];
            }

            function resetEntryCalendarState(prefix) {
                entryCalendarState[prefix] = {
                    monthStart: null,
                    enabledDates: {},
                    loadedMonths: {},
                    requestToken: 0
                };
            }

            function setEntryDateStatus(prefix, message, isError) {
                var status = document.getElementById(prefix + "DateStatus");
                if (!status) {
                    return;
                }
                status.textContent = message || "";
                status.style.color = isError ? "#b91c1c" : "#5b5b5b";
            }

            function formatEntryDateDisplay(value) {
                if (!value) {
                    return "";
                }

                var parts = value.split("-");
                if (parts.length !== 3) {
                    return value;
                }

                return parts[2] + "/" + parts[1] + "/" + parts[0];
            }

            function parseEntryDateDisplay(value) {
                var match = /^\s*(\d{1,2})\/(\d{1,2})\/(\d{4})\s*$/.exec(value || "");
                if (!match) {
                    return "";
                }

                var day = parseInt(match[1], 10);
                var month = parseInt(match[2], 10);
                var year = parseInt(match[3], 10);
                var candidate = new Date(year, month - 1, day);
                if (candidate.getFullYear() !== year || candidate.getMonth() !== month - 1 || candidate.getDate() !== day) {
                    return "";
                }

                return toIsoDate(candidate);
            }

            function setEntryDateDisplay(prefix, value) {
                var displayInput = document.getElementById(prefix + "DateDisplay");
                if (!displayInput) {
                    return;
                }

                displayInput.value = formatEntryDateDisplay(value);
            }

            function openEntryDatePicker(prefix) {
                var picker = document.getElementById(prefix + "DatePicker");
                var displayInput = document.getElementById(prefix + "DateDisplay");
                if (!picker) {
                    return;
                }

                picker.classList.add("is-open");
                if (displayInput) {
                    displayInput.setAttribute("aria-expanded", "true");
                }
            }

            function closeEntryDatePicker(prefix) {
                var picker = document.getElementById(prefix + "DatePicker");
                var displayInput = document.getElementById(prefix + "DateDisplay");
                if (!picker) {
                    return;
                }

                picker.classList.remove("is-open");
                if (displayInput) {
                    displayInput.setAttribute("aria-expanded", "false");
                }
            }

            function setEntryDateValue(prefix, selectedDate, suppressChange) {
                var input = document.getElementById(prefix + "Date");
                if (!input) {
                    return;
                }

                var currentValue = input.value || "";
                input.value = selectedDate || "";
                input.setAttribute("data-current-value", selectedDate || "");
                setEntryDateDisplay(prefix, selectedDate || "");
                renderEntryCalendar(prefix);

                if (!suppressChange && currentValue !== (selectedDate || "")) {
                    closeEntryDatePicker(prefix);
                    input.dispatchEvent(new Event("change", { bubbles: true }));
                }
            }

            function handleEntryDateDisplayInput(prefix) {
                var displayInput = document.getElementById(prefix + "DateDisplay");
                if (!displayInput) {
                    return;
                }

                var parsedDate = parseEntryDateDisplay(displayInput.value || "");
                if (!parsedDate) {
                    return;
                }

                var state = getEntryCalendarState(prefix);
                state.monthStart = startOfMonth(new Date(parsedDate + "T00:00:00"));
                renderEntryCalendar(prefix);
            }

            function handleEntryDateDisplayCommit(prefix) {
                var displayInput = document.getElementById(prefix + "DateDisplay");
                var timeSelect = document.getElementById(prefix + "Time");
                if (!displayInput) {
                    return;
                }

                var rawValue = (displayInput.value || "").trim();
                if (!rawValue) {
                    setEntryDateValue(prefix, "", true);
                    if (timeSelect) {
                        setSelectValues(timeSelect, [], "Select time");
                    }
                    setTimeSelectionState(prefix, false, false, "Date is required.");
                    setEntryDateStatus(prefix, "Date is required.", true);
                    return;
                }

                var parsedDate = parseEntryDateDisplay(rawValue);
                if (!parsedDate) {
                    setEntryDateValue(prefix, "", true);
                    if (timeSelect) {
                        setSelectValues(timeSelect, [], "Select time");
                    }
                    setTimeSelectionState(prefix, false, false, "Enter date as dd/mm/yyyy.");
                    setEntryDateStatus(prefix, "Enter date as dd/mm/yyyy.", true);
                    return;
                }

                var state = getEntryCalendarState(prefix);
                if (state.enabledDates[parsedDate] !== true) {
                    state.monthStart = startOfMonth(new Date(parsedDate + "T00:00:00"));
                    renderEntryCalendar(prefix);
                    setEntryDateValue(prefix, "", true);
                    if (timeSelect) {
                        setSelectValues(timeSelect, [], "Select time");
                    }
                    setTimeSelectionState(prefix, false, false, "Selected date is not available.");
                    setEntryDateStatus(prefix, "Selected date is not available.", true);
                    return;
                }

                setEntryDateStatus(prefix, "", false);
                setEntryDateValue(prefix, parsedDate, false);
            }

            function renderEntryCalendar(prefix) {
                var state = getEntryCalendarState(prefix);
                var calendar = document.getElementById(prefix + "DateCalendar");
                var monthLabel = document.getElementById(prefix + "DateMonthLabel");
                var prevButton = document.getElementById(prefix + "DatePrev");
                var nextButton = document.getElementById(prefix + "DateNext");
                var input = document.getElementById(prefix + "Date");
                if (!calendar || !monthLabel || !input) {
                    return;
                }

                var bounds = getEntryCalendarBounds();
                var monthStart = state.monthStart || startOfMonth(bounds.min);
                state.monthStart = monthStart;
                monthLabel.textContent = getEntryCalendarMonthLabel(monthStart);

                if (prevButton) {
                    prevButton.disabled = monthStart <= startOfMonth(bounds.min);
                }
                if (nextButton) {
                    nextButton.disabled = monthStart >= startOfMonth(bounds.max);
                }

                calendar.innerHTML = "";
                var firstWeekday = monthStart.getDay();
                for (var blankIndex = 0; blankIndex < firstWeekday; blankIndex++) {
                    var blankCell = document.createElement("span");
                    blankCell.className = "entry-date-cell is-muted";
                    blankCell.setAttribute("aria-hidden", "true");
                    calendar.appendChild(blankCell);
                }

                var monthKey = getEntryCalendarMonthKey(monthStart);
                var monthLoaded = !!state.loadedMonths[monthKey];
                var selectedDate = input.value || "";
                var todayIso = toIsoDate(new Date());
                var daysInMonth = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0).getDate();

                for (var day = 1; day <= daysInMonth; day++) {
                    var dateValue = new Date(monthStart.getFullYear(), monthStart.getMonth(), day);
                    var isoDate = toIsoDate(dateValue);
                    var isInRange = dateValue >= bounds.min && dateValue <= bounds.max;
                    var isEnabled = isInRange && state.enabledDates[isoDate] === true;
                    var button = document.createElement("button");
                    button.type = "button";
                    button.className = "entry-date-cell";
                    button.textContent = String(day);
                    button.disabled = !isEnabled;
                    if (isoDate === selectedDate) {
                        button.classList.add("is-selected");
                    }
                    if (isoDate === todayIso) {
                        button.classList.add("is-today");
                    }
                    if (isEnabled) {
                        button.addEventListener("click", (function (value) {
                            return function () {
                                setEntryDateStatus(prefix, "", false);
                                setEntryDateValue(prefix, value, false);
                            };
                        })(isoDate));
                    }
                    calendar.appendChild(button);
                }

                if (!monthLoaded) {
                    setEntryDateStatus(prefix, "Loading open-slot dates...", false);
                }
            }

            function monthHasSelectableSlots(prefix, monthStart) {
                var state = getEntryCalendarState(prefix);
                var monthEnd = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0);
                for (var day = 1; day <= monthEnd.getDate(); day++) {
                    var isoDate = toIsoDate(new Date(monthStart.getFullYear(), monthStart.getMonth(), day));
                    if (state.enabledDates[isoDate] === true) {
                        return true;
                    }
                }
                return false;
            }

            function getFirstEnabledDateInMonth(prefix, monthStart) {
                var state = getEntryCalendarState(prefix);
                var monthEnd = new Date(monthStart.getFullYear(), monthStart.getMonth() + 1, 0);
                for (var day = 1; day <= monthEnd.getDate(); day++) {
                    var isoDate = toIsoDate(new Date(monthStart.getFullYear(), monthStart.getMonth(), day));
                    if (state.enabledDates[isoDate] === true) {
                        return isoDate;
                    }
                }
                return "";
            }

            function hasSelectableSlotForDate(dateIso, slots) {
                var minimumFutureMinutes = getMinimumFutureMinutes(new Date(dateIso + "T00:00:00"));
                return (slots || []).some(function (slot) {
                    var slotValue = slot.slotBegin || "";
                    var totalMinutes = parseClockMinutes(slotValue);
                    return totalMinutes !== null && (minimumFutureMinutes === null || totalMinutes >= minimumFutureMinutes);
                });
            }

            function loadEntryCalendarMonth(prefix, monthStart, preferredDateValue) {
                var queueSelect = document.getElementById(prefix + "QueueId");
                var queueId = queueSelect ? (queueSelect.value || "") : "";
                var input = document.getElementById(prefix + "Date");
                var state = getEntryCalendarState(prefix);
                if (!queueId) {
                    resetEntryCalendarState(prefix);
                    if (input) {
                        input.value = "";
                        input.setAttribute("data-current-value", "");
                    }
                    renderEntryCalendar(prefix);
                    return Promise.resolve();
                }

                state.monthStart = startOfMonth(monthStart);
                renderEntryCalendar(prefix);

                var requestToken = ++state.requestToken;
                var bounds = getEntryCalendarBounds();
                var lastDay = new Date(state.monthStart.getFullYear(), state.monthStart.getMonth() + 1, 0);
                var requests = [];

                for (var day = 1; day <= lastDay.getDate(); day++) {
                    var dateValue = new Date(state.monthStart.getFullYear(), state.monthStart.getMonth(), day);
                    if (dateValue < bounds.min || dateValue > bounds.max) {
                        continue;
                    }

                    var isoDate = toIsoDate(dateValue);
                    requests.push((function (requestedDate) {
                        return getJson(getQueueOpenSlotsUrl + "?queueId=" + encodeURIComponent(queueId) + "&theDate=" + encodeURIComponent(requestedDate))
                            .then(function (res) {
                                return {
                                    date: requestedDate,
                                    enabled: !!(res && res.ok && hasSelectableSlotForDate(requestedDate, res.data || []))
                                };
                            })
                            .catch(function () {
                                return { date: requestedDate, enabled: false };
                            });
                    })(isoDate));
                }

                return Promise.all(requests).then(function (results) {
                    if (state.requestToken !== requestToken) {
                        return;
                    }

                    results.forEach(function (item) {
                        state.enabledDates[item.date] = item.enabled;
                    });
                    state.loadedMonths[getEntryCalendarMonthKey(state.monthStart)] = true;
                    renderEntryCalendar(prefix);

                    var activeInput = document.getElementById(prefix + "Date");
                    var selectedDate = activeInput ? (activeInput.value || "") : "";
                    var resolvedPreferredDate = preferredDateValue || selectedDate || "";
                    if (resolvedPreferredDate && state.enabledDates[resolvedPreferredDate] === true) {
                        setEntryDateStatus(prefix, "", false);
                        setEntryDateValue(prefix, resolvedPreferredDate, true);
                    } else if (!selectedDate || state.enabledDates[selectedDate] !== true) {
                        var firstEnabledDate = getFirstEnabledDateInMonth(prefix, state.monthStart);
                        if (firstEnabledDate) {
                            setEntryDateStatus(prefix, "", false);
                            setEntryDateValue(prefix, firstEnabledDate, false);
                            return;
                        }
                    }

                    if (!monthHasSelectableSlots(prefix, state.monthStart)) {
                        setEntryDateValue(prefix, "", true);
                        setSelectValues(document.getElementById(prefix + "Time"), [], "Select time");
                        setTimeSelectionState(prefix, false, false, "No open slots are available for this month.");
                        setEntryDateStatus(prefix, "No open-slot dates are available in this month.", true);
                    } else {
                        setEntryDateStatus(prefix, "Only dates with open slots are selectable.", false);
                    }
                });
            }

            function getScheduleTimeOptions(details, selectedDateValue) {
                if (!selectedDateValue) {
                    return [];
                }

                var dateValue = new Date(selectedDateValue + "T00:00:00");
                var schedules = details && details.schedules ? details.schedules : [];
                var options = [];
                var seen = {};
                var minimumFutureMinutes = getMinimumFutureMinutes(dateValue);

                schedules.forEach(function (schedule) {
                    if (!isScheduleActiveOnDate(schedule, dateValue)) {
                        return;
                    }

                    var openMinutes = parseIsoDurationToMinutes(schedule.openTime);
                    var closeMinutes = parseIsoDurationToMinutes(schedule.closeTime);
                    var intervalMinutes = parseIsoDurationToMinutes(schedule.intervalTime) || 30;
                    var window = normalizeScheduleWindow(openMinutes, closeMinutes);
                    if (!window) {
                        return;
                    }

                    for (var minutes = window.open; minutes < window.close; minutes += intervalMinutes) {
                        if (minimumFutureMinutes !== null && minutes < minimumFutureMinutes) {
                            continue;
                        }
                        var hh = toTwoDigits(Math.floor(minutes / 60) % 24);
                        var mm = toTwoDigits(minutes % 60);
                        var value = hh + ":" + mm;
                        if (seen[value]) {
                            continue;
                        }
                        seen[value] = true;
                        options.push({
                            value: value,
                            label: value
                        });
                    }
                });

                options.sort(function (a, b) { return a.value.localeCompare(b.value); });
                return options;
            }

            function populateEntryModalDateTime(prefix, details) {
                var dateSelect = document.getElementById(prefix + "Date");
                var timeSelect = document.getElementById(prefix + "Time");
                if (!dateSelect || !timeSelect) {
                    return Promise.resolve();
                }
                if (prefix !== "addAppt") {
                    return Promise.resolve();
                }

                var preferredDateValue = dateSelect.getAttribute("data-current-value") || dateSelect.value || selectedCalendarDate || "";
                var state = getEntryCalendarState(prefix);
                if (!state.monthStart) {
                    var initialDate = preferredDateValue ? new Date(preferredDateValue + "T00:00:00") : new Date();
                    state.monthStart = startOfMonth(initialDate);
                }

                if (!details) {
                    setEntryDateValue(prefix, "", true);
                    setSelectValues(timeSelect, [], "Select time");
                    setEntryDateStatus(prefix, "Select queue to load open-slot dates.", false);
                    renderEntryCalendar(prefix);
                    return Promise.resolve();
                }

                return loadEntryCalendarMonth(prefix, state.monthStart, preferredDateValue);
            }

            function populateEntryModalTimeOptions(prefix, details, selectedDateValue) {
                var timeSelect = document.getElementById(prefix + "Time");
                if (!timeSelect) {
                    return Promise.resolve();
                }
                var queueSelect = document.getElementById(prefix + "QueueId");
                var queueId = queueSelect ? (queueSelect.value || "") : "";
                if (!queueId || !selectedDateValue) {
                    setSelectValues(timeSelect, [], "Select time");
                    return Promise.resolve();
                }

                return getJson(getQueueOpenSlotsUrl + "?queueId=" + encodeURIComponent(queueId) + "&theDate=" + encodeURIComponent(selectedDateValue))
                    .then(function (res) {
                        var selectedDateValueObj = new Date(selectedDateValue + "T00:00:00");
                        var minimumFutureMinutes = getMinimumFutureMinutes(selectedDateValueObj);
                        var timeOptions = res && res.ok
                            ? (res.data || []).map(function (slot) {
                                var slotValue = slot.slotBegin || "";
                                var totalMinutes = parseClockMinutes(slotValue);
                                var isPast = minimumFutureMinutes !== null && totalMinutes !== null && totalMinutes < minimumFutureMinutes;
                                return isPast ? null : { value: slotValue, label: slotValue };
                            }).filter(function (slot) {
                                return !!slot;
                            }).sort(function (a, b) {
                                return (parseClockMinutes(a.value) || 0) - (parseClockMinutes(b.value) || 0);
                            })
                            : [];
                        setSelectValues(timeSelect, timeOptions, "Select time");
                        if (timeOptions.length > 0) {
                            timeSelect.value = timeOptions[0].value;
                        }
                        if (prefix === "routeTarget") {
                            clearModalFeedback("serviceRouteModal");
                        }
                        return validateCustomerTimeSelection(prefix);
                    })
                    .catch(function (err) {
                        console.error("Calendar add-entry time slot load failed.", {
                            prefix: prefix,
                            queueId: queueId,
                            selectedDate: selectedDateValue,
                            url: getQueueOpenSlotsUrl + "?queueId=" + encodeURIComponent(queueId) + "&theDate=" + encodeURIComponent(selectedDateValue),
                            error: err
                        });
                        setSelectValues(timeSelect, [], "Select time");
                        setTimeSelectionState(prefix, false, false, "Could not load available time slots.");
                        showModalFeedback(prefix === "routeTarget" ? "serviceRouteModal" : "addAppointmentModal", "Could not load available time slots.", true);
                    });
            }

            function refreshEntryModalTimeOptions(prefix) {
                var queueSelect = document.getElementById(prefix + "QueueId");
                var dateSelect = document.getElementById(prefix + "Date");
                var timeSelect = document.getElementById(prefix + "Time");
                if (!dateSelect || !timeSelect) {
                    return Promise.resolve();
                }
                var queueId = queueSelect ? (queueSelect.value || "") : "";
                var selectedDate = dateSelect.value || "";
                dateSelect.setAttribute("data-current-value", selectedDate);
                if (!queueId || !selectedDate) {
                    setSelectValues(timeSelect, [], "Select time");
                    return Promise.resolve();
                }
                if (prefix === "addAppt" || prefix === "routeTarget") {
                    var state = getEntryCalendarState(prefix);
                    if (state.enabledDates[selectedDate] !== true) {
                        setSelectValues(timeSelect, [], "Select time");
                        setTimeSelectionState(prefix, false, false, "Selected date is not available.");
                        showModalFeedback(prefix === "routeTarget" ? "serviceRouteModal" : "addAppointmentModal", "Selected date is not available.", true);
                        return Promise.resolve();
                    }
                }
                return populateEntryModalTimeOptions(prefix, activeEntryQueueDetails[prefix], selectedDate);
            }

            function setTimeSelectionState(prefix, pending, valid, message) {
                timeSelectionState[prefix] = timeSelectionState[prefix] || { seq: 0, pending: false, valid: true, message: "" };
                timeSelectionState[prefix].pending = !!pending;
                timeSelectionState[prefix].valid = !!valid;
                timeSelectionState[prefix].message = message || "";
            }

            function validateCustomerTimeSelection(prefix) {
                if (prefix !== "addAppt") {
                    return Promise.resolve(true);
                }

                var email = document.getElementById(prefix + "Email");
                var phone = document.getElementById(prefix + "Phone");
                var date = document.getElementById(prefix + "Date");
                var time = document.getElementById(prefix + "Time");
                var emailValue = email ? (email.value || "").trim() : "";
                var phoneValue = phone ? (phone.value || "").trim() : "";
                var dateValue = date ? (date.value || "").trim() : "";
                var timeValue = time ? (time.value || "").trim() : "";
                if (!dateValue || !timeValue || (!emailValue && !phoneValue)) {
                    setTimeSelectionState(prefix, false, true, "");
                    clearModalFeedback("addAppointmentModal");
                    return Promise.resolve(true);
                }

                timeSelectionState[prefix] = timeSelectionState[prefix] || { seq: 0, pending: false, valid: true, message: "" };
                timeSelectionState[prefix].seq += 1;
                var requestSeq = timeSelectionState[prefix].seq;
                setTimeSelectionState(prefix, true, false, "Checking customer availability...");
                return getJson(validateCustomerTimeUrl
                    + "?email=" + encodeURIComponent(emailValue)
                    + "&phone=" + encodeURIComponent(phoneValue)
                    + "&appointmentDate=" + encodeURIComponent(dateValue)
                    + "&startTime=" + encodeURIComponent(timeValue))
                    .then(function (res) {
                        if (!timeSelectionState[prefix] || timeSelectionState[prefix].seq !== requestSeq) {
                            return false;
                        }
                        if (res && res.ok) {
                            setTimeSelectionState(prefix, false, true, "");
                            clearModalFeedback("addAppointmentModal");
                            return true;
                        }
                        var message = res && res.error ? res.error : "Customer already has an appointment at this time.";
                        setTimeSelectionState(prefix, false, false, message);
                        showModalFeedback("addAppointmentModal", message, true);
                        return false;
                    })
                    .catch(function (err) {
                        console.error("Calendar add-entry customer time validation failed.", {
                            prefix: prefix,
                            dateValue: dateValue,
                            timeValue: timeValue,
                            error: err
                        });
                        if (!timeSelectionState[prefix] || timeSelectionState[prefix].seq !== requestSeq) {
                            return false;
                        }
                        setTimeSelectionState(prefix, false, false, "Could not validate customer availability.");
                        showModalFeedback("addAppointmentModal", "Could not validate customer availability.", true);
                        return false;
                    });
            }

            function populateRouteDateOptions(selectedDateValue) {
                var dateInput = document.getElementById("routeTargetDate");
                if (!dateInput) {
                    return Promise.resolve();
                }

                var preferredDateValue = selectedDateValue || dateInput.getAttribute("data-current-value") || dateInput.value || "";
                var state = getEntryCalendarState("routeTarget");
                if (!state.monthStart) {
                    var initialDate = preferredDateValue ? new Date(preferredDateValue + "T00:00:00") : new Date();
                    state.monthStart = startOfMonth(initialDate);
                }

                return loadEntryCalendarMonth("routeTarget", state.monthStart, preferredDateValue);
            }

            function populateRouteTimeOptions(selectedTimeValue) {
                var timeSelect = document.getElementById("routeTargetTime");
                if (!timeSelect) {
                    return Promise.resolve();
                }

                var selectedDateInput = document.getElementById("routeTargetDate");
                var selectedDateValue = selectedDateInput ? selectedDateInput.value : "";
                if (!selectedDateValue) {
                    setSelectValues(timeSelect, [], "Select time");
                    return Promise.resolve();
                }

                return populateEntryModalTimeOptions("routeTarget", activeRouteQueueDetails, selectedDateValue).then(function () {
                    if (selectedTimeValue) {
                        timeSelect.value = selectedTimeValue;
                    }
                    return null;
                });
            }

            function buildRouteTargetDateTime(dateValue, timeValue) {
                if (!dateValue) {
                    return "";
                }
                if (!timeValue) {
                    return dateValue;
                }
                return dateValue + " " + timeValue;
            }

            function toggleRouteDateRow() {
                var targetKind = document.getElementById("routeTargetKind");
                if (!targetKind) {
                    return;
                }
                var showAppointmentFields = targetKind.value === "A";
                document.querySelectorAll(".route-appointment-only").forEach(function (row) {
                    row.classList.toggle("is-hidden", !showAppointmentFields);
                });
