                addWalkinRefValue.addEventListener("change", function () {
                    var input = document.getElementById("addWalkinPermitNumber");
                    if (input) {
                        input.value = "";
                    }
                    ["addWalkinStreetNumber", "addWalkinStreetName", "addWalkinStreetType"].forEach(function (id) {
                        var field = document.getElementById(id);
                        if (field) {
                            field.value = "";
                        }
                    });
                    syncReferenceInputMeta("addWalkin");
                });
                syncReferenceInputMeta("addWalkin");
