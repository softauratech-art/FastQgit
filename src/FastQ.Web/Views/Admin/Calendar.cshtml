            var addWalkinEmail = document.getElementById("addWalkinEmail");
            if (addWalkinEmail) {
                addWalkinEmail.addEventListener("input", function () { queueCustomerLookupByEmail("addWalkin"); });
            }
            var addWalkinPermitNumber = document.getElementById("addWalkinPermitNumber");
            if (addWalkinPermitNumber) {
                addWalkinPermitNumber.addEventListener("input", function () { validatePermitNumber("addWalkin", false); });
                addWalkinPermitNumber.addEventListener("blur", function () { validatePermitNumber("addWalkin", true); });
            }
            ["addWalkinStreetNumber", "addWalkinStreetName", "addWalkinStreetType"].forEach(function (id) {
                var input = document.getElementById(id);
                if (!input) {
                    return;
                }
                input.addEventListener("input", function () { validatePermitNumber("addWalkin", false); });
                input.addEventListener("blur", function () { validatePermitNumber("addWalkin", true); });
            });

            var saveAddAppointment = document.getElementById("saveAddAppointment");
            if (saveAddAppointment) {
                saveAddAppointment.addEventListener("click", function () {
                    var payload = {
                        queueId: document.getElementById("addApptQueueId") ? document.getElementById("addApptQueueId").value : "",
                        serviceId: document.getElementById("addApptServiceId") ? document.getElementById("addApptServiceId").value : "",
                        contactType: document.getElementById("addApptContactType") ? document.getElementById("addApptContactType").value : "",
                        refValue: document.getElementById("addApptRefValue") ? document.getElementById("addApptRefValue").value : "",
                        permitNumber: document.getElementById("addApptPermitNumber") ? document.getElementById("addApptPermitNumber").value : "",
                        streetNumber: document.getElementById("addApptStreetNumber") ? document.getElementById("addApptStreetNumber").value : "",
                        streetName: document.getElementById("addApptStreetName") ? document.getElementById("addApptStreetName").value : "",
                        streetType: document.getElementById("addApptStreetType") ? document.getElementById("addApptStreetType").value : "",
                        email: document.getElementById("addApptEmail") ? document.getElementById("addApptEmail").value : "",
                        customerName: buildCustomerName(
                            document.getElementById("addApptFirstName") ? document.getElementById("addApptFirstName").value : "",
                            document.getElementById("addApptLastName") ? document.getElementById("addApptLastName").value : ""),
                        phone: document.getElementById("addApptPhone") ? document.getElementById("addApptPhone").value : "",
                        appointmentDate: document.getElementById("addApptDate") ? document.getElementById("addApptDate").value : "",
                        startTime: document.getElementById("addApptTime") ? document.getElementById("addApptTime").value : "",
                        meetingUrl: "",
                        notes: document.getElementById("addApptNotes") ? document.getElementById("addApptNotes").value : ""
                    };

                    var apptRefMeta = getReferenceFieldMeta(payload.refValue);
                    var apptHasReferenceValue = apptRefMeta.useAddressFields
                        ? !!(payload.streetNumber && payload.streetName)
                        : !!payload.permitNumber;
                    if (!payload.queueId || !payload.contactType || !payload.refValue || !apptHasReferenceValue || !payload.email || !payload.customerName || !payload.phone || !payload.appointmentDate || !payload.startTime) {
                        showModalFeedback("addAppointmentModal", "Queue, contact type, reference, reference value, email, first name, last name, phone, date, and time are required.", true);
                        return;
                    }

                    validatePermitNumber("addAppt", true).then(function (isValid) {
                        if (!isValid) {
                            showModalFeedback("addAppointmentModal", permitValidationState.addAppt.message || "Reference value is invalid.", true);
                            return;
                        }
                        if (timeSelectionState.addAppt && timeSelectionState.addAppt.pending) {
                            showModalFeedback("addAppointmentModal", "Customer availability validation is still in progress.", true);
                            return;
                        }
                        if (timeSelectionState.addAppt && !timeSelectionState.addAppt.valid) {
                            showModalFeedback("addAppointmentModal", timeSelectionState.addAppt.message || "Customer already has an appointment at this time.", true);
                            return;
                        }
                        postForm(addAppointmentUrl, payload).then(function (res) {
                            if (!res || !res.ok) {
                                showModalFeedback("addAppointmentModal", res && res.error ? res.error : "Could not add appointment.", true);
                                return;
                            }
                            closeModal("addAppointmentModal");
                            queueLiveSync();
                        });
                    });
                });
            }

            var saveAddWalkin = document.getElementById("saveAddWalkin");
            if (saveAddWalkin) {
                saveAddWalkin.addEventListener("click", function () {
                    var payload = {
                        queueId: document.getElementById("addWalkinQueueId") ? document.getElementById("addWalkinQueueId").value : "",
                        serviceId: document.getElementById("addWalkinServiceId") ? document.getElementById("addWalkinServiceId").value : "",
                        contactType: document.getElementById("addWalkinContactType") ? document.getElementById("addWalkinContactType").value : "",
                        refValue: document.getElementById("addWalkinRefValue") ? document.getElementById("addWalkinRefValue").value : "",
                        permitNumber: document.getElementById("addWalkinPermitNumber") ? document.getElementById("addWalkinPermitNumber").value : "",
                        streetNumber: document.getElementById("addWalkinStreetNumber") ? document.getElementById("addWalkinStreetNumber").value : "",
                        streetName: document.getElementById("addWalkinStreetName") ? document.getElementById("addWalkinStreetName").value : "",
                        streetType: document.getElementById("addWalkinStreetType") ? document.getElementById("addWalkinStreetType").value : "",
                        email: document.getElementById("addWalkinEmail") ? document.getElementById("addWalkinEmail").value : "",
                        customerName: buildCustomerName(
                            document.getElementById("addWalkinFirstName") ? document.getElementById("addWalkinFirstName").value : "",
                            document.getElementById("addWalkinLastName") ? document.getElementById("addWalkinLastName").value : ""),
                        phone: document.getElementById("addWalkinPhone") ? document.getElementById("addWalkinPhone").value : "",
                        meetingUrl: "",
                        notes: document.getElementById("addWalkinNotes") ? document.getElementById("addWalkinNotes").value : ""
                    };

                    var walkinRefMeta = getReferenceFieldMeta(payload.refValue);
                    var walkinHasReferenceValue = walkinRefMeta.useAddressFields
                        ? !!(payload.streetNumber && payload.streetName)
                        : !!payload.permitNumber;
                    if (!payload.queueId || !payload.contactType || !payload.refValue || !walkinHasReferenceValue || !payload.email || !payload.customerName || !payload.phone) {
                        showModalFeedback("addWalkinModal", "Queue, contact type, reference, reference value, email, first name, last name, and phone are required.", true);
                        return;
                    }

                    validatePermitNumber("addWalkin", true).then(function (isValid) {
                        if (!isValid) {
                            showModalFeedback("addWalkinModal", permitValidationState.addWalkin.message || "Reference value is invalid.", true);
                            return;
                        }
                        postForm(addWalkinUrl, payload).then(function (res) {
                            if (!res || !res.ok) {
                                showModalFeedback("addWalkinModal", res && res.error ? res.error : "Could not add walk-in.", true);
                                return;
                            }
                            closeModal("addWalkinModal");
                            queueLiveSync();
                        });
                    });
                });
            }

            document.querySelectorAll("[data-end-choice]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    var choice = btn.getAttribute("data-end-choice");
                    var srcIdInput = document.getElementById("endServiceSrcId");
                    var srcTypeInput = document.getElementById("endServiceSrcType");
                    var completionNotesInput = document.getElementById("endServiceCompletionNotes");
                    var appointmentId = srcIdInput ? srcIdInput.value : "";
                    var srcType = srcTypeInput ? srcTypeInput.value : "";
                    var completionNotes = completionNotesInput ? completionNotesInput.value : "";
                    if (!appointmentId || !srcType) {
                        closeModal("endServiceModal");
                        return;
                    }
                    if (!completionNotes || !completionNotes.trim()) {
                        showModalFeedback("endServiceModal", "Notes are required.", true);
                        return;
                    }

                    if (choice === "end-add") {
                        closeModal("endServiceModal");
                        openRouteModal("end-add", appointmentId, srcType, completionNotes);
                        return;
                    }

                    submitEndOnly(appointmentId, srcType, completionNotes)
                        .then(function (res) {
                            if (!res || !res.ok) {
                                showModalFeedback("endServiceModal", res && res.error ? res.error : "End service failed.", true);
                                return;
                            }
                            closeModal("endServiceModal");
                            queueLiveSync();
                        });
                });
            });

            var saveMeeting = document.getElementById("saveMeeting");
            if (saveMeeting) {
                saveMeeting.addEventListener("click", function () {
                    var mid = document.getElementById("mid");
                    var urlInput = document.getElementById("mURL");
                    var notesInput = document.getElementById("mNotes");
                    if (!mid) {
                        return;
                    }

                    var appointmentId = mid.getAttribute("data-appointment-id");
                    var srcType = mid.getAttribute("data-src-type") || "A";
                    var payload = {
                        appointmentId: appointmentId,
                        srcType: srcType,
                        webexUrl: urlInput ? urlInput.value : "",
                        notes: notesInput ? notesInput.value : ""
                    };

                    postForm(saveServiceInfoUrl, payload)
                        .then(function (res) {
                            if (!res || !res.ok) {
                                showModalFeedback("meetingModal", res && res.error ? res.error : "Save failed.", true);
                                return;
                            }
                            updateCalendarMeetingLinkUi(appointmentId, srcType, payload.webexUrl || "", payload.notes || "");
                            closeModal("meetingModal");
                        })
                        .catch(function () {
                            showModalFeedback("meetingModal", "Save failed.", true);
                        });
                });
            }

            var routeTargetKind = document.getElementById("routeTargetKind");
            if (routeTargetKind) {
                routeTargetKind.addEventListener("change", function () {
                    toggleRouteDateRow();
                    populateRouteDateOptions("");
                    populateRouteTimeOptions("");
                });
                toggleRouteDateRow();
            }

            var routeTargetDate = document.getElementById("routeTargetDate");
            if (routeTargetDate) {
                routeTargetDate.addEventListener("change", function () {
                    populateRouteTimeOptions("");
                });
            }

            var routeTargetQueueId = document.getElementById("routeTargetQueueId");
            if (routeTargetQueueId) {
                routeTargetQueueId.addEventListener("change", function () {
                    loadRouteServices(routeTargetQueueId.value || "", "");
                });
            }

            var saveRoute = document.getElementById("saveRoute");
            if (saveRoute) {
                saveRoute.addEventListener("click", function () {
                    var routeMode = document.getElementById("routeMode");
                    var routeSrcType = document.getElementById("routeSrcType");
                    var routeSrcId = document.getElementById("routeSrcId");
                    var routeCompletionNotes = document.getElementById("routeCompletionNotes");
                    var targetKindInput = document.getElementById("routeTargetKind");
                    var targetQueueIdInput = document.getElementById("routeTargetQueueId");
                    var targetServiceIdInput = document.getElementById("routeTargetServiceId");
                    var targetDateInput = document.getElementById("routeTargetDate");
                    var targetTimeInput = document.getElementById("routeTargetTime");
                    var refValueInput = document.getElementById("routeRefValue");
                    var notesInput = document.getElementById("routeNotes");

                    var mode = routeMode ? routeMode.value : "";
                    var srcType = routeSrcType ? routeSrcType.value : "";
                    var appointmentId = routeSrcId ? routeSrcId.value : "";
                    var completionNotes = routeCompletionNotes ? routeCompletionNotes.value : "";
                    var targetKind = targetKindInput ? targetKindInput.value : "";
                    var targetQueueId = targetQueueIdInput ? targetQueueIdInput.value : "";
                    var targetServiceId = targetServiceIdInput ? targetServiceIdInput.value : "";
                    var targetDate = targetDateInput ? targetDateInput.value : "";
                    var targetTime = targetTimeInput ? targetTimeInput.value : "";
                    var refValue = refValueInput ? refValueInput.value : "";
                    var notes = notesInput ? notesInput.value : "";
                    var targetDateTime = buildRouteTargetDateTime(targetDate, targetTime);

                    if (!appointmentId || !srcType || !targetQueueId) {
                        showModalFeedback("serviceRouteModal", "Source and target queue are required.", true);
                        return;
                    }
                    if (mode === "end-add" && (!completionNotes || !completionNotes.trim())) {
                        showModalFeedback("serviceRouteModal", "Notes are required.", true);
                        return;
                    }
                    if (targetKind === "A" && (!targetDate || !targetTime)) {
                        showModalFeedback("serviceRouteModal", "Target date and time are required for appointment target.", true);
                        return;
                    }

                    if (mode === "transfer") {
                        postForm(transferUrl, {
                            appointmentId: appointmentId,
                            srcType: srcType,
                            targetQueueId: targetQueueId,
                            targetKind: targetKind,
                            targetServiceId: targetServiceId || "",
                            targetDate: targetDateTime || "",
                            refValue: refValue || "",
                            notes: notes || ""
                            })
                            .then(function (res) {
                                if (!res || !res.ok) {
                                    showModalFeedback("serviceRouteModal", res && res.error ? res.error : "Transfer failed.", true);
                                    return;
                                }
                                closeModal("serviceRouteModal");
                                queueLiveSync();
                            });
                        return;
                    }

                    if (mode === "end-add") {
                        postForm(endServiceUrl, {
                            appointmentId: appointmentId,
                            srcType: srcType,
                            additionalService: "Y",
                            targetQueueId: targetQueueId,
                            targetServiceId: targetServiceId || "",
                            targetKind: targetKind,
                            targetDate: targetDateTime || "",
                            refValue: refValue || "",
                            notes: notes || "",
                            completionNotes: completionNotes || ""
                            })
                            .then(function (res) {
                                if (!res || !res.ok) {
                                    showModalFeedback("serviceRouteModal", res && res.error ? res.error : "End and add failed.", true);
                                    return;
                                }
                                closeModal("serviceRouteModal");
                                if (res.warning) {
                                    window.alert(res.warning);
                                }
                                queueLiveSync();
                            });
                    }
                });
            }

            bindProviderActionButtons();
            bindMeetingLinks();

            if (reopenOnError) {
                openModal("addAppointmentModal");
            }
        })();
