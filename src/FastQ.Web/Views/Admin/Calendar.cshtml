            function normalizeUsPhoneNumber(value) {
                var digits = (value || "").replace(/\D/g, "");
                if (digits.length === 11 && digits.charAt(0) === "1") {
                    digits = digits.substring(1);
                }
                if (digits.length !== 10) {
                    return "";
                }
                if (digits.charAt(0) === "0" || digits.charAt(0) === "1" || digits.charAt(3) === "0" || digits.charAt(3) === "1") {
                    return "";
                }
                return "(" + digits.substring(0, 3) + ") " + digits.substring(3, 6) + "-" + digits.substring(6);
            }

            function validateUsPhoneNumber(value) {
                var normalized = normalizeUsPhoneNumber(value);
                return {
                    ok: !!normalized,
                    value: normalized,
                    error: normalized ? "" : "Enter a valid US phone number."
                };
            }

            function attachPhoneFormatting(inputId, modalId) {
