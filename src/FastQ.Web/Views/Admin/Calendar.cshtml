            function setPermitValidationState(prefix, pending, valid, message) {
                permitValidationState[prefix] = permitValidationState[prefix] || { seq: 0, pending: false, valid: false, message: "" };
                permitValidationState[prefix].pending = !!pending;
                permitValidationState[prefix].valid = !!valid;
                permitValidationState[prefix].message = message || "";

                var ids = getPermitValidationIds(prefix);
                var status = document.getElementById(ids.statusId);
                var input = document.getElementById(ids.inputId);
                if (status) {
                    status.textContent = message || "";
                    status.style.color = pending ? "#6b7280" : (valid ? "#15803d" : "#b91c1c");
                }
                if (input) {
                    input.setAttribute("aria-invalid", pending || valid ? "false" : (message ? "true" : "false"));
                }
            }

            function resetPermitValidation(prefix) {
                permitValidationState[prefix] = permitValidationState[prefix] || { seq: 0, pending: false, valid: false, message: "" };
                permitValidationState[prefix].seq += 1;
                setPermitValidationState(prefix, false, false, "");
                if (permitValidationTimers[prefix]) {
                    clearTimeout(permitValidationTimers[prefix]);
                    permitValidationTimers[prefix] = 0;
                }
            }

            function validatePermitNumber(prefix, immediate) {
                var ids = getPermitValidationIds(prefix);
                var input = document.getElementById(ids.inputId);
                if (!input) {
                    return Promise.resolve(true);
                }

                var referenceValue = (input.value || "").trim();
                var addressIds = getAddressFieldIds(prefix);
                var streetNumberInput = document.getElementById(addressIds.streetNumberId);
                var streetNameInput = document.getElementById(addressIds.streetNameId);
                var streetTypeInput = document.getElementById(addressIds.streetTypeId);
                var streetNumber = streetNumberInput ? (streetNumberInput.value || "").trim() : "";
                var streetName = streetNameInput ? (streetNameInput.value || "").trim() : "";
                var streetType = streetTypeInput ? (streetTypeInput.value || "").trim() : "";
                var meta = getReferenceFieldMeta(getSelectedReferenceCode(prefix));
                if (meta.useAddressFields) {
                    if (!streetNumber) {
                        setPermitValidationState(prefix, false, false, "Street number is required.");
                        return Promise.resolve(false);
                    }
                    if (!streetName) {
                        setPermitValidationState(prefix, false, false, "Street name is required.");
                        return Promise.resolve(false);
                    }
                } else if (!referenceValue) {
                    setPermitValidationState(prefix, false, false, meta.label + " is required.");
                    return Promise.resolve(false);
                }
                if (!meta.validatePermit && !meta.useAddressFields) {
                    setPermitValidationState(prefix, false, true, "");
                    return Promise.resolve(true);
                }

                var state = permitValidationState[prefix] || { seq: 0, pending: false, valid: false, message: "" };
                state.seq += 1;
                permitValidationState[prefix] = state;
                var requestSeq = state.seq;
                var invalidLabel = meta.label || "Reference";
                setPermitValidationState(prefix, true, false, meta.useAddressFields ? "Validating address..." : ("Validating " + invalidLabel.toLowerCase() + "..."));

                var run = function () {
                    return getJson(validateReferenceUrl
                        + "?referenceType=" + encodeURIComponent(getSelectedReferenceCode(prefix))
                        + "&enterValue=" + encodeURIComponent(referenceValue)
                        + "&streetNumber=" + encodeURIComponent(streetNumber)
                        + "&streetName=" + encodeURIComponent(streetName)
                        + "&streetType=" + encodeURIComponent(streetType))
                        .then(function (res) {
                            if (!permitValidationState[prefix] || permitValidationState[prefix].seq !== requestSeq) {
                                return false;
                            }
                            if (res && (res.ok || res.success)) {
                                setPermitValidationState(prefix, false, true, meta.useAddressFields ? "Address validated." : (invalidLabel + " validated."));
                                return true;
                            }
                            setPermitValidationState(prefix, false, false, res && (res.error || res.message) ? (res.error || res.message) : (meta.useAddressFields ? "Address is invalid." : (invalidLabel + " is invalid.")));
                            return false;
                        })
                        .catch(function () {
                            if (!permitValidationState[prefix] || permitValidationState[prefix].seq !== requestSeq) {
                                return false;
                            }
                            setPermitValidationState(prefix, false, false, meta.useAddressFields ? "Could not validate address." : ("Could not validate " + invalidLabel.toLowerCase() + "."));
                            return false;
                        });
                };

                if (immediate) {
                    return run();
                }

                return new Promise(function (resolve) {
                    if (permitValidationTimers[prefix]) {
                        clearTimeout(permitValidationTimers[prefix]);
                    }
                    permitValidationTimers[prefix] = setTimeout(function () {
                        run().then(resolve);
                    }, 350);
                });
            }

            function canAction(status, actionName, queueId, rowDate) {
                var todayIso = getLocalTodayIsoDate();
                if ((rowDate || "") !== todayIso) {
                    return false;
                }
                if (!hasQueuePermission(actionName, queueId)) {
                    return false;
                }
                var finished = status === "completed" || status === "cancelled" || status === "closedbysystem" || status === "transferredout";
                if (finished) {
                    return false;
                }
                if (actionName === "arrive") {
                    return status === "scheduled";
                }
                if (actionName === "begin") {
                    return status === "arrived" || status === "scheduled";
                }
                if (actionName === "end") {
                    return status === "inservice";
                }
                if (actionName === "transfer") {
                    return status === "scheduled" || status === "arrived" || status === "inservice";
                }
                if (actionName === "remove") {
                    return !finished;
                }
                return true;
            }

            function bindProviderActionButtons() {
                document.querySelectorAll("[data-provider-action]").forEach(function (btn) {
                    var action = (btn.getAttribute("data-action") || "").toLowerCase();
                    var appointmentId = btn.getAttribute("data-appointment-id");
                    var queueId = btn.getAttribute("data-queue-id");
                    var rowDate = (btn.closest("[data-date]") && btn.closest("[data-date]").getAttribute("data-date")) || "";
                    var status = appointmentId ? getStatusForAppointment(appointmentId) : "";
                    btn.disabled = !canAction(status, action, queueId, rowDate);

                    if (btn.getAttribute("data-bound-provider-action") === "1") {
                        return;
                    }
                    btn.setAttribute("data-bound-provider-action", "1");
                    btn.addEventListener("click", function (event) {
                        event.preventDefault();
                        event.stopPropagation();

                        var appointmentId = btn.getAttribute("data-appointment-id");
                        var action = (btn.getAttribute("data-action") || "").toLowerCase();
                        var srcType = (btn.getAttribute("data-src-type") || "A").toUpperCase();
                        var queueId = btn.getAttribute("data-queue-id");
                        var rowDate = (btn.closest("[data-date]") && btn.closest("[data-date]").getAttribute("data-date")) || "";
                        if (!appointmentId || !action) {
                            return;
                        }

                        var status = getStatusForAppointment(appointmentId);
                        if (!canAction(status, action, queueId, rowDate)) {
                            window.alert("Action not allowed for the current status.");
                            return;
                        }

                        if (action === "transfer") {
                            openRouteModal("transfer", appointmentId, srcType);
                            return;
                        }

                        if (action === "end") {
                            openEndServiceModal(appointmentId, srcType);
                            return;
                        }

                        if (action === "remove") {
                            openCancelServiceModal(appointmentId, srcType);
                            return;
                        }

                        postForm(providerActionUrl, { action: action, appointmentId: appointmentId, srcType: srcType })
                            .then(function (res) {
                                if (!res || !res.ok) {
                                    window.alert(res && res.error ? res.error : "Action failed.");
                                    return;
                                }
                                queueLiveSync();
                            });
                    });
                });
            }

            function applyAgendaFilter(mode) {
                var normalized = (mode || "both").toUpperCase();
                var queueFilter = document.getElementById("agendaQueueFilter");
                var queueValue = (queueFilter && queueFilter.value ? queueFilter.value : "all").toLowerCase();
                var visibleCount = 0;
                document.querySelectorAll(".agenda-item").forEach(function (item) {
                    var srcType = (item.getAttribute("data-src-type") || "").toUpperCase();
                    var queueName = (item.getAttribute("data-queue") || "").toLowerCase();
                    var show = normalized === "BOTH" || normalized === srcType;
                    if (show && queueValue !== "all" && queueName !== queueValue) {
                        show = false;
                    }
                    item.classList.toggle("is-hidden", !show);
                    if (show) {
                        visibleCount += 1;
                    }
                });

                var emptyState = document.querySelector(".agenda-panel .empty-state");
                if (emptyState) {
                    emptyState.classList.toggle("is-hidden", visibleCount > 0);
                }

                document.querySelectorAll("[data-agenda-filter]").forEach(function (btn) {
                    btn.classList.toggle("is-active", (btn.getAttribute("data-agenda-filter") || "").toUpperCase() === normalized);
