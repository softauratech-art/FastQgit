@model string
@{ ViewBag.Title = "Queue email notifications"; }
<h2>Queue email notifications</h2>
<p>Recipients for queue @ViewBag.QueueId. Enter one address per line. Leave empty to disable notifications.</p>
@if (TempData["EmailSaved"] != null) { <p>@TempData["EmailSaved"]</p> }
@Html.ValidationSummary()
@using (Html.BeginForm("EmailNotifications", "Queue", new { id = ViewBag.QueueId }, FormMethod.Post)) {
 @Html.AntiForgeryToken()
 <label for="emails">Email recipients</label>
 <textarea id="emails" name="emails" rows="8" class="form-control">@Model</textarea>
 <button type="submit" class="btn primary">Save</button>
}
