@model IEnumerable<FastQ.Web.Models.Admin.QueueVM>
@using FastQ.Web.Helpers;
@{
    var authService = new FastQ.Web.Services.AuthService();
}

    @section Head{
        <link href="https://cdn.datatables.net/2.3.7/css/dataTables.dataTables.min.css" rel="stylesheet" />
        <link href="~/Content/datatablesFQ.css" rel="stylesheet" />
        <link href="~/Content/siteadmin.css" rel="stylesheet" />
    }
    @section PageHeader {
        <div>
            <div class="topbar-title">Manage Queues</div>
            <div class="topbar-sub">Add and manage Queues and Schedules</div>
        </div>
    }

    @{  //Handle messages from DELETE action
        if (TempData["ErrorMessage"] != null && !string.IsNullOrEmpty(TempData["ErrorMessage"].ToString()))
        {
            <div class="alert alert-danger">
                <strong>Error:</strong> @TempData["ErrorMessage"]
            </div>
        }

        if (TempData["SuccessMessage"] != null && !string.IsNullOrEmpty(TempData["SuccessMessage"].ToString()))
        {
            <div class="alert alert-success">
                <strong>Success:</strong> @TempData["SuccessMessage"]
            </div>
        }
    }

    <div class="card">
        <table id="Qdata" class="table table-striped">
            <thead>
                <tr>
                    <th style="text-align:center">@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    @*<th>In Spanish</th>
                        <th>In Creole</th>*@
                    <th>@Html.DisplayNameFor(model => model.ActiveFlag)</th>
                    <th>@Html.DisplayNameFor(model => model.EmpOnly)</th>
                    <th>@Html.DisplayNameFor(model => model.LeadTimeMin)</th>
                    <th>@Html.DisplayNameFor(model => model.LeadTimeMax)</th>
                    <th class="no-sort"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id)
                            @*@Html.ActionLink(item.Id.ToString(), "Details", new { id = item.Id }, new { @class = "pill" })*@
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td class="text-center">
                            <span class="@(item.ActiveFlag ? "status-dot" : "inactive-dot")"></span>
                            <span class="is-hidden"> @item.ActiveFlag</span>
                        </td>
                        <td class="text-center"><span class="@(item.EmpOnly ? "status-dot" : "inactive-dot")"></span><span class="is-hidden"> @item.EmpOnly</span></td>
                        <td>@Utilities.ParseTimeInterval(item.LeadTimeMin)</td>
                        <td>@Utilities.ParseTimeInterval(item.LeadTimeMax)</td>
                        <td class="table-actions">
                            @if (authService.IsAdminForQueue(item.Id) || authService.IsInRole(Utilities.FQRole.SuperAdmin))
                            {
                                <a href="@Url.Action("Edit", "Queue", new { id = item.Id })" class="btn small ghost btn-action-edit">
                                    <i class="bi bi-pencil "></i> Edit
                                </a> 
                                <a href="#" class="btn small ghost btn-action-delete"                                    
                                   onclick="return showConfirmModal('@item.Id', `@item.Name`);">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                            else
                            {
                                <div>No access</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <dialog id="deleteConfirmModal" class="modal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete?</h5>
                </div>
                <div class="modal-body" id="delete-modal-body">
                    Are you sure you want to delete this record?
                </div>
                <div class="modal-footer">
                    <button id="cancelDeleteBtn" class="btn ghost">Cancel</button>
                    <button id="confirmDeleteBtn" class="btn ghost btn-action-delete">Confirm</button>
                </div>
            </div>
        </div>
    </dialog>

    @section Scripts{
        <script src="https://cdn.datatables.net/2.3.7/js/dataTables.min.js"></script>
        <script>
            $(document).ready(function () {
                const deletemodal = document.getElementById('deleteConfirmModal');
                const confirmBtn = document.getElementById('confirmDeleteBtn');
                const cancelBtn = document.getElementById('cancelDeleteBtn');

                showConfirmModal = (qid, qname) => {
                    const msg = `<div>You are about to delete queue <strong>` + qid + ` -  ` + qname + `</strong> permanently.</div><div>Are you sure you want to delete this record ?</div>`;

                    document.getElementById('delete-modal-body').innerHTML = msg;
                    confirmBtn.setAttribute('data-qid', qid);                    
                    deletemodal.showModal();
                }

                confirmBtn.addEventListener('click', () => {
                    const qid = confirmBtn.getAttribute('data-qid');
                    confirmAndpostdelete(qid);
                    deletemodal.close();
                });

                cancelBtn.addEventListener('click', () => {
                    deletemodal.close();
                });

                confirmAndpostdelete = (qid) => {
                    {
                        var flag = (qid); //checks if qid hasvalue or empty
                        window.location.href = '@Url.Action("Delete", "Queue")' + '/' + qid;
                    }
                }

                $('#Qdata').DataTable({
                    order: [[1, 'asc']],
                    language: {
                        search: '',
                        searchPlaceholder: "Search by Name or Id"},
                    pageLength: 50, // Sets the default to 50 rows
                    columnDefs: [
                        { "targets": [6], "orderable": false },
                        { width: 80, targets: 0 },
                        { width: 110, targets: 2 },
                        { width: 110, targets: 3 }
                    ],
                    fixedColumns: true,
                    layout: {
                        topEnd: 'search',
                        topStart: {
                                div: {
                                    className: 'action-btn-div'
                                }
                        }
                    },
                    initComplete: function () {
                        // Use initComplete to insert the actual hyperlink after the table is initialized
                        $('.action-btn-div').wrapInner('@Html.ActionLink("Create New", "Edit", 0, (authService.IsInRole(Utilities.FQRole.SuperAdmin) ? (object) new { @class = "btn-add"} : new {@style="display:none"}))');
                    }
                });
            });

        </script>
    }
