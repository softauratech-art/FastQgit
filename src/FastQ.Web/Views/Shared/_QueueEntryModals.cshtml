<div id="addAppointmentModal" class="calendar-modal-backdrop modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="addAppointmentModalTitle">
    <div class="modal route-modal">
        <div class="modal-header">
            <h5 class="modal-title" id="addAppointmentModalTitle">Add New Appointment</h5>
            <button class="btn small ghost" type="button" data-modal-close="addAppointmentModal">Close</button>
        </div>
        <div class="modal-body">
            <div class="modal-feedback" data-modal-feedback="addAppointmentModal"></div>
            <div class="route-form-row">
                <label for="addApptQueueId">Queue</label>
                <select id="addApptQueueId" class="route-input">
                    <option value="">Select queue</option>
                </select>
            </div>
            <div class="route-form-row">
                <label for="addApptServiceId">Service</label>
                <select id="addApptServiceId" class="route-input">
                    <option value="">Select service</option>
                </select>
            </div>
            <div class="route-form-row">
                <label for="addApptDate">Date</label>
                <div class="entry-date-picker" id="addApptDatePicker">
                    <input id="addApptDate" type="hidden" />
                    <div class="entry-date-picker-trigger">
                        <input id="addApptDateDisplay" class="route-input" type="text" placeholder="dd/mm/yyyy" inputmode="numeric" aria-haspopup="dialog" aria-expanded="false" />
                        <button id="addApptDateToggle" class="entry-date-picker-toggle" type="button" aria-label="Choose appointment date">
                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div id="addApptDatePanel" class="entry-date-picker-panel" role="dialog" aria-modal="false" aria-labelledby="addApptDateMonthLabel">
                        <div class="entry-date-picker-header">
                            <button id="addApptDatePrev" class="btn small ghost" type="button" aria-label="Previous month">Prev</button>
                            <div id="addApptDateMonthLabel" class="entry-date-picker-month">Select a date</div>
                            <button id="addApptDateNext" class="btn small ghost" type="button" aria-label="Next month">Next</button>
                        </div>
                        <div class="entry-date-picker-weekdays" aria-hidden="true">
                            <span>Sun</span>
                            <span>Mon</span>
                            <span>Tue</span>
                            <span>Wed</span>
                            <span>Thu</span>
                            <span>Fri</span>
                            <span>Sat</span>
                        </div>
                        <div id="addApptDateCalendar" class="entry-date-picker-grid" role="grid" aria-labelledby="addApptDateMonthLabel"></div>
                    </div>
                    <div id="addApptDateStatus" class="helper-text">Only dates with open slots are selectable.</div>
                </div>
            </div>
            <div class="route-form-row">
                <label for="addApptTime">Start Time</label>
                <select id="addApptTime" class="route-input">
                    <option value="">Select time</option>
                </select>
            </div>
            <div class="route-form-row">
                <label for="addApptContactType">Appointment Type</label>
                <select id="addApptContactType" class="route-input" required>
                    <option value="">Select appointment type</option>
                </select>
            </div>
            <div class="route-form-row">
                <label for="addApptRefValue">Reference</label>
                <select id="addApptRefValue" class="route-input">
                    <option value="">Select reference</option>
                </select>
            </div>
            <div class="route-form-row">
                <label id="addApptPermitNumberLabel" for="addApptPermitNumber">Describe</label>
                <div id="addApptReferenceValueWrap">
                    <input id="addApptPermitNumber" class="route-input" type="text" placeholder="Enter description" />
                    <div id="addApptPermitStatus" class="helper-text"></div>
                </div>
            </div>
            <div class="route-form-row is-hidden" id="addApptAddressRow">
                <label>Describe</label>
                <div>
                    <div class="action-bar">
                        <input id="addApptStreetNumber" class="route-input" type="text" placeholder="Street number" />
                        <input id="addApptStreetName" class="route-input" type="text" placeholder="Street name" />
                        <input id="addApptStreetType" class="route-input" type="text" placeholder="Street type" />
                    </div>
                    <div id="addApptAddressStatus" class="helper-text"></div>
                </div>
            </div>
            <div class="route-form-row">
                <label for="addApptFirstName">First Name</label>
                <input id="addApptFirstName" class="route-input" type="text" />
            </div>
            <div class="route-form-row">
                <label for="addApptLastName">Last Name</label>
                <input id="addApptLastName" class="route-input" type="text" />
            </div>
            <div class="route-form-row">
                <label for="addApptPhone">Mobile Number</label>
                <input id="addApptPhone" class="route-input" type="tel" />
            </div>
            <div class="route-form-row">
                <label for="addApptEmail">Email Address</label>
                <div>
                    <div class="lookup-input-wrap" id="addApptEmailWrap">
                        <input id="addApptEmail" class="route-input" type="email" />
                        <span class="lookup-spinner" aria-hidden="true"></span>
                    </div>
                    <div id="addApptEmailStatus" class="helper-text"></div>
                </div>
            </div>
            <div class="route-form-row">
                <label for="addApptLanguagePreference">Language Preference</label>
                <select id="addApptLanguagePreference" class="route-input">
                    <option value="">Select language</option>
                    <option value="EN">English</option>
                    <option value="ES">Spanish</option>
                    <option value="CP">Creole</option>
                </select>
            </div>
            <div class="route-form-row">
                <label for="addApptNotes">Comments</label>
                <textarea id="addApptNotes" rows="3"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn ghost" type="button" data-modal-close="addAppointmentModal">Cancel</button>
            <button class="btn primary" type="button" id="saveAddAppointment">Save Appointment</button>
        </div>
    </div>
</div>

